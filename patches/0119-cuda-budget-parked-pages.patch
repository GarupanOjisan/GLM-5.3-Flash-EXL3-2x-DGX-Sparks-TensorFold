# The startup budget counts the pages parked on the kernel's per-CPU free lists. TensorFold sizes the KV pool (and the
# kept prompt states) from MemAvailable when the ranks start (capacity.available_bytes / page_room). On kernel 6.7+ (6.17
# on the GB10) a bulk free leaves GiBs of free pages on the per-CPU lists ("pcp", the ``count:`` lines under each zone's
# ``pagesets`` in /proc/zoneinfo) instead of the buddy lists: they are free, and the kernel drains them when an allocation
# needs them, but neither MemFree nor MemAvailable counts them, and they drain back at only ~0.04-0.1 GiB/s. Two sources
# measured on a Spark: an image copy (docker save | load) parks 5-9 GiB for 1-2 minutes, and the compile of the first
# start of a new image (tensorfold_roce_v1, built ~1 s before the budget is read) parks 2.4 GiB (MemAvailable -2.41 GiB
# at +1 s, still -0.53 GiB at +49 s). The first start of a new image then budgeted 2-9 GiB too little: 89.2 against 94.4
# GiB "within" on a restart of the same image, a smaller pool for as long as the server ran. start.sh can wait for the
# image copy's pages (PR #149) but cannot see the ones parked inside the rank container.
# capacity.parked_bytes() sums those counts (x the page size; every zone and CPU; 0 when /proc/zoneinfo is unreadable
# or has no page lists, never an error) and _meminfo() adds them to MemAvailable (capped at MemTotal), so available_bytes,
# page_room and the memory gate's live figure agree; the startup budget's 10 % reserve is unchanged. The start-up line
# "budget counts the N GiB free on the per-CPU page lists" says when it mattered. Same replies: sizing only.
# tools/parked_pages_check.py. By @wojo.

diff --git tensorfold/cuda/capacity.py tensorfold/cuda/capacity.py
--- tensorfold/cuda/capacity.py
+++ tensorfold/cuda/capacity.py
@@ -138,13 +138,39 @@ def estimate_weights(model_dir: str | Path, transform: Callable, *, rank: int |
     return Weights(resident, staging, mapped)
 
 
+MEMINFO, ZONEINFO = "/proc/meminfo", "/proc/zoneinfo"       # tools/parked_pages_check.py reads canned ones
+
+
+def parked_bytes() -> int:
+    """Bytes free on the kernel's per-CPU page lists: the ``count:`` lines under each zone's ``pagesets``. A bulk free (an
+    image copy, a compiler's exit) leaves GiBs there on kernel 6.7+; they are free, the kernel drains them when an
+    allocation needs them, but neither MemFree nor MemAvailable counts them and they drain back at ~0.05 GiB/s. 0 when
+    the file is unreadable or has no page lists."""
+
+    pages, listed = 0, False
+    try:
+        for row in Path(ZONEINFO).read_text().splitlines():
+            if row.strip() == "pagesets":
+                listed = True
+            elif listed and row[:4] != "    " and not row.startswith("  vm stats"):
+                listed = False                      # the next zone's or the next field of this one
+            elif listed and row.split()[:1] == ["count:"]:
+                pages += int(row.split()[1])
+        return pages * os.sysconf("SC_PAGE_SIZE")
+    except (OSError, ValueError, IndexError):
+        return 0
+
+
 def _meminfo() -> dict | None:
     try:
-        rows = Path("/proc/meminfo").read_text().splitlines()
+        rows = Path(MEMINFO).read_text().splitlines()
         memory = {key.rstrip(":"): int(value) * 1024 for key, value, *_ in (row.split() for row in rows)}
     except (OSError, ValueError):
         return None
-    return memory if {"MemTotal", "MemAvailable"} <= memory.keys() else None
+    if not {"MemTotal", "MemAvailable"} <= memory.keys():
+        return None
+    memory["MemAvailable"] = min(memory["MemTotal"], memory["MemAvailable"] + parked_bytes())
+    return memory
 
 
 def unified(torch) -> bool:
@@ -315,6 +341,10 @@ def admit(model_dir: str | Path, requested: int | None, explicit: bool | None, t
     print(f"[tensorfold] CUDA rank {rank} startup estimate {receipt['total_bytes_estimate'] / GIB:.2f} GiB "
           f"within {plan.budget / GIB:.2f} GiB; native {plan.native}, allocated prompt/reply window {window}, "
           f"cache slots {receipt['cache_slots']}", flush=True)
+    parked = parked_bytes()
+    if parked >= GIB // 4:
+        print(f"[tensorfold] CUDA rank {rank} budget counts the {parked / GIB:.2f} GiB free on the per-CPU page lists "
+              "(neither MemFree nor MemAvailable does)", flush=True)
     note = tables_note(plan)
     if note:
         print(f"[tensorfold] {note}", flush=True)
