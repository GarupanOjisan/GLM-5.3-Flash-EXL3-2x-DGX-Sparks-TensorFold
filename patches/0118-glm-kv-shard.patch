@@ -0,0 +1,457 @@
+"""TF_GLM_KV_SHARD=1 (two ranks or more, --parallel above 1): the latent cache stored once instead of on every rank.
+
+The pool's rows are split in parts, one a rank (two halves at two ranks): an extent lives in one part
+(``Pool(half=...)``, a part's rows, never places one across a boundary) and the rank that part belongs to, its owner,
+holds the extent's latent rows; the other ranks hold none of them. The latent planes are sized for one half plus ``TRASH`` rows (where a non-owner's writes of a decode
+window's rows land). The pooled keys (6% of a token's bytes) stay on both ranks over the whole pool, so the token
+selection runs on both as before. A token then takes about half its bytes: the same memory holds ~1.9x the tokens.
+
+Attention reads every key of a row's stream, so it runs where the keys are:
+- a decode window (``forward.dsa_segments``): the ranks' absorbed queries are gathered, each row's owner computes all
+  64 heads over it, and the other ranks' heads go back to them (``attention``; past two ranks one all-to-all);
+- a prompt chunk (``forward.dsa_rows``): the owner sends the history rows the chunk selects (their union, a fraction
+  of the history) and the other ranks attend over that compact copy for their own heads (``fetch``; past two ranks a
+  broadcast).
+Each head's attention is the same kernel over the same keys in the same order, so every output bit is the unsharded
+engine's (64 heads at once == 32 + 32; a compact copy, its token ids renumbered in order == the arena).
+
+A new prompt borrows rows when the other parts have them free: while it fills,
+every other rank writes its own copy of the prompt's latents into free rows of its part (twin extents, one a part,
+all or none, placed the same way on every rank when the stream is admitted), so both attend locally as unsharded and nothing is sent; the twin
+goes when the prompt is in (before the first decode round), when the stream ends, or as soon as rank 0 needs its rows
+for anything else (UNTWIN), unless the fill is part way through its layers (its remaining layers read the binding its
+first ones wrote): that twin is pinned, never moved (the prompt's state points at its rows) and never counted as room,
+and compaction goes around it. Only rows nobody holds are borrowed: a twin never evicts a kept prompt.
+
+The spill tier stores what each rank holds: an extent's owner its latent and pooled-key rows, the other rank its
+pooled keys (and each its own small state); a point records its half, and a restore goes back into it.
+
+With the display reservation (TF_GLM_DISPLAY_KV_MIB) the first latent planes, each a half and its trash rows long, are
+carved from its span as unsharded (the pool's rows count its bytes at a sharded token's cost). Not with
+TF_GLM_MULTI_LONE, TF_GLM_MULTI_VERIFY=serial, or one rank (all refused at start). Past two ranks (TP3, TP4) the decode all-to-all and the prompt broadcast are untested
+on hardware here (two Sparks): the CPU checks cover the pool's parts, placement and twins."""
+
+from __future__ import annotations
+
+import os
+from types import SimpleNamespace
+
+import torch
+import triton
+import triton.language as tl
+
+ON = os.environ.get("TF_GLM_KV_SHARD", "0") == "1"
+TRASH = 2048                      # latent rows past a half: a non-owner's writes of a decode window's rows
+SEND_MIB = 64                     # the owner's send buffer: fetched rows go in pieces of this many MiB
+
+RANK = 0
+WORLD = 2
+HALF = 0                          # pool rows a part, one a rank: a half at two ranks (latent rows a rank: HALF + TRASH)
+HEADS: list = []                  # every rank's attention heads (22/21/21 at three ranks)
+ROW = 0                           # bytes of a latent row (set with the caches)
+DTYPE = torch.uint8               # the latent planes' type (set with the caches): a fetched copy is viewed as it
+STATS = {"fetches": 0, "identity": 0, "rows": 0, "bytes": 0}     # this rank's prompt-chunk fetches (/health)
+_buf: dict = {}
+
+
+def setup(rank: int, world: int, pool_rows: int, heads=None) -> None:
+    """Every rank, once the pool is sized: ``pool_rows`` (every part) over ``world`` ranks; ``heads``: each rank's
+    attention heads (None: an even split)."""
+
+    global RANK, WORLD, HALF, HEADS
+    if world < 2:
+        raise ValueError(f"TF_GLM_KV_SHARD=1 shards the latent cache over two ranks or more, not {world}")
+    if pool_rows % (world * 2048):
+        raise ValueError(f"TF_GLM_KV_SHARD=1: a pool of {pool_rows} rows is not {world} parts of whole extents")
+    RANK, WORLD, HALF = int(rank), int(world), int(pool_rows) // int(world)
+    HEADS = [int(h) for h in heads] if heads is not None else []
+
+
+def owner(base: int) -> int:
+    """The rank holding the latent rows of the extent at pool row ``base``."""
+
+    return int(base) // HALF
+
+
+def owns(base: int) -> bool:
+    return owner(base) == RANK
+
+
+def local(base: int) -> int:
+    """Pool row ``base`` of an extent this rank owns, as a row of its latent planes."""
+
+    return int(base) - RANK * HALF
+
+
+def budget(pool_rows: int, dsa: int, kv: str, world: int = 2) -> int:
+    """The sharded pool's rows for the memory ``pool_rows`` unsharded rows of ``dsa`` latent planes and pooled-key
+    planes take: each token's latent once over the ``world`` ranks, its pooled keys on every one, ``TRASH`` latent
+    rows a rank (whole parts of extents; 0 when the memory does not hold the trash rows)."""
+
+    from . import kv8
+
+    align = world * 2048
+    lat, pk = kv8.row_bytes(512, kv), kv8.row_bytes(128, kv) / 4
+    mem = pool_rows * dsa * (lat + pk)
+    return max(0, int((mem - TRASH * dsa * lat) // (dsa * (lat / world + pk))) // align * align)
+
+
+def floor(capacity: int, world: int = 2) -> int:
+    """The fewest rows of a sharded pool whose parts each hold one stream's window (``capacity`` tokens)."""
+
+    align = world * 2048
+    return world * (-(-capacity // align) * align)
+
+
+def sizes(pool_rows: int, dsa: int, kv: str, capacity: int, world: int = 2) -> int:
+    """``budget``, at least ``floor`` (the rows past the memory then are the caller's to account for: ``plan`` is the
+    start-up's, which shrinks the window to a part instead)."""
+
+    return max(budget(pool_rows, dsa, kv, world), floor(capacity, world))
+
+
+MIN_PART = 131072                 # tokens: a part smaller than this (or than a quarter of the window) is refused
+
+
+def plan(pool_rows: int, dsa: int, kv: str, limit: int, world: int, max_rows: int) -> tuple[int, str]:
+    """The start-up's sharded pool: (rows, a note for the log or ""). The memory ``pool_rows`` unsharded rows take
+    holds ``budget`` sharded ones, never more. A stream lives in one part, so a part smaller than the requested window
+    (``limit`` tokens) shortens what a request may use to what a part holds (``part - max_rows``: the engine's limit,
+    which admit and ``generate`` already cite): the note says so, with the numbers. That happens by a few thousand
+    tokens when the memory read at start is a little low (a first start that compiles extensions just before). A part
+    below ``MIN_PART`` (131,072: the smallest window the recipe suggests) or a quarter of the window is refused, since
+    the server would then serve a fraction of what was asked."""
+
+    rows = budget(pool_rows, dsa, kv, world)
+    part = rows // world
+    effective = min(int(limit), part - int(max_rows))
+    if effective >= limit:
+        return rows, ""
+    if effective < 1 or part < max(MIN_PART, int(limit) // 4):
+        raise ValueError(f"TF_GLM_KV_SHARD=1: the memory of a {pool_rows}-token pool holds {rows} sharded tokens "
+                         f"({part} a part at {world} ranks), too little for the requested {limit}-token window "
+                         f"(a part must hold at least {max(MIN_PART, int(limit) // 4)}): lower --context, or free "
+                         f"memory")
+    return rows, (f"a part holds {part} tokens, less than the requested {limit}-token window: a request may use up to "
+                  f"{effective} tokens ({max_rows} rows of a part are a decode window's)")
+
+
+def unsupported(verify: str) -> str | None:
+    """Why the shard cannot run with TF_GLM_MULTI_VERIFY=``verify`` (None: it can)."""
+
+    if verify == "serial":
+        return ("TF_GLM_KV_SHARD=1 does not run with TF_GLM_MULTI_VERIFY=serial: the one-stream graphs it replays are "
+                "captured with the rank that does not own the rows attending nothing (the owner computes every head), "
+                "so their tokens would be wrong; use the batched verify")
+    return None
+
+
+def as_bytes(lc):
+    """A latent plane's rows as bytes [rows, row bytes] (None: this rank holds none): rows travel as bytes, whatever
+    the cache's type (a bf16 row is 1,024 of them, an FP8 row 528)."""
+
+    return lc if lc is None or lc.dtype == torch.uint8 else lc.view(torch.uint8)
+
+
+def as_cache(got):
+    """A fetched copy [rows, row bytes] as the latent planes' type, what the attention kernels read."""
+
+    return got if DTYPE == torch.uint8 else got.view(DTYPE)
+
+
+def agree(rows: list) -> tuple[int, int]:
+    """(pool rows, display rows) every rank uses, from what each computed (``rows``: one [pool, display] a rank).
+    Ranks' pools differ by a few extents (each rank's own KDA state size is in the plan), and a part's owner is
+    ``base // HALF``: the ranks must agree on HALF, so all take the smallest."""
+
+    return min(int(r[0]) for r in rows), min(int(r[1]) for r in rows)
+
+
+def _scratch(R: int, H: int, LW: int, device, nch: int):
+    """Decode windows' buffers for ``attention`` (allocated once, outside graph capture)."""
+
+    key = (R, H, LW, str(device))
+    b = _buf.get(key)
+    if b is None:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("TF_GLM_KV_SHARD: the decode window's buffers must be allocated before graph capture")
+        from . import latent
+
+        b = SimpleNamespace(
+            q2=torch.empty((2 * R * H * LW,), dtype=torch.bfloat16, device=device),
+            q64=torch.empty((R, 2 * H, LW), dtype=torch.bfloat16, device=device),
+            o64=torch.empty((R, 2 * H, LW), dtype=torch.bfloat16, device=device),
+            send=torch.empty((R, H, LW), dtype=torch.bfloat16, device=device),
+            recv=torch.empty((2 * R * H * LW,), dtype=torch.bfloat16, device=device),
+            counts=torch.zeros((R,), dtype=torch.int32, device=device),
+            zero=torch.zeros((R,), dtype=torch.int32, device=device),
+            notok=torch.full((R, 1), -1, dtype=torch.int32, device=device),
+            s64=latent.LatentScratch(R, 2 * H, nch, device, lw=LW))
+        _buf[key] = b
+    return b
+
+
+def attention(comm, qa, lc, rows, tokens, counts, s, *, scale: float, out, R: int):
+    """A decode window's latent attention, sharded: every rank's queries qa [R, H, 512] (its heads) gathered, each
+    row's owner computes all heads over its keys (``rows.lbase``: the row's stream in this rank's latent planes;
+    ``rows.own``: whether this rank owns it), and each rank keeps its own heads: its own rows' from its pass, the
+    other rows' from the owner's -> out [R, H, 512]."""
+
+    from . import latent
+
+    if WORLD > 2:
+        return _attention_n(comm, qa, lc, rows, tokens, counts, s, scale=scale, out=out, R=R)
+    H, LW = qa.shape[1], qa.shape[2]
+    b = _scratch(s.rows, H, LW, qa.device, s.nch)
+    q2 = b.q2[:2 * R * H * LW]
+    comm.all_gather(qa[:R].contiguous().view(-1), q2)
+    q64 = b.q64[:R]
+    q64.view(R, 2, H, LW).copy_(q2.view(2, R, H, LW).transpose(0, 1))
+    if tokens is None:
+        tokens, counts = b.notok[:R], b.zero[:R]
+    ce = b.counts[:R]
+    torch.mul(counts[:R], rows.own[:R], out=ce)
+    view = SimpleNamespace(pos=rows.pos, base=rows.lbase, sparse=rows.sparse_eff)
+    o64 = latent.seg_attention(q64, lc, view, tokens, ce, b.s64, scale=scale, out=b.o64[:R])
+    mine, theirs = slice(RANK * H, RANK * H + H), slice((1 - RANK) * H, (2 - RANK) * H)
+    send = b.send[:R]
+    send.copy_(o64[:, theirs])
+    recv = b.recv[:2 * R * H * LW]
+    comm.all_gather(send.reshape(-1), recv)
+    peer = recv.view(2, R, H, LW)[1 - RANK]
+    torch.where(rows.own[:R].bool()[:, None, None], o64[:, mine], peer, out=out)
+    return out
+
+
+def _scratch_n(R: int, H: int, LW: int, device, nch: int):
+    """``_scratch`` past two ranks: every rank's queries padded to the most heads a rank has, gathered; all heads'
+    outputs; one send and one receive a peer."""
+
+    key = ("n", R, H, LW, str(device))
+    b = _buf.get(key)
+    if b is None:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("TF_GLM_KV_SHARD: the decode window's buffers must be allocated before graph capture")
+        from . import latent
+
+        heads = HEADS or [H] * WORLD
+        hp = head_plan(heads, RANK)
+        Hm, T = hp.Hm, hp.T
+        send, recv = exchange_buffers(hp, R, LW, device)
+        b = SimpleNamespace(
+            heads=heads, Hm=Hm, T=T, offs=hp.offs, peers=hp.peers,
+            qp=torch.zeros((R, Hm, LW), dtype=torch.bfloat16, device=device),
+            qg=torch.empty((WORLD * R * Hm * LW,), dtype=torch.bfloat16, device=device),
+            qall=torch.empty((R, T, LW), dtype=torch.bfloat16, device=device),
+            oall=torch.empty((R, T, LW), dtype=torch.bfloat16, device=device),
+            send=send, recv=recv,
+            counts=torch.zeros((R,), dtype=torch.int32, device=device),
+            zero=torch.zeros((R,), dtype=torch.int32, device=device),
+            notok=torch.full((R, 1), -1, dtype=torch.int32, device=device),
+            s64=latent.LatentScratch(R, T, nch, device, lw=LW))
+        _buf[key] = b
+    return b
+
+
+def _attention_n(comm, qa, lc, rows, tokens, counts, s, *, scale: float, out, R: int):
+    """``attention`` past two ranks: each rank's queries (padded) gathered, each row's owner computes every head over
+    its keys, and every other rank gets its own heads of the rows it does not own in one all-to-all (``rows.orank``:
+    each row's owner); the same kernel over the same keys, so the same bits as each rank's own heads."""
+
+    from . import latent
+
+    H, LW = qa.shape[1], qa.shape[2]
+    b = _scratch_n(s.rows, H, LW, qa.device, s.nch)
+    qp = b.qp[:R]
+    qp[:, :H].copy_(qa[:R])
+    qg = b.qg[:WORLD * R * b.Hm * LW]
+    comm.all_gather(qp.reshape(-1), qg)
+    g = qg.view(WORLD, R, b.Hm, LW)
+    qall = b.qall[:R]
+    for r in range(WORLD):
+        qall[:, b.offs[r]:b.offs[r] + b.heads[r]].copy_(g[r, :, :b.heads[r]])
+    if tokens is None:
+        tokens, counts = b.notok[:R], b.zero[:R]
+    ce = b.counts[:R]
+    torch.mul(counts[:R], rows.own[:R], out=ce)
+    view = SimpleNamespace(pos=rows.pos, base=rows.lbase, sparse=rows.sparse_eff)
+    oall = latent.seg_attention(qall, lc, view, tokens, ce, b.s64, scale=scale, out=b.oall[:R])
+    sends, recvs = pack_heads(b, oall, R)
+    xa = getattr(comm, "exchange_all", None) or getattr(comm, "nccl", comm).exchange_all
+    xa(sends, recvs)
+    return unpack_heads(b, oall, rows.orank[:R], out, R)
+
+
+def head_plan(heads: list, rank: int) -> SimpleNamespace:
+    """Where each rank's heads sit among all of them (``offs``, ``T`` in all), the most any rank has (``Hm``: what a
+    queries' gather and a pair's exchange are padded to) and ``rank``'s peers."""
+
+    return SimpleNamespace(Hm=max(heads), T=sum(heads), offs=[sum(heads[:r]) for r in range(len(heads))],
+                           peers=[p for p in range(len(heads)) if p != rank])
+
+
+def exchange_buffers(hp, R: int, LW: int, device):
+    """A send and a receive a peer, [R, Hm, LW] each: every pair's alike, padded to the most heads a rank has (as the
+    gathered queries are), since ``exchange_all`` refuses unequal sizes and the ranks' heads differ at three."""
+
+    mk = lambda: {p: torch.empty((R, hp.Hm, LW), dtype=torch.bfloat16, device=device) for p in hp.peers}  # noqa: E731
+    return mk(), mk()
+
+
+def pack_heads(b, oall, R: int):
+    """The owner's output ``oall`` [R, all heads, LW] cut for each peer: its heads, padded to ``Hm`` -> the
+    all-to-all's {peer: [send]} and {peer: [receive]} (both [R, Hm, LW], the same size in every pair)."""
+
+    sends, recvs = {}, {}
+    for p in b.peers:
+        b.send[p][:R, :b.heads[p]].copy_(oall[:, b.offs[p]:b.offs[p] + b.heads[p]])
+        sends[p], recvs[p] = [b.send[p][:R]], [b.recv[p][:R]]
+    return sends, recvs
+
+
+def unpack_heads(b, oall, orank, out, R: int):
+    """This rank's heads of every row: its own pass's for the rows it owns, else the owner's (the receive from rank
+    ``orank[row]``, its first ``out``'s heads of the padding) -> ``out`` [R, heads, LW]."""
+
+    H = out.shape[1]
+    out.copy_(oall[:, b.offs[RANK]:b.offs[RANK] + H])
+    owner = orank[:, None, None]
+    for p in b.peers:
+        torch.where(owner == p, b.recv[p][:R, :H], out, out=out)
+    return out
+
+
+def _grown(name: str, rows: int, row_bytes: int, device) -> torch.Tensor:
+    """A staging buffer of at least ``rows`` rows, kept and grown (to the next power of two) rather than allocated a
+    layer at a time: the allocator would otherwise keep every size a long prompt's chunks asked for (~6 GiB at 1M)."""
+
+    b = _buf.get(name)
+    if b is None or b.shape[0] < rows or b.shape[1] != row_bytes:
+        _buf.pop(name, None)
+        size = 1 << max(12, (int(rows) - 1).bit_length())
+        b = torch.empty((size, row_bytes), dtype=torch.uint8, device=device)
+        _buf[name] = b
+    return b
+
+
+@triton.jit
+def _mark_kernel(tok_ptr, n, mark_ptr, limit, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    t = tl.load(tok_ptr + offs, mask=m, other=-1)
+    ok = m & (t >= 0) & (t < limit)
+    tl.store(mark_ptr + t, tl.full([BLOCK], 1, tl.int32), mask=ok)
+
+
+@triton.jit
+def _renumber_kernel(tok_ptr, out_ptr, n, cum_ptr, limit, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    t = tl.load(tok_ptr + offs, mask=m, other=-1)
+    hist = (t >= 0) & (t < limit)
+    c = tl.load(cum_ptr + t, mask=m & hist, other=0)            # marked positions up to t (inclusive)
+    fetched = tl.load(cum_ptr + limit - 1)                        # every marked position: the fetched rows
+    r = tl.where(t < 0, -1, tl.where(hist, c - 1, fetched + t - limit))
+    tl.store(out_ptr + offs, r, mask=m)
+
+
+def _ints(name: str, n: int, device) -> torch.Tensor:
+    """A kept int32 buffer of at least ``n`` (grown to the next power of two, as ``_grown``)."""
+
+    b = _buf.get(name)
+    if b is None or b.numel() < n:
+        b = _buf[name] = torch.empty((1 << max(12, (int(n) - 1).bit_length()),), dtype=torch.int32, device=device)
+    return b[:n]
+
+
+def history(tokens: torch.Tensor, host_pos: int, owner: bool):
+    """A prompt chunk's selected history: the positions below ``host_pos`` its rows' tokens [R, width] (int32, -1
+    none) name, deduplicated in order, in time linear in the tokens (a mark a position, then its prefix sums), where a
+    sort would take ~4x the chunk's own attention work. The owner gets the positions (int64, ascending: what it sends);
+    the other rank gets their count and the tokens renumbered to rows of the compact copy (a history position to its
+    place among the fetched rows, a chunk row's own after them, -1 kept), the same ids a sorted search would give."""
+
+    dev = tokens.device
+    t = tokens.contiguous().view(-1)
+    n_tok = t.numel()
+    mark = _ints("mark", max(host_pos, 1), dev)
+    mark.zero_()
+    BLOCK = 1024
+    grid = (triton.cdiv(n_tok, BLOCK),)
+    if n_tok:
+        _mark_kernel[grid](t, n_tok, mark, host_pos, BLOCK=BLOCK)
+    if owner:
+        return torch.nonzero(mark).view(-1), None
+    cum = _ints("cum", max(host_pos, 1), dev)
+    torch.cumsum(mark, 0, dtype=torch.int32, out=cum)
+    out = _ints("renum", n_tok, dev)
+    if n_tok:
+        _renumber_kernel[grid](t, out, n_tok, cum, host_pos, BLOCK=BLOCK)
+    return int(cum[host_pos - 1]) if host_pos else 0, out.view(tokens.shape)
+
+
+def fetch(comm, lc, hist: torch.Tensor, row_bytes: int, device, extra: int = 0, root: int | None = None):
+    """A prompt chunk's history rows ``hist`` (positions, ascending; on the other ranks, their count) from their
+    owner to the other ranks, one way (past two ranks a broadcast from the owner, ``root``).
+    ``lc``: this rank's view of the stream (None: it is not the owner). The owner sends and gets None; the other rank
+    gets a staging buffer [n + extra, row_bytes] whose first n rows are the fetched ones (``extra`` rows after them
+    for the chunk's own)."""
+
+    from tensorfold.cuda.comm import _DTYPES
+
+    n = hist if isinstance(hist, int) else int(hist.numel())
+    STATS["fetches"] += 1
+    STATS["rows"] += n
+    STATS["bytes"] += n * row_bytes
+    nc = getattr(comm, "nccl", comm)
+    peer = 1 - RANK
+    stream = torch.cuda.current_stream().cuda_stream
+    piece = max(1, (SEND_MIB << 20) // row_bytes)    # rows a send (both ranks cut alike: each send meets its receive)
+    if WORLD > 2:
+        return _broadcast(nc, lc, hist, n, row_bytes, device, extra, root, piece, stream)
+    if lc is not None:                               # gathered a piece at a time into one bounded buffer (stream order:
+        buf = _grown("send", min(n, piece), row_bytes, device)      # a piece's send ends before the next gather)
+        for i in range(0, n, piece):
+            k = min(piece, n - i)
+            torch.index_select(lc, 0, hist[i:i + k], out=buf[:k])
+            w = buf[:k].view(torch.int32)
+            nc._check(nc.lib.ncclSend(w.data_ptr(), w.numel(), _DTYPES[torch.int32], peer, nc.comm, stream))
+        return None
+    buf = _grown("comp", n + extra, row_bytes, device)[:n + extra]
+    for i in range(0, n, piece):
+        k = min(piece, n - i)
+        w = buf[i:i + k].view(torch.int32)
+        nc._check(nc.lib.ncclRecv(w.data_ptr(), w.numel(), _DTYPES[torch.int32], peer, nc.comm, stream))
+    return buf
+
+
+def _broadcast(nc, lc, hist, n: int, row_bytes: int, device, extra: int, root: int, piece: int, stream):
+    """``fetch`` past two ranks: the owner (``root``) gathers each piece and broadcasts it; every other rank receives
+    it into its compact copy."""
+
+    import ctypes
+
+    from tensorfold.cuda.comm import _DTYPES
+
+    if root is None or int(root) < 0:      # (a caller that names no owner, as the MTP layer's dsa_block, would
+        raise ValueError(                  # broadcast from rank -1)
+            f"TF_GLM_KV_SHARD: a fetch past two ranks needs the rank that owns the rows, not {root}")
+    f = nc.lib.ncclBroadcast
+    if f.argtypes is None:
+        f.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_void_p,
+                      ctypes.c_void_p]
+    i32 = _DTYPES[torch.int32]
+    if lc is not None:
+        buf = _grown("send", min(n, piece), row_bytes, device)
+        for i in range(0, n, piece):
+            k = min(piece, n - i)
+            torch.index_select(lc, 0, hist[i:i + k], out=buf[:k])
+            w = buf[:k].view(torch.int32)
+            nc._check(f(w.data_ptr(), w.data_ptr(), w.numel(), i32, int(root), nc.comm, stream))
+        return None
+    buf = _grown("comp", n + extra, row_bytes, device)[:n + extra]
+    for i in range(0, n, piece):
+        k = min(piece, n - i)
+        w = buf[i:i + k].view(torch.int32)
+        nc._check(f(w.data_ptr(), w.data_ptr(), w.numel(), i32, int(root), nc.comm, stream))
+    return buf
