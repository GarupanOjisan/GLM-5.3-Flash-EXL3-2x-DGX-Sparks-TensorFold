+        e.s = s;
+        e.d = d;
+        e.t = t;
+        e.t.fp8 = kv_fp8;
+        e.kv_fp8 = kv_fp8;
+        e.k = k;
+        e.comm = comm;
+        e.width = width;
+        e.np_max = np_max;
