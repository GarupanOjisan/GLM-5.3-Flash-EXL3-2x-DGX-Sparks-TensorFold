+    pub const max_rows = 16; // engine.MAX_ROWS: a pending token and up to 15 copied drafts
+    pub const mtp_rows = 8; // engine.MTP_ROWS: rows an MTP step takes at once (a kept backlog is absorbed in steps of this)
