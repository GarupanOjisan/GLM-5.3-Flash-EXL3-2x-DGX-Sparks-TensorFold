+/// exl3.experts.routed with wts None (GLM's call, exl3_generic.py:9): Y per slot into `sc.y`, act_mode 0.
+pub fn routed(k: *const Kernels, s: cuda.Stream, x: u64, x_stride: usize, pick: u64, ex: anytype, sc: Exl3Scratch, rows: usize, limit: f32) !void {
+    const slots = sc.slots;
+    const p = rows * slots;
+    const e_n = ex.count;
+    const d = ex.dims;
+    const i_w = ex.width;
+    const maxu = @min(p, e_n);
+    {
+        var a: cuda.Args = .{};
+        a.add(pick);
+        a.add(sc.ids);
+        a.add(sc.count);
+        a.add(sc.members);
+        a.add(int(rows));
+        a.add(int(slots));
+        a.add(int(e_n));
+        a.add(int(rows));
+        try go(k.group, s, .{ 1, 1, 1 }, 1024, p * 4, &a);
+    }
+    {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(int(x_stride));
+        a.add(pick);
+        a.add(ex.suh_g);
+        a.add(ex.suh_u);
+        a.add(sc.xg);
+        a.add(sc.xu);
+        a.add(int(d));
+        a.add(int(slots));
+        a.add(int(e_n));
+        try go(k.rot_in, s, .{ p, d / 128, 2 }, 32, 0, &a);
+    }
+    const mt = (rows + 15) / 16;
+    try grouped(k, s, sc.xg, sc.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, sc, 2, d, i_w, p, Exl3Scratch.gu_sk, rows, maxu, mt);
+    {
+        var a: cuda.Args = .{};
+        a.add(sc.z);
+        a.add(pick);
+        a.add(ex.svh_g);
+        a.add(ex.svh_u);
+        a.add(ex.suh_d);
+        a.add(sc.xd);
+        a.add(int(p));
+        a.add(int(i_w));
+        a.add(int(Exl3Scratch.gu_sk));
+        a.add(int(e_n));
+        a.add(limit);
+        a.add(@as(i32, 0));
+        try go(k.gateup_epilogue, s, .{ p, i_w / 128, 1 }, 32, 0, &a);
+    }
+    try grouped(k, s, sc.xd, sc.xd, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, sc, 1, i_w, d, p, Exl3Scratch.d_sk, rows, maxu, mt);
+    {
+        var a: cuda.Args = .{};
+        a.add(sc.z);
+        a.add(pick);
+        a.add(ex.svh_d);
+        a.add(sc.y);
+        a.add(int(p));
+        a.add(int(d));
+        a.add(int(Exl3Scratch.d_sk));
+        a.add(int(e_n));
+        try go(k.down_epilogue, s, .{ p, d / 128, 1 }, 32, 0, &a);
+    }
+}
+
+/// experts.Plan's scratch (experts.py:113): pairs grouped by expert into items of at most `tile` pairs.
+pub const Plan = struct {
+    members: u64, // [pairs] i32
+    items: u64, // [max_items(pairs, experts, 16), 3] i32: (expert, first member, count)
+    counts: u64, // [2] i32: items, distinct experts
+    rank: u64, // [pairs] i32 when the plan is wide (pairs > 1024), else one word
+    hist: u64, // [ceil(pairs / 1024), experts] i32 when wide
+    order: u64, // a prompt plan's launch order, [pairs / 16 + 1024] i32
+};
+
+/// experts.max_items: the items a plan of `pairs` can hold.
+pub fn maxItems(pairs: usize, experts: usize, tile: usize) usize {
+    return @min(pairs, experts) + pairs / tile;
+}
+
+/// experts.route (experts.cu:306): `picks` [pairs] expert ids -> the plan; `experts` counts the shared expert's id.
+pub fn route(k: *const Kernels, s: cuda.Stream, picks: u64, pairs: usize, experts: usize, tile: usize, p: Plan) !void {
+    var a: cuda.Args = .{};
+    if (pairs <= 1024) {
+        a.add(picks);
+        for ([_]usize{ pairs, experts, tile }) |v| a.add(int(v));
+        for ([_]u64{ p.members, p.items, p.counts }) |v| a.add(v);
+        return go(k.plan_small, s, .{ 1, 1, 1 }, 1024, 0, &a);
+    }
+    const nblk = (pairs + 1023) / 1024;
+    a.add(picks);
+    a.add(int(pairs));
+    a.add(int(experts));
+    a.add(p.rank);
+    a.add(p.hist);
+    try go(k.plan_rank, s, .{ nblk, 1, 1 }, 1024, 0, &a);
+    var b: cuda.Args = .{};
+    for ([_]usize{ nblk, experts, tile }) |v| b.add(int(v));
+    for ([_]u64{ p.hist, p.items, p.counts }) |v| b.add(v);
+    try go(k.plan_offsets, s, .{ 1, 1, 1 }, 1024, 0, &b);
+    var c: cuda.Args = .{};
+    c.add(picks);
+    c.add(int(pairs));
+    c.add(int(experts));
+    for ([_]u64{ p.rank, p.hist, p.members }) |v| c.add(v);
+    try go(k.plan_scatter, s, .{ (pairs + 255) / 256, 1, 1 }, 256, 0, &c);
+}
+
+/// exl3_mm.routed for GLM at two ranks (D 4096, an expert width of 1024) on `plan` (route): Y per routed slot into
+/// `sc.y`. A prompt chunk (`prompt`: plan items of 64 pairs) runs the Y^T kernels, a decode window (under 64 rows,
+/// items of 16) the `dec` kernels with TF_GLM_EXL3_FUSE 1 (the down epilogue fused) and the 16-byte loads
+/// (TF_GLM_EXL3_LOADS=nc). `ex.shared_suh` (0: none) is the one gate/up suh of a layer whose experts all share it.
+pub fn routed18(k: *const Kernels, s: cuda.Stream, x: u64, x_stride: usize, pick: u64, ex: anytype, sc: Exl3Scratch, rows: usize, limit: f32, prompt: bool) !void {
+    const slots = sc.slots;
+    const p = rows * slots;
+    const e_n = ex.count;
+    const d = ex.dims;
+    const i_w = ex.width;
+    const pl = sc.plan;
+    if (d != 4096 or i_w != 1024 or d % 256 != 0) return error.Exl3Shape;
+    if (!prompt and rows >= 64) return error.WindowTooWide; // PROMPT_ROWS: a window from 64 rows takes the prompt plan
+    const tile: usize = if (prompt) 64 else 16;
+    try route(k, s, pick, p, e_n + 1, tile, pl);
+    const rows_in = ex.shared_suh != 0;
+    if (rows_in) { // one rotated input a row, read by all its pairs' gate and up
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(int(x_stride));
+        a.add(@as(u64, 0));
+        a.add(ex.shared_suh);
+        a.add(ex.shared_suh);
+        a.add(sc.xg);
+        a.add(sc.xg);
+        a.add(int(d));
+        a.add(@as(i32, 1));
+        try go(k.rot_rows, s, .{ rows, d / 128, 1 }, 32, 0, &a);
+    } else {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(int(x_stride));
+        a.add(pick);
+        a.add(ex.suh_g);
+        a.add(ex.suh_u);
+        a.add(sc.xg);
+        a.add(sc.xu);
+        a.add(int(d));
+        a.add(int(slots));
+        try go(k.rot_pairs, s, .{ p, d / 128, 2 }, 32, 0, &a);
+    }
+    const xu = if (rows_in) sc.xg else sc.xu;
+    const items = maxItems(p, e_n + 1, tile);
+    if (prompt) {
+        var o: cuda.Args = .{};
+        for ([_]u64{ pl.items, pl.counts, pl.order }) |v| o.add(v);
+        o.add(int(items));
+        o.add(int(e_n));
+        try go(k.prompt_order, s, .{ 1, 1, 1 }, 1024, 0, &o);
+        var g: cuda.Args = .{};
+        for ([_]u64{ sc.xg, xu, ex.gate_base, ex.up_base, pl.items, pl.counts, pl.members, ex.svh_g, ex.svh_u, ex.suh_d, sc.xd }) |v| g.add(v);
+        for ([_]usize{ d, i_w, e_n }) |v| g.add(int(v));
+        g.add(limit);
+        g.add(int(slots));
+        g.add(pl.order);
+        try go(if (rows_in) k.prompt_gu_rows else k.prompt_gu, s, .{ i_w / 128, items, 1 }, 256, if (rows_in) prompt_smem_rows else prompt_smem, &g);
+        var dn: cuda.Args = .{};
+        for ([_]u64{ sc.xd, ex.down_base, pl.items, pl.counts, pl.members, ex.svh_d, sc.y }) |v| dn.add(v);
+        for ([_]usize{ i_w, d, e_n }) |v| dn.add(int(v));
+        dn.add(pl.order);
+        return go(k.prompt_down, s, .{ d / 256, items, 1 }, 256, prompt_smem, &dn);
+    }
+    const sk_gu = Exl3Scratch.gu_sk;
+    var g: cuda.Args = .{};
+    for ([_]u64{ sc.xg, xu, ex.gate_base, ex.up_base, pl.items, pl.counts, pl.members, sc.z }) |v| g.add(v);
+    for ([_]usize{ d, i_w, p, sk_gu, e_n, slots }) |v| g.add(int(v));
+    for ([_]u64{ ex.svh_g, ex.svh_u, ex.suh_d, sc.xd }) |v| g.add(v);
+    g.add(limit);
+    g.add(@as(u64, 0)); // done: only the gate/up epilogue fused into the kernel (TF_GLM_EXL3_FUSE 2) counts blocks
+    try go(if (rows_in) k.dec_gu_rows[dec_order] else k.dec_gu[dec_order], s, .{ items, i_w / 128, 2 * sk_gu }, 128, 0, &g);
+    var e: cuda.Args = .{};
+    for ([_]u64{ sc.z, pick, ex.svh_g, ex.svh_u, ex.suh_d, sc.xd }) |v| e.add(v);
+    for ([_]usize{ p, i_w, sk_gu, slots }) |v| e.add(int(v));
+    e.add(limit);
+    try go(k.gu_epilogue18, s, .{ p, i_w / 128, 1 }, 32, 0, &e);
+    var dn: cuda.Args = .{};
+    for ([_]u64{ sc.xd, sc.xd, ex.down_base, ex.down_base, pl.items, pl.counts, pl.members, sc.z }) |v| dn.add(v);
+    for ([_]usize{ i_w, d, p, 1, e_n, slots }) |v| dn.add(int(v));
+    for ([_]u64{ ex.svh_d, ex.svh_d, ex.svh_d, sc.y }) |v| dn.add(v);
+    dn.add(@as(f32, 0));
+    dn.add(@as(u64, 0));
+    try go(k.dec_down[dec_order], s, .{ items, d / 128, 1 }, 128, 0, &dn);
+}
+
+fn grouped(k: *const Kernels, s: cuda.Stream, x0: u64, x1: u64, tp0: u64, tp1: u64, k2_0: u64, k2_1: u64, sc: Exl3Scratch, mats: usize, kk: usize, n: usize, p: usize, sk: usize, maxm: usize, maxu: usize, mt: usize) !void {
+    if (kk % (16 * sk * 4) != 0 or n % (16 * 8) != 0) return error.Exl3Tiles;
+    var a: cuda.Args = .{};
+    a.add(x0);
+    a.add(x1);
+    a.add(tp0);
+    a.add(tp1);
+    a.add(k2_0);
+    a.add(k2_1);
+    a.add(sc.ids);
+    a.add(sc.count);
+    a.add(sc.members);
+    a.add(sc.z);
+    a.add(int(kk));
+    a.add(int(n));
+    a.add(int(p));
+    a.add(int(sk));
+    a.add(int(maxm));
+    a.add(int(sc.slots));
+    try go(k.grouped, s, .{ maxu, n / 128, mats * sk * mt }, 128, 0, &a);
+}
+
+test "routed-expert plan items and prompt kernels' shared memory" {
+    const t = std.testing;
+    try t.expectEqual(@as(usize, 9), maxItems(9, 289, 16)); // one row: nine pairs, each its own expert
+    try t.expectEqual(@as(usize, 289 + 18432 / 64), maxItems(18432, 289, 64)); // a 2,048-row chunk
+    // exl3.cu prompt_smem<64, XM>(): the larger of the stages (XM member-row copies and 2 x PWORDS halves, 3 deep) and the epilogue halves
+    const stages = struct {
+        fn bytes(xm: usize) usize {
+            return 3 * (xm * 64 * 40 + 2 * 1024) * 2;
+        }
+    };
+    try t.expectEqual(@as(usize, prompt_smem), stages.bytes(2));
+    try t.expectEqual(@as(usize, 2 * 32 * 132 * 4), prompt_smem_rows); // 33,792 B, above stages.bytes(1) = 27,648 B
+    try t.expect(stages.bytes(1) < prompt_smem_rows);
+}
diff --git a/zig/src/families/glm/cuda/glm_l2pf.zig b/zig/src/families/glm/cuda/glm_l2pf.zig
new file mode 100644
index 0000000..8d1fd31
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_l2pf.zig
@@ -0,0 +1,352 @@
+//! TF_GLM_L2PF (v1.8 glm5_next/cuda/l2pf.py): in decode windows a small kernel on a side stream asks the memory system to
+//! bring the weights the main stream reads next into L2 while it waits on an all-gather or runs latency-bound glue. It only
+//! loads or prefetches, so no result changes. Three sites a layer: `a` at the attention block's all-gather (the FFN's
+//! hyper-connection weights and norm, the router and shared expert, or a dense MLP), `f` at the FFN's all-gather (the next
+//! layer's hyper-connection weights, norm and input projections; after the last layer the final norm and the head), `o` after
+//! the attention block's input projections (its output projection). Each site takes up to TF_GLM_L2PF_MB (default 8) MiB:
+//! small tensors first, then a 4-bit matrix's chunk heads where its decode launch is one wave, else the leading bytes of
+//! the large tensors. The side stream forks from the main stream at a site (an event) and is joined before a window ends,
+//! so it also works inside a captured graph.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("glm_weights.zig");
+const kern = @import("glm_kernels.zig");
+const max_layers = @import("glm_config").max_layers;
+
+const align_b = 16; // cp.async.bulk wants 16-byte addresses and sizes
+const piece: usize = 32 << 10; // l2pf.PIECE
+const one_wave = 192; // l2pf.ONE_WAVE: qmm programs resident at once
+
+pub const Settings = struct {
+    mode: i32 = -1, // -1: off; 0 bulk, 1 lines, 2 touch
+    mb: f64 = 8.0,
+    sites: [3]bool = .{ true, true, true }, // a, f, o
+    rows: usize = 64,
+    threads: usize = 128,
+
+    pub fn fromEnv() !Settings {
+        var s: Settings = .{};
+        const v = std.c.getenv("TF_GLM_L2PF");
+        // v1.8's production setting turns it on; here it is on unless "0" / "off"
+        const mode = if (v) |x| std.mem.span(x) else "1";
+        if (std.mem.eql(u8, mode, "0") or std.mem.eql(u8, mode, "off")) return s;
+        s.mode = if (std.mem.eql(u8, mode, "1") or std.mem.eql(u8, mode, "bulk") or mode.len == 0) 0 else if (std.mem.eql(u8, mode, "lines")) 1 else if (std.mem.eql(u8, mode, "touch")) 2 else return error.BadL2pf;
+        if (std.c.getenv("TF_GLM_L2PF_MB")) |x| s.mb = try std.fmt.parseFloat(f64, std.mem.span(x));
+        if (!(s.mb > 0 and s.mb <= 64)) return error.BadL2pf;
+        if (std.c.getenv("TF_GLM_L2PF_SITES")) |x| {
+            s.sites = .{ false, false, false };
+            for (std.mem.span(x)) |ch| switch (ch) {
+                'a' => s.sites[0] = true,
+                'f' => s.sites[1] = true,
+                'o' => s.sites[2] = true,
+                else => return error.BadL2pf,
+            };
+        }
+        if (std.c.getenv("TF_GLM_L2PF_ROWS")) |x| s.rows = try std.fmt.parseInt(usize, std.mem.span(x), 10);
+        return s;
+    }
+
+    pub fn on(s: Settings) bool {
+        return s.mode >= 0;
+    }
+};
+
+const T = struct { ptr: u64, bytes: usize };
+const Q4Head = struct { n: usize, k: usize, weight: T };
+const Group = struct {
+    ts: [8]T = undefined,
+    n: usize = 0,
+    q4: ?Q4Head = null,
+
+    fn add(g: *Group, ptr: u64, bytes: usize) void {
+        if (ptr == 0 or bytes == 0) return;
+        for (g.ts[0..g.n]) |t| if (t.ptr == ptr) return; // each tensor once
+        g.ts[g.n] = .{ .ptr = ptr, .bytes = bytes };
+        g.n += 1;
+    }
+
+    fn mat(g: *Group, m: wt.Mat) void {
+        switch (m.kind) {
+            .b16 => g.add(m.ptr, m.n * m.k * 2),
+            .f8 => {
+                g.add(m.ptr, m.n * m.k);
+                g.add(m.s, m.n * (m.k / 128) * 4);
+            },
+            .q4 => {
+                const kg = m.k / 64;
+                g.add(m.ptr, m.npad * m.k / 2);
+                g.add(m.s, kg * m.npad * 2);
+                g.add(m.b, kg * m.npad * 2);
+                g.q4 = .{ .n = m.n, .k = m.k, .weight = .{ .ptr = m.ptr, .bytes = m.npad * m.k / 2 } };
+            },
+        }
+    }
+};
+
+/// l2pf._span: the tensor's leading bytes (at most `left`), the start rounded down and the end up to 16 bytes.
+fn span(t: T, left: usize) ?T {
+    const lo = t.ptr - t.ptr % align_b;
+    var hi = @min(t.ptr + t.bytes, lo + left);
+    hi += (align_b - hi % align_b) % align_b;
+    return if (hi > lo) .{ .ptr = lo, .bytes = hi - lo } else null;
+}
+
+/// l2pf.ranges: (address, bytes) ranges of `groups` up to `budget` bytes, appended to `out`.
+fn ranges(gpa: std.mem.Allocator, groups: []const Group, budget: usize, out: *std.ArrayList(T)) !void {
+    var left = budget;
+    for (groups) |g0| {
+        var g = g0;
+        // within a group the small tensors first (a stable sort by size)
+        std.mem.sort(T, g.ts[0..g.n], {}, struct {
+            fn lt(_: void, a: T, b: T) bool {
+                return a.bytes < b.bytes;
+            }
+        }.lt);
+        var heads: std.ArrayList(T) = .empty;
+        defer heads.deinit(gpa);
+        var skip: u64 = 0;
+        if (g.q4) |q| {
+            var small: usize = 0;
+            for (g.ts[0..g.n]) |t| if (t.ptr != q.weight.ptr) {
+                small += t.bytes;
+            };
+            if (left > small) try q4Heads(gpa, q, left - small, &heads);
+            if (heads.items.len > 0) skip = q.weight.ptr;
+        }
+        for (g.ts[0..g.n]) |t| {
+            if (skip != 0 and t.ptr == skip) continue;
+            if (left < align_b) return;
+            if (span(t, left)) |sp| {
+                try out.append(gpa, sp);
+                left -= sp.bytes;
+            }
+        }
+        if (heads.items.len > 0) {
+            var total: usize = 0;
+            for (heads.items) |h| total += h.bytes;
+            if (left >= total) {
+                try out.appendSlice(gpa, heads.items);
+                left -= total;
+            }
+        }
+    }
+}
+
+/// l2pf.q4_heads: the first `left / chunks` bytes of every (64-column tile, K slice) chunk of a 4-bit matrix whose decode launch is
+/// one wave, so each program starts on L2 hits.
+fn q4Heads(gpa: std.mem.Allocator, q: Q4Head, left: usize, out: *std.ArrayList(T)) !void {
+    const chunks = (q.n + 63) / 64 * kern.denseSplitK(q.n, q.k);
+    const total = q.weight.bytes;
+    if (chunks == 0 or chunks > one_wave or total % chunks != 0) return;
+    const size = total / chunks;
+    const per = @min(size, left / chunks) / align_b * align_b;
+    if (per < 512 or q.weight.ptr % align_b != 0 or size % align_b != 0) return;
+    for (0..chunks) |c| try out.append(gpa, .{ .ptr = q.weight.ptr + c * size, .bytes = per });
+}
+
+pub const Site = struct { first: u32, count: u32, grid: u32 };
+
+pub const Prefetch = struct {
+    s: Settings,
+    table: cuda.DeviceBuffer,
+    sink: cuda.DeviceBuffer,
+    sites: [max_layers][3]?Site = @splat(@splat(null)),
+    side: cuda.Stream,
+    fork: cuda.Event,
+    join_ev: cuda.Event,
+    forked: bool = false,
+    bytes: [3]usize = .{ 0, 0, 0 },
+    count: [3]usize = .{ 0, 0, 0 },
+
+    fn norm(w: *const wt.Weights) usize {
+        return @as(usize, w.cfg.hidden) * 2;
+    }
+
+    fn hc(g: *Group, w: *const wt.Weights, h: ?wt.Hc) void {
+        const x = h orelse return;
+        g.add(x.fn_, 24 * @as(usize, w.cfg.hc) * w.cfg.hidden * 2);
+        g.add(x.base, 24 * 4);
+        g.add(x.scale, 3 * 4);
+    }
+
+    /// Site `a`: the FFN's hyper-connection weights and norm, then the router and shared expert, or a dense MLP.
+    fn ffn(w: *const wt.Weights, l: wt.Layer, gs: *std.ArrayList(Group), gpa: std.mem.Allocator) !void {
+        var g: Group = .{};
+        hc(&g, w, l.ffn_hc);
+        try gs.append(gpa, g);
+        var n: Group = .{};
+        n.add(l.post_norm, norm(w));
+        try gs.append(gpa, n);
+        if (l.mlp) |m| {
+            var a: Group = .{};
+            a.mat(m.gu);
+            try gs.append(gpa, a);
+            var b: Group = .{};
+            b.mat(m.down);
+            try gs.append(gpa, b);
+        } else if (l.moe) |m| {
+            var r: Group = .{};
+            r.add(m.router, @as(usize, w.cfg.experts) * w.cfg.hidden * 2);
+            try gs.append(gpa, r);
+            var bias: Group = .{};
+            bias.add(m.bias, @as(usize, w.cfg.experts) * 4);
+            try gs.append(gpa, bias);
+            var a: Group = .{};
+            a.mat(m.shared.gu);
+            try gs.append(gpa, a);
+            var b: Group = .{};
+            b.mat(m.shared.down);
+            try gs.append(gpa, b);
+        }
+    }
+
+    /// Site `f`: the next layer's hyper-connection weights, norm and input projections; after the last layer the final norm and head.
+    fn next(w: *const wt.Weights, nxt: ?wt.Layer, gs: *std.ArrayList(Group), gpa: std.mem.Allocator) !void {
+        const n = nxt orelse {
+            var a: Group = .{};
+            a.add(w.norm, norm(w));
+            try gs.append(gpa, a);
+            var h: Group = .{};
+            h.mat(w.head);
+            try gs.append(gpa, h);
+            return;
+        };
+        const c = w.cfg;
+        var g: Group = .{};
+        hc(&g, w, n.attn_hc);
+        try gs.append(gpa, g);
+        var nm: Group = .{};
+        nm.add(n.in_norm, norm(w));
+        try gs.append(gpa, nm);
+        if (n.kda) |k| {
+            const ll: usize = c.kda_heads / wt.world;
+            inline for (.{ k.fb, k.gb }) |m| {
+                var a: Group = .{};
+                a.mat(m);
+                try gs.append(gpa, a);
+            }
+            var cv: Group = .{};
+            cv.add(k.conv, 3 * ll * 128 * 4 * 2);
+            try gs.append(gpa, cv);
+            var al: Group = .{};
+            al.add(k.a_log, ll * 4);
+            try gs.append(gpa, al);
+            var dt: Group = .{};
+            dt.add(k.dt_bias, ll * 128 * 4);
+            try gs.append(gpa, dt);
+            var pr: Group = .{};
+            pr.mat(k.proj);
+            try gs.append(gpa, pr);
+        } else if (n.dsa) |a| {
+            var qn: Group = .{};
+            qn.add(a.q_norm, @as(usize, c.q_lora) * 2);
+            try gs.append(gpa, qn);
+            var kn: Group = .{};
+            kn.add(a.kv_norm, @as(usize, c.kv_lora) * 2);
+            try gs.append(gpa, kn);
+            inline for (.{ a.proj, a.q_b, a.index.kw }) |m| {
+                var x: Group = .{};
+                x.mat(m);
+                try gs.append(gpa, x);
+            }
+            var gt: Group = .{};
+            gt.add(a.index.gate, @as(usize, c.i_dim) * c.hidden * 2);
+            try gs.append(gpa, gt);
+        }
+    }
+
+    /// Site `o`: KDA's output projection; DSA's (fired after absorb_q) kv_b's value half, then the output projection.
+    fn out(w: *const wt.Weights, l: wt.Layer, gs: *std.ArrayList(Group), gpa: std.mem.Allocator) !void {
+        const c = w.cfg;
+        if (l.kda) |k| {
+            var g: Group = .{};
+            g.mat(k.o);
+            try gs.append(gpa, g);
+        } else if (l.dsa) |a| {
+            var v: Group = .{};
+            v.add(a.wv, @as(usize, c.mla_heads / wt.world) * c.v_dim * c.kv_lora * 2);
+            try gs.append(gpa, v);
+            var o: Group = .{};
+            o.mat(a.o);
+            try gs.append(gpa, o);
+        }
+    }
+
+    pub fn build(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const wt.Weights, s: Settings) !Prefetch {
+        var p: Prefetch = .{ .s = s, .table = undefined, .sink = undefined, .side = undefined, .fork = undefined, .join_ev = undefined };
+        const budget: usize = @intFromFloat(s.mb * (1 << 20));
+        var rows: std.ArrayList(i64) = .empty;
+        defer rows.deinit(gpa);
+        for (w.layers, 0..) |l, i| {
+            const nxt: ?wt.Layer = if (i + 1 < w.layers.len) w.layers[i + 1] else null;
+            inline for (0..3) |si| {
+                if (s.sites[si]) {
+                    var gs: std.ArrayList(Group) = .empty;
+                    defer gs.deinit(gpa);
+                    switch (si) {
+                        0 => try ffn(w, l, &gs, gpa),
+                        1 => try next(w, nxt, &gs, gpa),
+                        else => try out(w, l, &gs, gpa),
+                    }
+                    var rs: std.ArrayList(T) = .empty;
+                    defer rs.deinit(gpa);
+                    try ranges(gpa, gs.items, budget, &rs);
+                    const first = rows.items.len / 2;
+                    var total: usize = 0;
+                    for (rs.items) |sp| {
+                        total += sp.bytes;
+                        var o: usize = 0;
+                        while (o < sp.bytes) : (o += piece) {
+                            try rows.append(gpa, @intCast(sp.ptr + o));
+                            try rows.append(gpa, @intCast(@min(piece, sp.bytes - o)));
+                        }
+                    }
+                    const count = rows.items.len / 2 - first;
+                    if (count > 0) {
+                        const per: usize = if (s.mode == 0) s.threads else s.threads / 32;
+                        p.sites[l.index][si] = .{ .first = @intCast(first), .count = @intCast(count), .grid = @intCast(@max(1, @min(48, (count + per - 1) / per))) };
+                        p.bytes[si] += total;
+                        p.count[si] += 1;
+                    }
+                }
+            }
+        }
+        if (rows.items.len == 0) try rows.appendSlice(gpa, &.{ 0, 0 });
+        p.table = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(rows.items));
+        errdefer p.table.free();
+        p.sink = try cuda.DeviceBuffer.alloc(d, 256);
+        errdefer p.sink.free();
+        try p.sink.fill8(0, null);
+        p.side = try cuda.Stream.init(d, true);
+        errdefer p.side.deinit();
+        p.fork = try cuda.Event.init(d, false);
+        errdefer p.fork.deinit();
+        p.join_ev = try cuda.Event.init(d, false);
+        return p;
+    }
+
+    pub fn deinit(p: *Prefetch) void {
+        p.join_ev.deinit();
+        p.fork.deinit();
+        p.side.deinit();
+        p.sink.free();
+        p.table.free();
+    }
+
+    /// l2pf.Prefetch.site: fork the side stream at this point of `main` and prefetch the site's ranges there.
+    pub fn site(p: *Prefetch, k: *const kern.Kernels, main: cuda.Stream, layer: u32, which: usize) !void {
+        const st = p.sites[layer][which] orelse return;
+        try p.fork.record(main);
+        try p.side.wait(p.fork);
+        try kern.l2Prefetch(k, p.side, p.table.ptr, st.first, st.count, p.s.mode, st.grid, p.s.threads, p.sink.ptr);
+        p.forked = true;
+    }
+
+    /// The main stream waits for the side stream (a captured graph's branches rejoin before its end).
+    pub fn join(p: *Prefetch, main: cuda.Stream) !void {
+        if (!p.forked) return;
+        try p.join_ev.record(p.side);
+        try main.wait(p.join_ev);
+        p.forked = false;
+    }
+};
diff --git a/zig/src/families/glm/cuda/glm_main.zig b/zig/src/families/glm/cuda/glm_main.zig
new file mode 100644
index 0000000..3f4c536
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_main.zig
@@ -0,0 +1,240 @@
+//! `tf-glm`: GLM-5.3-Flash on two CUDA ranks without Python, and its check against the Python engine's replies.
+//!   tf-glm check MODEL --rank R --master HOST [--port P] --prompts prompts.json --want tokens.json
+//!          [--max-tokens N] [--context N] [--depth D] [--copy 0|1] [--drafter DIR] [--only NAME,...] [--kernels DIR]
+//!   tf-glm qdump MODEL --rank R --out DIR [--only NAME,...]   (TF_GLM_DENSE=q4's quantization of a few tensors, as bytes)
+//! Run once on each Spark (rank 0 on HOST). Each prompt is prefilled and decoded serially, then with MTP drafts;
+//! rank 0 prints whether both equal the capture's serial reply. `--copy 1` drafts by v1.8's prompt lookup where the
+//! context repeats (glm_copy.zig; TF_GLM_COPY_MAX, _MATCH, _REPLY_MATCH and TF_GLM_WIDE_GRAPHS as in Python) and the MTP
+//! head elsewhere. `--drafter DIR` (a DFlash2 snapshot) drafts with it instead of the MTP head, as v1.8's DRAFTER=dflash2
+//! does (`TF_GLM_DFLASH_POLICY`, default fnc7:0.3).
+const std = @import("std");
+const cuda = @import("cuda");
+const glm_config = @import("glm_config");
+const wt = @import("glm_weights.zig");
+const tri = @import("glm_triton.zig");
+const kern = @import("glm_kernels.zig");
+const fwd = @import("glm_forward.zig");
+const dec = @import("glm_decode.zig");
+const node = @import("glm_node.zig");
+const copy = @import("glm_copy.zig");
+const dflash = @import("glm_dflash.zig");
+const roce_mod = @import("glm_roce.zig");
+
+const Opts = struct {
+    model: []const u8 = "",
+    rank: u32 = 0,
+    master: []const u8 = "",
+    port: u16 = 29660,
+    prompts: []const u8 = "",
+    want: []const u8 = "",
+    max_tokens: usize = 128,
+    context: usize = 1048576,
+    depth: usize = 3,
+    copy: bool = false,
+    drafter: ?[]const u8 = null,
+    only: []const u8 = "",
+    kernels: ?[]const u8 = null,
+    out: []const u8 = "",
+};
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len < 3 or !(std.mem.eql(u8, args[1], "check") or std.mem.eql(u8, args[1], "follow") or std.mem.eql(u8, args[1], "qdump"))) {
+        std.debug.print("usage: tf-glm check MODEL --rank R --master HOST --prompts P --want W [options]\n" ++
+            "       tf-glm follow MODEL --master HOST [--port P] [--context N] [--kernels DIR]   (rank 1 of a server)\n" ++
+            "       tf-glm qdump MODEL --rank R --out DIR [--only NAME,...]\n", .{});
+        return 2;
+    }
+    var o: Opts = .{ .model = args[2] };
+    var i: usize = 3;
+    while (i + 1 < args.len) : (i += 2) {
+        const a = args[i];
+        const v = args[i + 1];
+        if (std.mem.eql(u8, a, "--rank")) o.rank = try std.fmt.parseInt(u32, v, 10)
+        else if (std.mem.eql(u8, a, "--master")) o.master = v
+        else if (std.mem.eql(u8, a, "--port")) o.port = try std.fmt.parseInt(u16, v, 10)
+        else if (std.mem.eql(u8, a, "--prompts")) o.prompts = v
+        else if (std.mem.eql(u8, a, "--want")) o.want = v
+        else if (std.mem.eql(u8, a, "--max-tokens")) o.max_tokens = try std.fmt.parseInt(usize, v, 10)
+        else if (std.mem.eql(u8, a, "--context")) o.context = try std.fmt.parseInt(usize, v, 10)
+        else if (std.mem.eql(u8, a, "--depth")) o.depth = try std.fmt.parseInt(usize, v, 10)
+        else if (std.mem.eql(u8, a, "--copy")) o.copy = !std.mem.eql(u8, v, "0")
+        else if (std.mem.eql(u8, a, "--drafter")) o.drafter = v
+        else if (std.mem.eql(u8, a, "--only")) o.only = v
+        else if (std.mem.eql(u8, a, "--kernels")) o.kernels = v
+        else if (std.mem.eql(u8, a, "--out")) o.out = v
+        else {
+            std.debug.print("unknown option {s}\n", .{a});
+            return 2;
+        }
+    }
+    if (std.mem.eql(u8, args[1], "qdump")) return qdump(init, o);
+    const kernels_dir = o.kernels orelse init.environ_map.get("TENSORFOLD_CUDA_KERNELS") orelse return error.NoKernelDir;
+    if (std.mem.eql(u8, args[1], "follow")) return follow(init, o, kernels_dir);
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+
+    // the two ranks: NCCL's id over TCP, then the communicator
+    var lib = try cuda.nccl.Library.open();
+    defer lib.close();
+    var pair = if (o.rank == 0) try cuda.Pair.listen(o.port) else try cuda.Pair.connect(o.master, o.port, 600);
+    defer pair.close();
+    // both ranks must run the same TF_GLM_DENSE: their all-gathered partials would mix 4-bit and BF16 projections
+    const dense_mine: u32 = @intFromEnum(try wt.denseKind());
+    var dense_theirs: u32 = undefined;
+    if (o.rank == 0) {
+        try pair.send(std.mem.asBytes(&dense_mine));
+        try pair.recv(std.mem.asBytes(&dense_theirs));
+    } else {
+        try pair.recv(std.mem.asBytes(&dense_theirs));
+        try pair.send(std.mem.asBytes(&dense_mine));
+    }
+    if (dense_mine != dense_theirs) {
+        std.log.err("the two ranks run different TF_GLM_DENSE (kind {d} here, {d} on the other rank)", .{ dense_mine, dense_theirs });
+        return error.RankSettingsDiffer;
+    }
+    var id: cuda.nccl.UniqueId = undefined;
+    if (o.rank == 0) {
+        try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId");
+        try pair.send(&id.internal);
+    } else try pair.recv(&id.internal);
+    var comm: cuda.nccl.Comm = null;
+    try lib.check(lib.api.ncclCommInitRank(&comm, wt.world, id, @intCast(o.rank)), "ncclCommInitRank");
+    defer _ = lib.api.ncclCommDestroy(comm);
+
+    const cfg_path = try std.fs.path.join(arena, &.{ o.model, "config.json" });
+    const cfg_text = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, arena, .limited(1 << 22));
+    const cfg = try glm_config.parse(gpa, cfg_text);
+
+    var k = try kern.Kernels.load(&driver);
+    defer k.deinit();
+    var t0 = now(io);
+    const comm_mode = try roce_mod.mode(.nccl); // the check runs on NCCL unless TF_GLM_COMM asks for RoCE
+    const roce: ?*roce_mod.Roce = if (comm_mode == .nccl) null else roce_mod.Roce.init(gpa, &driver, &k, pair, o.rank, roce_mod.maxBytes()) catch |err| if (comm_mode == .roce) return err else null;
+    defer if (roce) |r| r.deinit();
+    var w = try wt.load(gpa, io, &driver, .{ .d = &driver, .s = stream }, &k, o.model, cfg, o.rank, o.drafter == null);
+    defer w.deinit(gpa);
+    if (o.drafter) |dd| try wt.loadDraft(gpa, io, &driver, .{ .d = &driver, .s = stream }, &k, &w, dd, o.rank, true);
+    std.debug.print("[tf-glm] rank {d}: weights {d:.1} GiB in {d:.1} s\n", .{ o.rank, @as(f64, @floatFromInt(w.bytes)) / (1 << 30), secs(io, t0) });
+
+    var set = try cuda.aot.Set.load(gpa, io, &driver, ctx.device, kernels_dir);
+    defer set.deinit();
+    const long_context = o.context > fwd.denseLimit(&w);
+    var e = try fwd.Engine.init(&w, &driver, stream, .{ .set = &set, .s = stream }, &k, .{ .lib = &lib, .comm = comm, .roce = roce }, o.context + fwd.Engine.max_rows, long_context, if (w.draft) |dr| dr.taps else null);
+    defer e.deinit();
+    var drafter: ?dflash.Drafter = if (w.draft != null) try dflash.Drafter.init(gpa, &driver, &w, o.context + fwd.Engine.max_rows) else null;
+    defer if (drafter) |*dr| dr.deinit();
+    const policy = try dflash.Policy.fromEnv();
+
+    const prompts_text = try std.Io.Dir.cwd().readFileAlloc(io, o.prompts, arena, .limited(1 << 26));
+    const prompts = try std.json.parseFromSliceLeaky(std.json.Value, arena, prompts_text, .{});
+    const want_text = try std.Io.Dir.cwd().readFileAlloc(io, o.want, arena, .limited(1 << 26));
+    const want = try std.json.parseFromSliceLeaky(std.json.Value, arena, want_text, .{});
+
+    var failed: usize = 0;
+    var it = prompts.object.iterator();
+    while (it.next()) |entry| {
+        const name = entry.key_ptr.*;
+        if (o.only.len > 0 and !listed(o.only, name)) continue;
+        const ids = try arena.alloc(u32, entry.value_ptr.array.items.len);
+        for (entry.value_ptr.array.items, ids) |v, *x| x.* = @intCast(v.integer);
+        const ref = want.object.get(name).?.object.get("serial").?.array.items;
+        const count = @min(o.max_tokens, ref.len);
+        for ([_]bool{ false, true }) |drafted| {
+            var out: std.ArrayList(u32) = .empty;
+            defer out.deinit(gpa);
+            t0 = now(io);
+            const first = try dec.prefill(&e, ids, drafted, if (drafted) (if (drafter) |*dr| dr else null) else null);
+            const pre_s = secs(io, t0);
+            t0 = now(io);
+            var rounds: usize = 0;
+            var detail: []const u8 = "";
+            if (drafted and std.c.getenv("TF_GLM_DF_PROF") != null) if (drafter) |*dr| try dr.profile(&e, io);
+            if (drafted) {
+                const settings: ?copy.Settings = if (o.copy) try copy.Settings.fromEnv(e.wide_graph) else null;
+                const r = if (drafter) |*dr| try dec.dflashDecode(&e, dr, first, count, true, &out, gpa, settings, ids, policy) else try dec.mtpDecode(&e, first, count, o.depth, true, &out, gpa, settings, ids);
+                rounds = r.rounds;
+                if (settings != null or drafter != null) {
+                    var hist: std.ArrayList(u8) = .empty;
+                    for (r.windows, 0..) |n, rows| if (n > 0) try hist.print(arena, " {d}x{d}", .{ n, rows });
+                    detail = try std.fmt.allocPrint(arena, ", copies {d} rounds {d} drafts {d} kept, windows (n x rows){s}", .{ r.copy_rounds, r.copy_drafted, r.copy_accepted, hist.items });
+                }
+            } else try dec.serial(&e, first, count, true, &out, gpa);
+            const dec_s = secs(io, t0);
+            var same = out.items.len == count;
+            var at: usize = 0;
+            for (out.items, 0..) |tok, j| {
+                if (j >= ref.len or tok != @as(u32, @intCast(ref[j].integer))) {
+                    same = false;
+                    at = j;
+                    break;
+                }
+            }
+            if (!same) failed += 1;
+            if (o.rank == 0) std.debug.print("{s} {s}: {d} prompt tokens in {d:.2} s, {d} tokens in {d:.2} s ({d:.1} tok/s{s}), {s}{s}\n", .{
+                if (same) "PASS" else "FAIL", name, ids.len, pre_s, out.items.len, dec_s,
+                @as(f64, @floatFromInt(out.items.len)) / @max(dec_s, 1e-9), if (drafted) try std.fmt.allocPrint(arena, ", {d} rounds{s}, {s}", .{ rounds, detail, if (drafter != null) "DFlash2" else "MTP" }) else "",
+                if (same) "equal to Python" else try std.fmt.allocPrint(arena, "first difference at {d}", .{at}),
+                if (same) "" else try std.fmt.allocPrint(arena, " (got {any})", .{out.items[0..@min(out.items.len, at + 4)]}),
+            });
+        }
+    }
+    return if (failed == 0) 0 else 1;
+}
+
+/// The quantization of a few tensors of one rank, on one GPU without NCCL (compared with v1.8's by qdump.py).
+fn qdump(init: std.process.Init, o: Opts) !u8 {
+    const gpa = init.gpa;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var k = try kern.Kernels.load(&driver);
+    defer k.deinit();
+    const cfg_path = try std.fs.path.join(gpa, &.{ o.model, "config.json" });
+    defer gpa.free(cfg_path);
+    const cfg_text = try std.Io.Dir.cwd().readFileAlloc(init.io, cfg_path, gpa, .limited(1 << 22));
+    defer gpa.free(cfg_text);
+    const cfg = try glm_config.parse(gpa, cfg_text);
+    try wt.dumpQuant(gpa, init.io, &driver, .{ .d = &driver, .s = stream }, &k, o.model, cfg, o.rank, o.out, o.only);
+    return 0;
+}
+
+/// Rank 1 of a served GLM: load this rank, then run rank 0's commands until it stops.
+fn follow(init: std.process.Init, o: Opts, kernels_dir: []const u8) !u8 {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    const n = try node.Node.init(init.gpa, init.io, &ctx, o.model, kernels_dir, o.context, 1, o.master, o.port);
+    defer n.deinit();
+    std.debug.print("[tf-glm] rank 1 ready: following rank 0 at {s}:{d}\n", .{ o.master, o.port });
+    try n.follow();
+    std.debug.print("[tf-glm] rank 0 stopped\n", .{});
+    return 0;
+}
+
+/// `name` is one of the comma-separated names in `list`.
+fn listed(list: []const u8, name: []const u8) bool {
+    var it = std.mem.splitScalar(u8, list, ',');
+    while (it.next()) |n| if (std.mem.eql(u8, n, name)) return true;
+    return false;
+}
+
+fn now(io: std.Io) i96 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+fn secs(io: std.Io, t0: i96) f64 {
+    return @as(f64, @floatFromInt(now(io) - t0)) / 1e9;
+}
diff --git a/zig/src/families/glm/cuda/glm_native.zig b/zig/src/families/glm/cuda/glm_native.zig
new file mode 100644
index 0000000..a3337b2
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_native.zig
@@ -0,0 +1,1134 @@
+//! GLM-5.3-Flash on two CUDA ranks behind the native family interface (native/cuda.zig): this process is rank 0
+//! and serves; rank 1 runs `tf-glm follow` on the other Spark. A stream a lane (each lane one sequence's caches and
+//! DFlash2 context), the lanes' rounds taking turns; an idle lane keeps its caches' rows, so a later turn of its
+//! conversation resumes there. Windows of up to 16 rows, MTP drafts or DFlash2's (TF_GLM_DRAFTER_DIR; glm_dflash.zig)
+//! and v1.8's prompt-lookup (copy) drafts (glm_copy.zig). TF_GLM_PORT (default 29660) is the port rank 0 listens on for rank 1.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const node = @import("glm_node.zig");
+const fwd = @import("glm_forward.zig");
+const copy = @import("glm_copy.zig");
+const dflash = @import("glm_dflash.zig");
+
+const be = lanes.backend;
+const Node = node.Node;
+const max_rows = fwd.Engine.max_rows;
+/// Drafts the MTP head chains at most: the 8-row window of earlier builds (the rows past it serve copies).
+const head_drafts = 7;
+const dflash_max = 15;
+/// sampling.WIDER: the candidates a rank sends when a row's nucleus runs past the first (union rule); then the whole shards.
+const nucleus_wider = fwd.Engine.max_nucleus;
+
+const NucEnt = struct {
+    v: f64,
+    id: i64,
+    m: i64,
+
+    fn before(_: void, a: NucEnt, b: NucEnt) bool {
+        return a.v > b.v or (a.v == b.v and a.id < b.id);
+    }
+};
+
+pub const model_type = "glm5_next";
+pub const formats: []const []const u8 = &.{"exl3-mcg-4bit"};
+pub const default_context: i64 = 1048576;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = fwd.Engine.prefill_rows;
+pub const promptGrid = fwd.promptGrid;
+/// Sequences' caches allocated at load (`grow`), a stream each.
+pub const max_lanes: u32 = fwd.Engine.max_lanes;
+pub const default_port: u16 = 29660;
+
+pub const Options = struct { context: usize, drafts: bool, segments: usize = 1 };
+
+pub const LoneRun = *const fn (ctx: *anyopaque, s: *lanes.Stream, hooks: *anyopaque, committed: *const fn (*anyopaque) void, yield: *const fn (*anyopaque) bool) anyerror!bool;
+
+pub const Loaded = struct {
+    backend: be.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    lone: ?LoneRun = null,
+};
+
+/// This rank's share of the checkpoint (the routed experts and most projections halve, the embedding and the
+/// replicated layers do not): what the memory admission compares with the budget before loading.
+pub fn weightBytes(total: u64) u64 {
+    return total / 2 + (4 << 30) + if (node.drafterDir() != null) @as(u64, 2 << 30) else 0; // DFlash2's 4-bit layers: 1.8 GiB a rank
+}
+
+const ring = 64;
+
+/// glm_copy.zig as the lane core's proposer (lanes/proposer.zig): one a lane, reset by each prompt pass there. The core asks twice a round with the same context (the head's depth rule, then the next plan): the second
+/// answer is the first.
+const CopyRule = struct {
+    cfg: copy.Settings,
+    prompt: usize = 0,
+    buf: [copy.max_drafts]u32 = undefined,
+    memo_len: usize = std.math.maxInt(usize),
+    memo_room: i64 = 0,
+    memo_n: usize = 0,
+
+    const vtable: lanes.proposer.Proposer.VTable = .{ .propose = proposeFn, .last_match = lastMatchFn };
+
+    fn reset(r: *CopyRule, prompt: usize) void {
+        r.prompt = prompt;
+        r.memo_len = std.math.maxInt(usize);
+    }
+
+    fn proposer(r: *CopyRule) lanes.proposer.Proposer {
+        return .{ .ptr = r, .vtable = &vtable };
+    }
+
+    fn proposeFn(ptr: *anyopaque, context: []const u32, max_draft: i64) anyerror![]const u32 {
+        const r: *CopyRule = @ptrCast(@alignCast(ptr));
+        if (max_draft <= 0) return &.{};
+        if (r.memo_len != context.len or r.memo_room != max_draft) {
+            r.memo_n = r.cfg.propose(context, r.prompt, @intCast(max_draft), &r.buf).len;
+            r.memo_len = context.len;
+            r.memo_room = max_draft;
+        }
+        return r.buf[0..r.memo_n];
+    }
+
+    /// Any copy matched the settings' `match` tokens, which the core's enter_match (8) must not second-guess.
+    fn lastMatchFn(ptr: *anyopaque) i64 {
+        const r: *CopyRule = @ptrCast(@alignCast(ptr));
+        return if (r.memo_n > 0) 64 else 0;
+    }
+};
+
+/// One sequence's caches (the engine's lane of the same index) and the stream using them, if any.
+const Lane = struct {
+    stream: ?*lanes.Stream = null,
+    copy: CopyRule,
+    dtoks: [dflash_max]u32 = undefined, // the chain DFlash2 picked for the stream's next window
+    dn: usize = 0,
+    held: [max_rows]u32 = undefined,
+    held_n: usize = 0,
+    pending_rows: usize = 0, // the last verify's rows, until a keep or a draft commits them
+    window: [max_rows]u32 = undefined, // the last verify's rows, the tokens a commit makes live
+    /// The tokens whose attention-cache rows are committed, from position 0: a kept state resumes only while the
+    /// rows below its position still hold its tokens (the caches are positional; only KDA's state is copied).
+    live: std.ArrayList(u32) = .empty,
+    first: u64 = 0, // the handle of the stream's first token
+    used: u64 = 0, // when a stream last took the lane (least recently used goes first)
+};
+
+const Glm = struct {
+    gpa: std.mem.Allocator,
+    n: *Node,
+    drafts: bool,
+    dflash: bool = false, // DFlash2 drafts (the MTP head is not loaded)
+    policy: dflash.Policy = .{},
+    nucleus_first: usize = 1024, // TF_GLM_NUCLEUS: the candidates a rank sends first for a top_k-off draw (sampling.NUCLEUS)
+    nucleus_union: bool = true, // TENSORFOLD_NUCLEUS_UNION
+    copy_cfg: copy.Settings,
+    lanes: [max_lanes]Lane = undefined,
+    n_lanes: usize = 1,
+    clock: u64 = 0,
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+    costs: [max_rows]lanes.config.Cost = undefined,
+    /// Shared windows' ms by total rows: the lone windows' until `grow` times them over two lanes (the facts point here,
+    /// and the lane core reads them after `grow`).
+    shared: [fwd.Engine.shared_rows]lanes.config.Cost = undefined,
+    io: std.Io = undefined,
+    mtp_ms: f64 = 1.0,
+    vtable: be.Backend.VTable = undefined,
+    pass: []const u32 = &.{}, // the prompt a prompt pass is running, and where it stands between chunks
+    pass_at: ?u32 = null,
+    next_snap: u32 = 0,
+
+    fn of(p: *anyopaque) *Glm {
+        return @ptrCast(@alignCast(p));
+    }
+
+    fn take(g: *Glm, t: u32) u64 {
+        g.drawn[g.next % ring] = t;
+        g.next += 1;
+        return g.next - 1;
+    }
+
+    fn value(g: *Glm, f: be.Feed) !u32 {
+        return switch (f) {
+            .value => |v| v,
+            .handle => |h| try readFn(g, h),
+        };
+    }
+
+    /// The lane stream `s` uses, bound on both ranks.
+    fn enter(g: *Glm, s: *const lanes.Stream) !*Lane {
+        for (g.lanes[0..g.n_lanes], 0..) |*ln, i| if (ln.stream == s) {
+            try g.n.bind(i);
+            return ln;
+        };
+        return error.NoLane;
+    }
+
+    fn laneOf(g: *Glm, s: *const lanes.Stream) ?*Lane {
+        for (g.lanes[0..g.n_lanes]) |*ln| if (ln.stream == s) return ln;
+        return null;
+    }
+
+    /// Commit the bound lane's last verify's first `keep` rows once (keep and the next draft both name them).
+    fn commit(g: *Glm, ln: *Lane, keep: usize) !void {
+        if (ln.pending_rows == 0) return;
+        try g.n.keep(ln.pending_rows, keep);
+        try ln.live.appendSlice(g.gpa, ln.window[0..keep]);
+        ln.pending_rows = 0;
+    }
+
+    /// Each row's draw over the vocabulary (Node.whole_vocabulary): top_k off: sampling.nucleus_rows, its candidates a rank first
+    /// (`nucleus_first`, then `nucleus_wider`: TENSORFOLD_NUCLEUS_UNION, v1.10 patch 0034's rule), whole shards when a row's nucleus
+    /// runs past them; else choose_rows over every token (a top_k past the candidates a rank gives). Row r keyed at position0 + r.
+    fn chooseWhole(g: *Glm, sm: lanes.sampling.Sampling, which: Node.Rows, rows: usize, position0: u64, out: []u32) !void {
+        if (sm.top_k == 0) {
+            const stages = [_]usize{ g.nucleus_first, nucleus_wider };
+            // without the union rule (stock v1.8) a row whose nucleus is not inside one rank's candidates goes straight to the shards
+            for (stages[0 .. if (g.nucleus_union) 2 else 1]) |count| {
+                const words = try g.n.nucleus(which, rows, sm.temperature, count);
+                if (try g.drawNucleus(sm, rows, position0, words, count, out)) return;
+            }
+        }
+        _ = try g.n.nucleus(which, rows, sm.temperature, 0);
+        const host = g.n.e.full_host;
+        const n = g.n.e.w.head.n;
+        const row = try g.gpa.alloc(u16, 2 * n);
+        defer g.gpa.free(row);
+        for (0..rows) |r| {
+            for (0..2) |rank| @memcpy(row[rank * n ..][0..n], host[(rank * rows + r) * n ..][0..n]);
+            if (sm.top_k == 0) {
+                out[r] = try nucleus(g.gpa, row, position0 + r, sm);
+                continue;
+            }
+            const values = try g.gpa.alloc(f64, 2 * n);
+            defer g.gpa.free(values);
+            const ids = try g.gpa.alloc(u64, 2 * n);
+            defer g.gpa.free(ids);
+            for (row, values, ids, 0..) |b, *v, *id, i| {
+                v.* = bf16Value(b);
+                id.* = i;
+            }
+            out[r] = @intCast(try lanes.sampling.choose(g.gpa, values, ids, position0 + r, sm));
+        }
+    }
+
+    /// sampling._draw over the ranks' `count` best candidates (`words`, Engine.nucleusGather's layout): false when some row's nucleus
+    /// is not inside them (a wider gather or the whole shards decide it). With the union rule (TENSORFOLD_NUCLEUS_UNION, default
+    /// on) a row is covered when the merged walk to the cumulative mass ceil(top_p total) stops above every rank's last candidate:
+    /// no token left out can be in the nucleus, so the draw is the whole vocabulary's.
+    fn drawNucleus(g: *Glm, sm: lanes.sampling.Sampling, rows: usize, position0: u64, words: []const u64, count: usize, out: []u32) !bool {
+        const per_row = 3 * count + 2;
+        const cut = sm.top_p > 0.0 and sm.top_p < 1.0;
+        const union_rule = cut and g.nucleus_union;
+        const min_log = sm.minLog();
+        const ents = try g.gpa.alloc(NucEnt, 2 * count);
+        defer g.gpa.free(ents);
+        for (0..rows) |r| {
+            var total: u64 = 0;
+            var top = -std.math.inf(f64);
+            var lows: [2]f64 = undefined;
+            for (0..2) |k| {
+                const at = (k * rows + r) * per_row;
+                const vals = words[at..][0..count];
+                const ids = words[at + count ..][0..count];
+                const mass = words[at + 2 * count ..][0..count];
+                total += words[at + 3 * count];
+                lows[k] = std.math.inf(f64);
+                for (0..count) |j| {
+                    const v: f64 = @bitCast(vals[j]);
+                    ents[k * count + j] = .{ .v = v, .id = @bitCast(ids[j]), .m = @bitCast(mass[j]) };
+                    top = @max(top, v);
+                    lows[k] = @min(lows[k], v);
+                }
+            }
+            const need: i64 = if (cut) @intCast(ceilShare(sm.top_p, total)) else 0;
+            const floor = top + min_log;
+            std.mem.sort(NucEnt, ents, {}, NucEnt.before);
+            if (cut and union_rule) {
+                var cum: i64 = 0;
+                var stop: ?usize = null;
+                for (ents, 0..) |en, i| {
+                    cum += en.m;
+                    if (cum >= need) {
+                        stop = i;
+                        break;
+                    }
+                }
+                const at = stop orelse return false;
+                for (lows) |low| if (!(ents[at].v > low)) return false;
+            } else for (0..2) |k| {
+                // a rank's own share must end inside its candidates (min_p alone: a candidate below its cut)
+                var cum: i64 = 0;
+                var covered = false;
+                if (cut) {
+                    for (ents) |en| {
+                        if (en.id < @as(i64, 0) or @as(usize, @intCast(en.id)) / g.n.e.w.head.n != k) continue;
+                        cum += en.m;
+                        if (cum >= need) {
+                            covered = en.v > lows[k];
+                            break;
+                        }
+                    }
+                } else covered = sm.min_p > 0.0 and lows[k] < floor;
+                if (!covered) return false;
+            }
+            var keep: usize = ents.len;
+            if (cut) {
+                var cum: i64 = 0;
+                var below: usize = 0;
+                for (ents) |en| {
+                    cum += en.m;
+                    if (cum < need) below += 1 else break;
+                }
+                keep = below + 1;
+            }
+            if (sm.min_p > 0.0) {
+                var n: usize = 0;
+                for (ents) |en| {
+                    if (en.v >= floor) n += 1 else break;
+                }
+                keep = @min(keep, n);
+            }
+            var best: usize = 0;
+            var best_score = -std.math.inf(f64);
+            for (ents[0..keep], 0..) |en, j| {
+                const score = en.v - libm_log(-libm_log(lanes.sampling.uniform(sm.seed, position0 + r, @intCast(en.id))));
+                if (j == 0 or score > best_score) {
+                    best = j;
+                    best_score = score;
+                }
+            }
+            out[r] = @intCast(ents[best].id);
+        }
+        return true;
+    }
+
+    /// Each row's draw among the gathered candidates (exact_sampling.choose_rows), row r keyed at position0 + r.
+    fn choose(g: *Glm, s: *lanes.Stream, which: Node.Rows, k: usize, rows: usize, position0: u64, out: []u32) !void {
+        const sm = s.sampling.?;
+        if (k == Node.whole_vocabulary) return g.chooseWhole(sm, which, rows, position0, out);
+        const host = &g.n.e.cand_host;
+        var values: [2 * fwd.Engine.max_k]f64 = undefined;
+        var ids: [2 * fwd.Engine.max_k]u64 = undefined;
+        for (0..rows) |r| {
+            var m: usize = 0;
+            for (0..2) |rank| {
+                const base = (rank * rows + r) * 2 * k;
+                for (0..k) |j| {
+                    values[m] = @as(f32, @bitCast(host[base + 2 * j]));
+                    ids[m] = host[base + 2 * j + 1];
+                    m += 1;
+                }
+            }
+            out[r] = @intCast(try lanes.sampling.choose(g.gpa, values[0..m], ids[0..m], position0 + r, sm));
+        }
+    }
+
+    fn prefillFn(p: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const g = of(p);
+        const ids = s.prompt();
+        var at = try g.admitPrompt(s);
+        const ln = g.laneOf(s).?;
+        errdefer ln.stream = null;
+        g.pass = ids;
+        defer {
+            g.pass = &.{};
+            g.pass_at = null;
+        }
+        var next: usize = 0; // the planned chunk starts: a resumed pass cuts where a fresh one does
+        while (at < ids.len) {
+            if (s.isCancelled()) return error.Cancelled;
+            const rows = nextCut(s, at, &next);
+            try g.n.chunk(at, rows);
+            try ln.live.appendSlice(g.gpa, ids[at..][0..rows]);
+            at += rows;
+            g.pass_at = @intCast(at);
+            if (std.mem.indexOfScalar(u32, s.reuse.marks, @intCast(at)) != null) if (s.reuse.hook) |hk| hk.at(hk.ptr, s, @intCast(at));
+        }
+        try g.firstOf(s, ln);
+    }
+
+    /// The rows of the prompt chunk from `at`: to its next planned start (`next` walks s.chunks) or its end, at most a chunk.
+    fn nextCut(s: *const lanes.Stream, at: usize, next: *usize) usize {
+        while (next.* < s.chunks.len and s.chunks[next.*] <= at) next.* += 1;
+        const end: usize = if (next.* < s.chunks.len) s.chunks[next.*] else s.prompt().len;
+        return @min(end - at, fwd.Engine.prefill_rows);
+    }
+
+    /// The first token after the bound lane's prompt.
+    fn firstOf(g: *Glm, s: *lanes.Stream, ln: *Lane) !void {
+        const k = try candidateCount(s);
+        const first = try g.n.first(k);
+        var one: [1]u32 = .{first};
+        if (k > 0) try g.choose(s, .last, k, 1, s.prompt().len, &one);
+        ln.first = g.take(one[0]);
+    }
+
+    /// A prompt's lane (bound) and its begun state: a kept state of its prefix resumed, else empty; where its pass starts.
+    fn admitPrompt(g: *Glm, s: *lanes.Stream) !usize {
+        const e = &g.n.e;
+        const ids = s.prompt();
+        if (ids.len == 0 or ids.len + s.max_new + max_rows > e.st.capacity) return error.PromptTooLong;
+        s.cached = 0;
+        // a kept state of this prompt's prefix resumes in a lane whose rows hold it, or in a free lane they are
+        // copied to; without one the pass starts at 0 in the free lane used longest ago
+        const kept: ?*const Snap = if (s.reuse.saved) |saved| @ptrCast(@alignCast(saved)) else null;
+        var views: [max_lanes]View = undefined;
+        for (g.lanes[0..g.n_lanes], views[0..g.n_lanes]) |*l, *v| v.* = .{
+            .busy = l.stream != null,
+            .used = l.used,
+            .holds = if (kept) |sn| sn.at < ids.len and liveHolds(l, sn) else false,
+        };
+        const pick = pickLane(views[0..g.n_lanes]) orelse return error.NoFreeLane;
+        const ln = &g.lanes[pick.lane];
+        try g.n.bind(pick.lane);
+        ln.stream = s;
+        errdefer ln.stream = null;
+        g.clock += 1;
+        ln.used = g.clock;
+        // v1.8's copy rule in place of the core's suffix lookup (which TF_GLM_COPY_DRAFTS=0 turns off as well)
+        s.proposer = null;
+        if (s.drafts and ln.copy.cfg.on) {
+            ln.copy.reset(s.prompt_len);
+            s.proposer = ln.copy.proposer();
+        }
+        ln.pending_rows = 0;
+        ln.held_n = 0;
+        ln.dn = 0;
+        var at: usize = 0;
+        var snap = node.no_snapshot;
+        if (kept) |sn| {
+            if (views[pick.lane].holds or pick.from != null) {
+                if (pick.from) |src| {
+                    try g.n.copy(src, pick.lane, sn.at);
+                    ln.live.clearRetainingCapacity();
+                    try ln.live.appendSlice(g.gpa, g.lanes[src].live.items[0..sn.at]);
+                }
+                snap = sn.id;
+                at = sn.at;
+            } else s.reuse_failed = true;
+        }
+        ln.live.shrinkRetainingCapacity(@min(ln.live.items.len, at));
+        try g.n.begin(ids, g.drafts and !g.dflash, snap, at);
+        s.cached = @intCast(at);
+        return at;
+    }
+
+    /// multi_prefill (TF_GLM_MULTI_PREFILL): several prompts admitted together share prompt chunks. Each chunk round plans one
+    /// piece a prompt, its next cut exactly as its own pass would take it (nextCut), the fewest rows left first, while the
+    /// prompt buffers hold them (each piece at a multiple of 64 rows); a prompt that does not fit waits for the next round.
+    /// A round of one piece is a chunk of its own (Node.chunk). With the MTP head each prompt fills alone.
+    // ponytail: a failed admission fails the whole group (the host drops each); per-stream errors if groups grow large
+    fn prefillManyFn(p: *anyopaque, streams: []*lanes.Stream) anyerror!void {
+        const g = of(p);
+        if (streams.len < 2 or (g.drafts and !g.dflash)) {
+            for (streams) |s| try prefillFn(p, s);
+            return;
+        }
+        if (streams.len > max_lanes) return error.NoFreeLane;
+        var at: [max_lanes]usize = undefined;
+        var next: [max_lanes]usize = @splat(0);
+        var lane: [max_lanes]usize = undefined;
+        var admitted: usize = 0;
+        errdefer for (lane[0..admitted]) |l| {
+            g.lanes[l].stream = null;
+        };
+        for (streams, 0..) |s, i| {
+            at[i] = try g.admitPrompt(s);
+            lane[i] = g.n.e.lane;
+            admitted += 1;
+        }
+        defer {
+            g.pass = &.{};
+            g.pass_at = null;
+        }
+        while (true) {
+            var order: [max_lanes]usize = undefined;
+            var m: usize = 0;
+            for (streams, 0..) |s, i| if (at[i] < s.prompt().len and !s.isCancelled()) {
+                order[m] = i;
+                m += 1;
+            };
+            if (m == 0) break;
+            const left = struct {
+                fn less(ctx: struct { []*lanes.Stream, []const usize }, a: usize, b: usize) bool {
+                    return ctx[0][a].prompt().len - ctx[1][a] < ctx[0][b].prompt().len - ctx[1][b];
+                }
+            };
+            std.sort.insertion(usize, order[0..m], .{ streams, at[0..streams.len] }, left.less);
+            var items: [max_lanes][3]usize = undefined;
+            var picked: [max_lanes]usize = undefined;
+            var n: usize = 0;
+            var used: usize = 0;
+            for (order[0..m]) |i| {
+                var nx = next[i];
+                const rows = nextCut(streams[i], at[i], &nx);
+                const lo = std.mem.alignForward(usize, used, 64);
+                if (lo + rows > fwd.Engine.prefill_rows) continue;
+                next[i] = nx;
+                items[n] = .{ lane[i], at[i], rows };
+                picked[n] = i;
+                n += 1;
+                used = lo + rows;
+            }
+            if (n == 1) {
+                try g.n.bind(lane[picked[0]]);
+                try g.n.chunk(at[picked[0]], items[0][2]);
+            } else try g.n.chunkLanes(items[0..n]);
+            for (items[0..n], picked[0..n]) |it, i| {
+                const s = streams[i];
+                const ln = &g.lanes[lane[i]];
+                try ln.live.appendSlice(g.gpa, s.prompt()[at[i]..][0..it[2]]);
+                at[i] += it[2];
+                if (std.mem.indexOfScalar(u32, s.reuse.marks, @intCast(at[i])) != null) if (s.reuse.hook) |hk| {
+                    try g.n.bind(lane[i]); // snapSave keeps the bound lane's state
+                    g.pass = s.prompt();
+                    g.pass_at = @intCast(at[i]);
+                    hk.at(hk.ptr, s, @intCast(at[i]));
+                };
+            }
+        }
+        for (streams, 0..) |s, i| {
+            if (s.isCancelled()) continue; // the core releases it
+            try g.n.bind(lane[i]);
+            try g.firstOf(s, &g.lanes[lane[i]]);
+        }
+    }
+
+    fn firstFn(p: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        const g = of(p);
+        if (position != s.prompt_len) return error.PositionMismatch;
+        return (g.laneOf(s) orelse return error.NoLane).first;
+    }
+
+    fn queueFn(p: *anyopaque, s: *lanes.Stream, feed: be.Feed, position: u64) anyerror!u64 {
+        _ = p;
+        _ = s;
+        _ = feed;
+        _ = position;
+        return error.NotPipelined;
+    }
+
+    fn readFn(p: *anyopaque, handle: u64) anyerror!u32 {
+        const g = of(p);
+        if (handle >= g.next or g.next - handle > ring) return error.NoSuchToken;
+        return g.drawn[handle % ring];
+    }
+
+    /// One window: the pending token, the drafts held here, then host drafts; every row's greedy token.
+    fn verifyFn(p: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const g = of(p);
+        if (windows.len > 1) return g.verifyShared(windows, out);
+        if (windows.len != 1) return error.OneStreamAtATime;
+        const w = windows[0];
+        if (w.parents != null) return error.TreesNotBuilt;
+        const ln = try g.enter(w.stream);
+        try g.commit(ln, ln.pending_rows); // no keep since the last window: all of its rows stay (Nemotron's bindLane)
+        const rows = w.rows();
+        if (rows > max_rows) return error.WindowTooWide;
+        if (w.held > ln.held_n) return error.NoHeldDrafts;
+        const e = &g.n.e;
+        for (w.positions, 0..) |pos, r| if (pos != e.st.pos + 1 + r) return error.PositionMismatch;
+        var ids: [max_rows]u32 = undefined;
+        ids[0] = w.pending;
+        @memcpy(ids[1..][0..w.held], ln.held[0..w.held]);
+        @memcpy(ids[1 + w.held ..][0..w.tokens.len], w.tokens);
+        const k = try candidateCount(w.stream);
+        try g.n.verify(ids[0..rows], k, out[0].sampled[0..rows]);
+        if (k > 0) try g.choose(w.stream, .window, k, rows, w.positions[0], out[0].sampled[0..rows]);
+        @memcpy(out[0].drafts[0 .. rows - 1], ids[1..rows]);
+        @memcpy(ln.window[0..rows], ids[0..rows]);
+        ln.pending_rows = rows;
+        ln.held_n = 0;
+    }
+
+    /// Several streams' windows (a shared round) in one forward, each lane's rows back to back in the windows' order.
+    fn verifyShared(g: *Glm, windows: []const be.Window, out: []be.Verified) !void {
+        if (windows.len > max_lanes) return error.TooManyWindows;
+        var segs: [max_lanes]fwd.Engine.Seg = undefined;
+        var ks: [max_lanes]usize = undefined;
+        var ids: [fwd.Engine.shared_rows]u32 = undefined;
+        var total: usize = 0;
+        for (windows, 0..) |w, i| {
+            if (w.parents != null) return error.TreesNotBuilt;
+            const ln = try g.enter(w.stream);
+            try g.commit(ln, ln.pending_rows); // no keep since its last window: all of its rows stay
+            const rows = w.rows();
+            if (total + rows > g.sharedRows()) return error.WindowTooWide;
+            if (w.held > ln.held_n) return error.NoHeldDrafts;
+            for (w.positions, 0..) |pos, r| if (pos != g.n.e.st.pos + 1 + r) return error.PositionMismatch;
+            ids[total] = w.pending;
+            @memcpy(ids[total + 1 ..][0..w.held], ln.held[0..w.held]);
+            @memcpy(ids[total + 1 + w.held ..][0..w.tokens.len], w.tokens);
+            segs[i] = .{ .lane = g.n.e.lane, .rows = rows };
+            ks[i] = try candidateCount(w.stream);
+            total += rows;
+        }
+        const n = windows.len;
+        try g.n.verifyShared(segs[0..n], ids[0..total]);
+        var at: usize = 0;
+        for (windows, out, segs[0..n], ks[0..n]) |w, *o, sg, k| {
+            const rows = sg.rows;
+            try g.n.bind(sg.lane); // a draw's `nucleus` reads the bound lane's rows
+            try g.n.pickSegment(sg, k, o.sampled[0..rows]);
+            if (k > 0) try g.choose(w.stream, .window, k, rows, w.positions[0], o.sampled[0..rows]);
+            @memcpy(o.drafts[0 .. rows - 1], ids[at + 1 ..][0 .. rows - 1]);
+            const ln = &g.lanes[sg.lane];
+            @memcpy(ln.window[0..rows], ids[at..][0..rows]);
+            ln.pending_rows = rows;
+            ln.held_n = 0;
+            at += rows;
+        }
+    }
+
+    fn keepFn(p: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const g = of(p);
+        if (paths.len != windows.len) return error.PathsWithoutWindows;
+        for (paths, windows) |path, w| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+            try g.commit(try g.enter(w.stream), path.len);
+        }
+    }
+
+    /// DFlash2 in place of the MTP head (v1.8's dflash_decode): the kept rows' taps join its context, then, unless a copy is
+    /// ahead (v1.8 takes the copy first and runs no block), its block pass and chain (its own stop rule, not `r.depth`, up to
+    /// TF_GLM_DFLASH_POLICY's most) give the next window's drafts as host tokens (`treeFn`). The first round after a prompt
+    /// is taken as `r.depth` held drafts (the core does not ask for the chain there), filled up with the pending token.
+    fn draftDflash(g: *Glm, ln: *Lane, r: be.DraftRequest) !void {
+        const t = try g.dflashTaps(ln, r, true);
+        g.dflashChain(ln, r, t, if (t.want > 0) &g.n.dflash.? else null);
+    }
+
+    /// A DFlash2 turn's first half: the kept rows committed and joined to the lane's context, and how many drafts it wants.
+    const Turn = struct { want: usize, pending: u32 };
+
+    /// The bound lane's DFlash2 turn up to its chain: commit, the context update and, with `block`, its own block pass.
+    fn dflashTaps(g: *Glm, ln: *Lane, r: be.DraftRequest, block: bool) !Turn {
+        const s = r.stream;
+        var from: node.From = .prompt;
+        var keep: usize = 0;
+        var pending: u32 = undefined;
+        if (r.rows) |rows| {
+            for (rows, 0..) |row, i| if (row != i) return error.TreesNotBuilt;
+            try g.commit(ln, rows.len);
+            if (r.position != g.n.e.st.pos + 1) return error.PositionMismatch;
+            from = .verify;
+            keep = rows.len;
+            pending = r.follow[rows.len - 1];
+        } else {
+            if (r.position != g.n.e.st.pos + 1) return error.PositionMismatch;
+            pending = if (r.follow.len > 0) r.follow[0] else try g.value(r.first orelse return error.NoFirstToken);
+        }
+        const room: i64 = s.draftRoom() - 1;
+        var want: usize = if (room > 0) @min(g.policy.most, @as(usize, @intCast(room))) else 0;
+        if (r.depth == 0) want = 0; // forced rows ahead: absorb only
+        if (want > 0) if (s.proposer) |pr| {
+            const width: i64 = @min(@as(i64, @intCast(g.copy_cfg.most)), room);
+            const found = pr.propose(s.context.items, width) catch @as([]const u32, &.{});
+            if (found.len >= 2 and pr.lastMatch() >= 8) want = 0; // the core's own copy test
+        };
+        try g.n.dflashTurn(from, keep, pending, block and want > 0);
+        return .{ .want = want, .pending = pending };
+    }
+
+    /// A DFlash2 turn's second half: the chain from `dft`'s candidates (null: no block pass ran, no drafts), held.
+    fn dflashChain(g: *Glm, ln: *Lane, r: be.DraftRequest, t: Turn, dft: ?*const dflash.Drafter) void {
+        const s = r.stream;
+        ln.dn = if (dft) |d| d.chain(t.want, t.pending, r.position, if (s.sampling) |sm| .{ .seed = sm.seed, .temperature = sm.temperature } else null, g.policy, &ln.dtoks) else 0;
+        const held = @max(ln.dn, r.depth);
+        @memcpy(ln.held[0..ln.dn], ln.dtoks[0..ln.dn]);
+        for (ln.dn..held) |i| ln.held[i] = t.pending;
+        ln.held_n = held;
+    }
+
+    /// A shared round's DFlash2 turns (facts.draft_streams): each lane's context update on its own, then the block passes of
+    /// every lane that wants drafts in one (Node.dflashBlocks; one lane alone takes its own captured pass), then the chains.
+    fn draftDflashLanes(g: *Glm, requests: []const be.DraftRequest) !void {
+        if (requests.len > max_lanes) return error.TooManyWindows;
+        var turns: [max_lanes]Turn = undefined;
+        var idx: [max_lanes]usize = undefined;
+        var blocked: [max_lanes]bool = @splat(false);
+        var ls: [max_lanes]usize = undefined;
+        var pend: [max_lanes]u32 = undefined;
+        var m: usize = 0;
+        // every lane's kept rows in one commit (Node.keepLanes), before the turns: each turn's own commit then finds nothing
+        var keeps: [max_lanes]fwd.Engine.Keep = undefined;
+        var nk: usize = 0;
+        for (requests) |r| {
+            const rows = r.rows orelse continue;
+            for (rows, 0..) |row, i| if (row != i) return error.TreesNotBuilt;
+            for (g.lanes[0..g.n_lanes], 0..) |*ln, li| if (ln.stream == r.stream and ln.pending_rows > 0) {
+                keeps[nk] = .{ .lane = li, .rows = ln.pending_rows, .keep = rows.len };
+                nk += 1;
+            };
+        }
+        if (nk > 0) {
+            try g.n.keepLanes(keeps[0..nk]);
+            for (keeps[0..nk]) |k| {
+                const ln = &g.lanes[k.lane];
+                try ln.live.appendSlice(g.gpa, ln.window[0..k.keep]);
+                ln.pending_rows = 0;
+            }
+        }
+        for (requests, 0..) |r, i| {
+            const ln = try g.enter(r.stream);
+            idx[i] = g.n.e.lane;
+            turns[i] = try g.dflashTaps(ln, r, false);
+            if (turns[i].want > 0 and (try g.n.drafterOf(idx[i])).context_end > 0) {
+                blocked[i] = true;
+                ls[m] = idx[i];
+                pend[m] = turns[i].pending;
+                m += 1;
+            }
+        }
+        if (m == 1) {
+            try g.n.bind(ls[0]);
+            try g.n.dflashTurn(.prompt, 0, pend[0], true);
+        } else if (m > 1) try g.n.dflashBlocks(ls[0..m], pend[0..m]);
+        for (requests, 0..) |r, i| g.dflashChain(&g.lanes[idx[i]], r, turns[i], if (blocked[i]) try g.n.drafterOf(idx[i]) else null);
+    }
+
+    fn treeFn(p: *anyopaque, s: *lanes.Stream, gpa: std.mem.Allocator) anyerror!?lanes.stream.Held {
+        const g = of(p);
+        if (!g.dflash) return null;
+        const ln = g.laneOf(s) orelse return error.NoLane;
+        return .{ .count = @intCast(ln.dn), .tokens = try gpa.dupe(u32, ln.dtoks[0..ln.dn]) };
+    }
+
+    /// Absorb the kept rows with their following tokens, then hold `depth` drafts for the next window.
+    fn draftFn(p: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const g = of(p);
+        if (g.dflash and requests.len > 1 and g.n.batch != null) return g.draftDflashLanes(requests);
+        for (requests) |r| {
+            const ln = try g.enter(r.stream);
+            if (g.dflash) {
+                try g.draftDflash(ln, r);
+                continue;
+            }
+            if (r.depth > max_rows - 1) return error.DepthPastWindow;
+            if (r.rows) |rows| {
+                for (rows, 0..) |row, i| if (row != i) return error.TreesNotBuilt;
+                try g.commit(ln, rows.len);
+                if (r.position != g.n.e.st.pos + 1) return error.PositionMismatch;
+                try g.n.draft(.verify, r.follow[0..rows.len], ln.held[0..r.depth]);
+            } else {
+                if (r.position != g.n.e.st.pos + 1) return error.PositionMismatch;
+                const first = if (r.follow.len > 0) r.follow[0] else try g.value(r.first orelse return error.NoFirstToken);
+                try g.n.draft(.prompt, &.{first}, ln.held[0..r.depth]);
+            }
+            ln.held_n = r.depth;
+        }
+    }
+
+    /// The stream leaves its lane; the lane's caches and live tokens stay for a later turn of its conversation.
+    fn releaseFn(p: *anyopaque, s: *lanes.Stream) void {
+        const g = of(p);
+        const ln = g.laneOf(s) orelse return;
+        ln.stream = null;
+        ln.pending_rows = 0;
+        ln.held_n = 0;
+        ln.dn = 0;
+    }
+
+    fn backend(g: *Glm) be.Backend {
+        g.vtable = .{ .prefill = prefillFn, .first = firstFn, .queue = queueFn, .read = readFn, .verify = verifyFn, .keep = keepFn, .draft = draftFn, .release = releaseFn, .tree = treeFn, .prefill_many = prefillManyFn };
+        return .{ .ptr = g, .vtable = &g.vtable };
+    }
+
+    fn facts(g: *const Glm) lanes.Model {
+        if (!g.drafts) return .{ .exact_width = 1, .max_streams = 1 };
+        return .{
+            .exact_width = max_rows,
+            .first_copy_rows = if (g.copy_cfg.on) @intCast(@min(g.copy_cfg.most + 1, max_rows)) else 0,
+            .mtp = true,
+            .speculate = true,
+            .speculate_early = false,
+            .drafts = head_drafts,
+            .window_costs = &g.costs,
+            .shared_costs = &g.shared,
+            .mtp_step_ms = if (g.dflash) 0.1 else g.mtp_ms, // DFlash2's block pass costs the same at any depth
+            // several live streams share a forward (verifyShared), up to a window's rows; the lanes `grow` allocated cap
+            // how many streams are live, so one lane never shares
+            .hidden_rows = true,
+            .draft_streams = true, // a shared round's drafts in one call: DFlash2's block passes share one (draftDflashLanes)
+            .streams_exact = true,
+            .batch_rows = @intCast(g.sharedRows()),
+            .max_streams = max_lanes,
+        };
+    }
+
+    /// Shared windows of 2 to max_rows rows over lanes 0 and 1 (half each), timed on whatever their caches hold (both
+    /// ranks run them; no commit, so the lanes stay where they were). Serving overwrites the rows they wrote.
+    fn measureShared(g: *Glm) !void {
+        var ids: [fwd.Engine.shared_rows]u32 = undefined;
+        for (&ids, 0..) |*t, i| t.* = @intCast(3000 + 37 * i);
+        var out: [max_rows]u32 = undefined;
+        g.shared[0] = g.costs[0];
+        for (2..g.sharedRows() + 1) |total| {
+            const segs = [2]fwd.Engine.Seg{ .{ .lane = 0, .rows = (total + 1) / 2 }, .{ .lane = 1, .rows = total / 2 } };
+            var best: f64 = std.math.inf(f64);
+            for (0..3) |_| {
+                const t0 = now(g.io);
+                try g.n.verifyShared(&segs, ids[0..total]);
+                for (segs) |sg| try g.n.pickSegment(sg, 0, out[0..sg.rows]);
+                best = @min(best, ms(g.io, t0));
+            }
+            g.shared[total - 1] = .{ .width = @intCast(total), .ms = best };
+        }
+        std.log.info("GLM shared window ms by rows (two lanes): 2 {d:.1}, 4 {d:.1}, 8 {d:.1}, 16 {d:.1}, {d} {d:.1}", .{ g.shared[1].ms, g.shared[3].ms, g.shared[7].ms, g.shared[15].ms, g.sharedRows(), g.shared[g.sharedRows() - 1].ms });
+    }
+
+    /// TF_GLM_SHARED_FLAT (default on; 0 off): every shared width costs as 2 rows, so the core keeps every draft in a
+    /// shared round, as v1.10 does (its multi-stream rounds take each stream's drafts with no depth policy): +1.7% at
+    /// four streams, the same replies.
+    fn flatten(g: *Glm) void {
+        if (std.c.getenv("TF_GLM_SHARED_FLAT")) |v| if (std.mem.eql(u8, std.mem.span(v), "0")) return;
+        for (g.shared[1..g.sharedRows()]) |*c| c.ms = g.shared[1].ms;
+        std.log.info("GLM shared rounds keep every draft (TF_GLM_SHARED_FLAT; costs flat at {d:.1} ms)", .{g.shared[1].ms});
+    }
+
+    /// A shared round's rows at most: fwd.Engine.shared_rows over the segmented kernels, else the lanes' own max_rows.
+    fn sharedRows(g: *const Glm) usize {
+        return if (g.n.e.seg_enabled) fwd.Engine.shared_rows else max_rows;
+    }
+
+    /// Each window width's forward and one chained MTP step, timed on a short dummy prompt (both ranks run it).
+    fn measure(g: *Glm, io: std.Io) !void {
+        var prompt: [64]u32 = undefined;
+        for (&prompt, 0..) |*t, i| t.* = @intCast(1000 + i);
+        _ = try g.n.prefill(&prompt, !g.dflash, 0);
+        var out: [max_rows]u32 = undefined;
+        var ids: [max_rows]u32 = undefined;
+        for (&ids, 0..) |*t, i| t.* = @intCast(2000 + i);
+        for (1..max_rows + 1) |width| {
+            var best: f64 = std.math.inf(f64);
+            for (0..3) |_| {
+                const t0 = now(io);
+                try g.n.verify(ids[0..width], 0, out[0..width]);
+                best = @min(best, ms(io, t0));
+                try g.n.keep(width, 1);
+            }
+            g.costs[width - 1] = .{ .width = @intCast(width), .ms = best };
+        }
+        var one: f64 = std.math.inf(f64);
+        var three: f64 = std.math.inf(f64);
+        if (!g.dflash) for (0..3) |_| {
+            var t0 = now(io);
+            try g.n.draft(.verify, out[0..1], ids[0..1]);
+            one = @min(one, ms(io, t0));
+            t0 = now(io);
+            try g.n.draft(.verify, out[0..1], ids[0..3]);
+            three = @min(three, ms(io, t0));
+        };
+        g.mtp_ms = if (g.dflash) 0.1 else @max(0.1, (three - one) / 2);
+        if (g.dflash) {
+            // DFlash2's pieces (Engine._calibrate's "block" and "taps8"): the block pass with its candidates read back, the
+            // chain on the host, and a context update of the last window's first 8 rows
+            var blk: f64 = std.math.inf(f64);
+            var chn: f64 = std.math.inf(f64);
+            var tap: f64 = std.math.inf(f64);
+            for (0..7) |_| {
+                var t0 = now(io);
+                try g.n.dflashTurn(.prompt, 0, 2000, true);
+                blk = @min(blk, ms(io, t0));
+                t0 = now(io);
+                var dtoks: [dflash_max]u32 = undefined;
+                _ = g.n.dflash.?.chain(7, 2000, 100, null, g.policy, &dtoks);
+                chn = @min(chn, ms(io, t0));
+                t0 = now(io);
+                try g.n.dflashTurn(.verify, 8, 2000, false);
+                tap = @min(tap, ms(io, t0));
+            }
+            std.log.info("GLM DFlash2 ms: block {d:.2}, chain {d:.2}, context update of 8 rows {d:.2}", .{ blk, chn, tap });
+        }
+        var line: [max_rows * 8]u8 = undefined;
+        var w = std.Io.Writer.fixed(&line);
+        for (g.costs) |c| w.print(" {d:.1}", .{c.ms}) catch {};
+        std.log.info("GLM window ms by width:{s}; MTP step {d:.2} ms", .{ w.buffered(), g.mtp_ms });
+    }
+};
+
+/// A stream's candidates a rank (top_k + MARGIN); 0 for greedy. top_k 0 (the full-vocabulary nucleus) is not ported.
+/// k candidates a rank (top_k + exact_sampling.MARGIN), 0 for greedy, or the whole vocabulary: top_k off
+/// (sampling.nucleus_rows) or past the candidates a rank gives.
+fn candidateCount(s: *const lanes.Stream) !usize {
+    const sm = s.sampling orelse return 0;
+    if (sm.temperature <= 0) return 0;
+    const k = @as(usize, sm.top_k) + 8;
+    if (sm.top_k == 0 or k > fwd.Engine.max_k) return Node.whole_vocabulary;
+    return k;
+}
+
+/// sampling.nucleus_rows for one row over the whole vocabulary `row` (bf16 bits by token id). Python reads each
+/// rank's top 1,024 first and every whole shard when a row's nucleus runs past them, so its draw is this one: tokens
+/// in (value desc, id asc) order with v = logit / T in float64, mass floor(exp(v - top) 2^40); keep a token while the
+/// mass before it is below ceil(top_p total) (top_p in (0, 1)), and while v >= top + ln(min_p); the Gumbel race
+/// v - ln(-ln u(seed, position, id)) among them, the first maximum in that order. Both cuts keep a prefix of the
+/// order, so the kept set is found by selection (no sort). Tokens 42 or more below the top are left out: their mass
+/// is 0 (below 2^-40) and their race score stays under the top token's (the race's noise spans 41.1).
+fn nucleus(gpa: std.mem.Allocator, row: []const u16, position: u64, s: lanes.sampling.Sampling) !u32 {
+    const t = @max(s.temperature, 1e-6);
+    var top = -std.math.inf(f64);
+    for (row) |b| top = @max(top, bf16Value(b) / t);
+    var cands: std.ArrayList(Tok) = .empty;
+    defer cands.deinit(gpa);
+    try cands.ensureTotalCapacity(gpa, row.len);
+    var total: u64 = 0;
+    const floor = top + s.minLog();
+    for (row, 0..) |b, i| {
+        const v = bf16Value(b) / t;
+        if (v < top - 42.0 or v < floor) continue; // min_p's cut keeps a prefix too: drop its tail now
+        // floor(exp(d) 2^40) is 0 below d = -40 ln 2 (-27.7): no exp for those
+        const mass: u64 = if (v - top < -28.0) 0 else @intFromFloat(@floor(libm_exp(v - top) * 0x1p40));
+        cands.appendAssumeCapacity(.{ .v = v, .id = @intCast(i), .mass = mass });
+    }
+    // the cut's total is every token's mass, the ones below min_p's floor included
+    for (row) |b| {
+        const v = bf16Value(b) / t;
+        if (v >= floor and v >= top - 42.0) continue;
+        if (v - top >= -28.0) total += @intFromFloat(@floor(libm_exp(v - top) * 0x1p40));
+    }
+    for (cands.items) |c| total += c.mass;
+    var kept = cands.items;
+    if (s.top_p > 0.0 and s.top_p < 1.0) kept = kept[0..prefixWithin(kept, ceilShare(s.top_p, total))];
+    var best = kept[0];
+    var best_score = raceScore(best, position, s.seed);
+    for (kept[1..]) |c| {
+        const score = raceScore(c, position, s.seed);
+        if (score > best_score or (score == best_score and before(c, best))) {
+            best = c;
+            best_score = score;
+        }
+    }
+    return best.id;
+}
+
+const Tok = struct { v: f64, id: u32, mass: u64 };
+
+fn before(a: Tok, b: Tok) bool {
+    return a.v > b.v or (a.v == b.v and a.id < b.id);
+}
+
+fn raceScore(c: Tok, position: u64, seed: u64) f64 {
+    return c.v - libm_log(-libm_log(lanes.sampling.uniform(seed, position, c.id)));
+}
+
+/// Reorders `a` so its kept tokens come first and returns how many: a token is kept when the mass of the tokens
+/// before it in (value desc, id asc) order is below `need` (quickselect on that order, expected linear).
+fn prefixWithin(a: []Tok, need: u64) usize {
+    var lo: usize = 0;
+    var hi: usize = a.len;
+    var rem = need;
+    while (hi > lo) {
+        // pivot: the middle element, moved to the end; partition [lo, hi - 1) into before-pivot and after-pivot
+        std.mem.swap(Tok, &a[lo + (hi - lo) / 2], &a[hi - 1]);
+        const p = a[hi - 1];
+        var m = lo;
+        var sum: u64 = 0;
+        for (lo..hi - 1) |i| {
+            if (before(a[i], p)) {
+                sum += a[i].mass;
+                std.mem.swap(Tok, &a[i], &a[m]);
+                m += 1;
+            }
+        }
+        std.mem.swap(Tok, &a[m], &a[hi - 1]); // pivot at m, [lo, m) before it, (m, hi) after it
+        if (sum >= rem) {
+            hi = m; // the kept tokens all lie before the pivot
+            continue;
+        }
+        // [lo, m) and the pivot are kept; the rest only while mass remains
+        if (sum + p.mass >= rem) return m + 1;
+        rem -= sum + p.mass;
+        lo = m + 1;
+    }
+    return lo;
+}
+
+extern "c" fn exp(x: f64) f64;
+extern "c" fn log(x: f64) f64;
+const libm_exp = exp;
+const libm_log = log;
+
+fn bf16Value(b: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, b) << 16));
+}
+
+/// ceil(Fraction(p) * total) exactly: p's double as m 2^-s.
+fn ceilShare(p: f64, total: u64) u64 {
+    const f = std.math.frexp(p); // p = f.significand 2^f.exponent, significand in [0.5, 1)
+    const m: u128 = @intFromFloat(std.math.ldexp(f.significand, 53));
+    const shift: i32 = 53 - f.exponent;
+    const prod = m * total;
+    if (shift <= 0) return @intCast(prod << @intCast(-shift));
+    if (shift >= 128) return @intFromBool(prod > 0);
+    const sh: u7 = @intCast(shift);
+    return @intCast((prod + ((@as(u128, 1) << sh) - 1)) >> sh);
+}
+
+test {
+    _ = @import("glm_segments.zig");
+    _ = @import("glm_kernels.zig");
+}
+
+test "ceilShare is ceil(p * total) over the double's exact value" {
+    try std.testing.expectEqual(@as(u64, 95), ceilShare(0.95, 100)); // 0.95's double sits just below 0.95
+    try std.testing.expectEqual(@as(u64, 50), ceilShare(0.5, 100));
+    try std.testing.expectEqual(@as(u64, 1), ceilShare(0.5, 1));
+    try std.testing.expectEqual(@as(u64, 0), ceilShare(0.5, 0));
+}
+
+fn now(io: std.Io) i96 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+fn ms(io: std.Io, t0: i96) f64 {
+    return @as(f64, @floatFromInt(now(io) - t0)) / 1e6;
+}
+
+/// A switch that is on unless set to "0".
+fn envOff(name: [*:0]const u8) bool {
+    const v = std.c.getenv(name) orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "0");
+}
+
+fn envCount(name: [*:0]const u8, default: usize) usize {
+    const v = std.c.getenv(name) orelse return default;
+    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return default;
+    return if (n >= 1 and n <= fwd.Engine.max_nucleus) n else default;
+}
+
+fn envPort() u16 {
+    const v = std.c.getenv("TF_GLM_PORT") orelse return default_port;
+    return std.fmt.parseInt(u16, std.mem.span(v), 10) catch default_port;
+}
+
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: []const u8, o: Options) !Loaded {
+    std.log.info("GLM-5.3-Flash rank 0: waiting for rank 1 (tf-glm follow) on port {d}", .{envPort()});
+    const n = try Node.init(gpa, io, ctx, dir, kernels, o.context, 0, "", envPort());
+    errdefer n.deinit();
+    const g = try gpa.create(Glm);
+    errdefer gpa.destroy(g);
+    g.* = .{ .nucleus_union = !envOff("TENSORFOLD_NUCLEUS_UNION"), .nucleus_first = envCount("TF_GLM_NUCLEUS", 1024), .gpa = gpa, .n = n, .drafts = o.drafts and (n.w.mtp != null or n.dflash != null), .dflash = n.dflash != null, .policy = try dflash.Policy.fromEnv(), .copy_cfg = try copy.Settings.fromEnv(n.e.wide_graph) };
+    for (&g.lanes) |*ln| ln.* = .{ .copy = .{ .cfg = g.copy_cfg } };
+    if (g.dflash and g.drafts) std.log.info("GLM drafts: DFlash2 (block {d}, up to {d} drafts a round, stop at {d:.2} of the noisy chain, beta {d:.1}); the MTP head is not loaded", .{ n.w.draft.?.block, g.policy.most, g.policy.confidence, g.policy.beta });
+    if (g.drafts and g.copy_cfg.on) std.log.info("GLM copy drafts: up to {d} a round, match {d} tokens, {d} inside the reply, windows of 9 to 15 rows padded to {d}", .{ g.copy_cfg.most, g.copy_cfg.match, g.copy_cfg.reply_match, g.copy_cfg.pad });
+    g.io = io;
+    try g.measure(io);
+    @memcpy(g.shared[0..max_rows], &g.costs);
+    for (g.shared[max_rows..]) |*c| c.* = .{ .width = 0, .ms = 0 }; // width 0: left out (lanes config); measureShared fills them
+    return .{ .backend = g.backend(), .facts = g.facts(), .rows = if (g.drafts) max_rows else 1, .stream_bytes = n.laneBytes(), .ctx = g, .deinit = release };
+}
+
+/// Lanes up to `total` on both ranks, allocated now (native/cuda.zig calls this once, after the memory admission
+/// and before serving): how many there are.
+pub fn grow(p: *anyopaque, total: u32) !u32 {
+    const g = Glm.of(p);
+    g.n_lanes = try g.n.grow(total);
+    if (g.n_lanes > 1 and g.drafts) {
+        try g.measureShared();
+        g.flatten();
+    }
+    return @intCast(g.n_lanes);
+}
+
+/// A lane's state for the pick: whether a stream uses it, when one last took it, and whether its rows hold the
+/// request's kept state.
+const View = struct { busy: bool, used: u64, holds: bool };
+/// The lane a prompt pass runs in, and the lane whose rows it copies first (null: none).
+const Pick = struct { lane: usize, from: ?usize = null };
+
+/// A free lane holding the kept state; else the free lane used longest ago, copying from a busy lane holding it.
+fn pickLane(v: []const View) ?Pick {
+    var oldest: ?usize = null;
+    var holder: ?usize = null;
+    for (v, 0..) |x, i| {
+        if (x.holds) {
+            if (!x.busy) return .{ .lane = i };
+            holder = i;
+        }
+        if (!x.busy and (oldest == null or x.used < v[oldest.?].used)) oldest = i;
+    }
+    return .{ .lane = oldest orelse return null, .from = holder };
+}
+
+test "lanes: a free holder first, else the oldest free lane, copying from a busy holder" {
+    const t = std.testing;
+    try t.expectEqual(Pick{ .lane = 2 }, pickLane(&.{ .{ .busy = false, .used = 1, .holds = false }, .{ .busy = true, .used = 2, .holds = false }, .{ .busy = false, .used = 5, .holds = true } }).?);
+    try t.expectEqual(Pick{ .lane = 2, .from = 0 }, pickLane(&.{ .{ .busy = true, .used = 1, .holds = true }, .{ .busy = false, .used = 9, .holds = false }, .{ .busy = false, .used = 3, .holds = false } }).?);
+    try t.expectEqual(Pick{ .lane = 0 }, pickLane(&.{ .{ .busy = false, .used = 4, .holds = false }, .{ .busy = false, .used = 7, .holds = false } }).?);
+    try t.expectEqual(@as(?Pick, null), pickLane(&.{ .{ .busy = true, .used = 1, .holds = true }, .{ .busy = true, .used = 2, .holds = false } }));
+    try t.expectEqual(Pick{ .lane = 0 }, pickLane(&.{.{ .busy = false, .used = 0, .holds = false }}).?); // one lane: as before
+}
+
+/// Whether lane `ln`'s attention caches' rows still hold kept state `sn`'s tokens: the `at` before it and the one
+/// its MTP rows read past it.
+fn liveHolds(ln: *const Lane, sn: *const Snap) bool {
+    return ln.live.items.len > sn.at and std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(ln.live.items[0 .. sn.at + 1])) == sn.key;
+}
+
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.PromptTooLong => "the prompt and its reply exceed this server's context window: shorten it or lower max_tokens",
+        error.OneStreamAtATime => "this build of the GLM CUDA engine runs one request's window at a time",
+        error.NoFreeLane => "every lane of the GLM CUDA engine is in use: retry when a request finishes",
+        else => null,
+    };
+}
+
+// -- kept prompt states (prompt_cache.Snapshots, wired by native/cuda.zig) ------------------------------------------
+/// A kept state: KDA's state after `at` prompt tokens on both ranks under `id`, and the hash of the `at + 1` tokens
+/// the attention caches must still hold for it (liveHolds).
+const Snap = struct { id: u32, at: u32, key: u64 };
+
+/// prompt_cache.Rules: the MTP head's row at-1 reads token at; prompt kernels change bits with a chunk's rows, so
+/// states are kept and resumed at the request's planned chunk starts only.
+pub const cache_lookahead: u32 = 1;
+pub const cache_planned = true;
+
+pub fn snapBytes(p: *anyopaque, at: u32) u64 {
+    _ = at;
+    return Glm.of(p).n.snapshotBytes();
+}
+
+pub fn snapSave(p: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
+    _ = owner;
+    const g = Glm.of(p);
+    if (g.pass_at != at) return error.SnapshotOutOfStep;
+    if (at >= g.pass.len) return error.NoLookaheadToken;
+    const sn = try g.gpa.create(Snap);
+    errdefer g.gpa.destroy(sn);
+    sn.* = .{ .id = g.next_snap, .at = at, .key = std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(g.pass[0 .. at + 1])) };
+    g.next_snap = if (g.next_snap + 1 == node.no_snapshot) 0 else g.next_snap + 1;
+    try g.n.save(sn.id);
+    return sn;
+}
+
+/// The prompt pass restores a kept state itself (prefillFn), at its first chunk.
+pub fn snapRestore(p: *anyopaque, owner: ?*anyopaque, saved: *anyopaque) anyerror!void {
+    _ = p;
+    _ = owner;
+    _ = saved;
+    return error.RestoredByThePromptPass;
+}
+
+pub fn snapDrop(p: *anyopaque, saved: *anyopaque) void {
+    const g = Glm.of(p);
+    const sn: *Snap = @ptrCast(@alignCast(saved));
+    g.n.drop(sn.id);
+    g.gpa.destroy(sn);
+}
+
+fn release(p: *anyopaque) void {
+    const g = Glm.of(p);
+    for (&g.lanes) |*ln| ln.live.deinit(g.gpa);
+    g.n.quit();
+    g.n.deinit();
+    g.gpa.destroy(g);
+}
