+    a.add(int(c.p_stride));
+    a.add(int(c.b_off));
+    a.add(c.a);
+    a.add(int(c.a_stride));
+    a.add(c.g);
+    a.add(int(c.g_stride));
+    a.add(c.conv_state);
+    a.add(c.conv_w);
