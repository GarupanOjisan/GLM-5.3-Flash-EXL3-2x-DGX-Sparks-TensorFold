+        try t.run("_rmsnorm", .{ rows, 1, 1 }, &.{ p("X", "*bf16", x), int("x_stride", x_stride), p("W", "*bf16", w), p("OUT", "*bf16", out), int("o_stride", o_stride), sums, aot.float("eps", eps) }, &.{ ci("D", d), ci("BLOCK", pow2(d)), flag("SUMS", xs != null) });
+    }
+
