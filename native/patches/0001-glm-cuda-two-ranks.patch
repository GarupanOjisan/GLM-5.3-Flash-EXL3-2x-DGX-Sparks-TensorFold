+            .p = p,
+            .p_stride = e.width,
+            .b_off = kw.b_off,
+            .a = b.ka,
+            .a_stride = ll * 128,
+            .g = b.kg,
+            .g_stride = ll * 128,
+            .conv_state = st.conv + li * conv_layer,
