+        try t.run("_swiglu", .{ rows, w / block, 1 }, &.{ p("GU", "*bf16", gu), p("OUT", "*bf16", out), p("XS", "*fp32", xs), aot.float("LIMIT", limit) }, &.{ ci("W", w), ci("BLOCK", block) });
