+pub fn chain(k: *const Kernels, s: cuda.Stream, c: Chain) !void {
+    var a: cuda.Args = .{};
+    if (c.rows < wide_rows) {
+        a.add(int(c.heads));
+        a.add(c.p);
+        a.add(int(c.p_stride));
+        a.add(int(c.b_off));
+        a.add(c.a);
+        a.add(int(c.a_stride));
+        a.add(c.g);
+        a.add(int(c.g_stride));
+        a.add(c.conv_state);
+        a.add(c.conv_w);
+        a.add(c.state_in);
+        a.add(c.a_log);
+        a.add(c.dt_bias);
+        a.add(c.norm_w);
+        a.add(c.eps);
+        a.add(c.lower);
+        a.add(int(c.rows));
+        a.add(c.out);
+        a.add(c.state_out);
+        a.add(c.k_save);
+        a.add(c.v_save);
+        a.add(c.g_save);
+        a.add(c.b_save);
+        return go(k.chain, s, .{ c.heads, 1, 1 }, 1024, 0, &a);
+    }
+    if (c.q_tmp == 0 or c.y_tmp == 0) return error.WideChainScratch;
+    a.add(int(c.heads));
+    a.add(c.p);
+    a.add(int(c.p_stride));
+    a.add(int(c.b_off));
+    a.add(c.a);
+    a.add(int(c.a_stride));
+    a.add(c.conv_state);
+    a.add(c.conv_w);
+    a.add(c.a_log);
+    a.add(c.dt_bias);
+    a.add(c.lower);
+    a.add(c.q_tmp);
+    a.add(c.k_save);
+    a.add(c.v_save);
+    a.add(c.g_save);
+    a.add(c.b_save);
+    try go(k.prep, s, .{ c.rows, c.heads, 1 }, 512, 0, &a);
+    var b: cuda.Args = .{};
+    b.add(int(c.heads));
+    b.add(c.state_in);
+    b.add(c.q_tmp);
+    b.add(c.k_save);
+    b.add(c.v_save);
+    b.add(c.g_save);
+    b.add(c.b_save);
+    b.add(int(c.rows));
+    b.add(c.y_tmp);
+    b.add(c.state_out);
+    try go(k.step, s, .{ c.heads, 128 / 4 / 4, 1 }, 128, 0, &b);
+    var o: cuda.Args = .{};
+    o.add(int(c.heads));
+    o.add(c.y_tmp);
+    o.add(c.g);
+    o.add(int(c.g_stride));
+    o.add(c.norm_w);
+    o.add(c.eps);
+    o.add(c.out);
+    try go(k.out, s, .{ c.rows, c.heads, 1 }, 128, 0, &o);
+}
