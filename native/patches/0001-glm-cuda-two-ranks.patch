@@ -0,0 +1,413 @@
+// GLM's torch glue between kernels, as small exact kernels (ours): what the Python engine does with torch ops
+// between its Triton and CUDA launches (v0.6.6 families/glm5_next/cuda): copies, the sparse token lists and the
+// greedy pick. Every result is a copy or an integer, so bits cannot differ from torch's.
+
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <stdint.h>
+
+// rows of `bytes` bytes (a multiple of 4) from src (row stride src_ld bytes) to dst (dst_ld): forward.py:407's
+// `b.ey[:R, top_k].copy_(b.sy[:R])`. grid (rows), block 256.
+extern "C" __global__ void tf_glm_copy_rows(const uint32_t* __restrict__ src, uint64_t src_ld, uint32_t* __restrict__ dst,
+                                            uint64_t dst_ld, uint64_t bytes) {
+  const uint64_t r = blockIdx.x;
+  const uint32_t* s = reinterpret_cast<const uint32_t*>(reinterpret_cast<const char*>(src) + r * src_ld);
+  uint32_t* d = reinterpret_cast<uint32_t*>(reinterpret_cast<char*>(dst) + r * dst_ld);
+  for (uint64_t i = threadIdx.x; i < bytes / 4; i += blockDim.x) d[i] = s[i];
+}
+
+// sparse.py:204-215: each row's selected token list and count from its 512 best pools (int64, ascending).
+// q = pos + r; npool = (q + 1) / 4; tokens[r, 4i + j] = pools[r, i] * 4 + j; then the 3 tail tokens past the last
+// whole pool if visible (else -1); count = npool > 512 ? 2048 + visible tails : 0. grid (rows), block 256.
+extern "C" __global__ void tf_glm_tokens(const int64_t* __restrict__ pools, const int* __restrict__ pos, int* __restrict__ tokens,
+                                         int* __restrict__ counts, int width, int k) {
+  const int r = blockIdx.x;
+  const int64_t q = (int64_t)pos[0] + r;
+  const int64_t npool = (q + 1) / 4;
+  int* row = tokens + (int64_t)r * width;
+  for (int i = threadIdx.x; i < k * 4; i += blockDim.x) row[i] = (int)(pools[(int64_t)r * k + i / 4] * 4 + (i % 4));
+  if (threadIdx.x == 0) {
+    int visible = 0;
+    for (int j = 0; j < 3; ++j) {
+      const int64_t tail = npool * 4 + j;
+      const bool ok = tail <= q;
+      row[k * 4 + j] = ok ? (int)tail : -1;
+      visible += ok;
+    }
+    counts[r] = npool > k ? k * 4 + visible : 0;
+  }
+}
+
+// decode.py:34-49 for greedy rows on one rank: torch.topk(logits.float(), 1) gives the row's maximum and its first
+// column; out[r] = (value as fp32 bits, column + offset) for the all-gather. grid (rows), block 1024.
+extern "C" __global__ void tf_glm_greedy(const __nv_bfloat16* __restrict__ logits, int vocab, int ld, int offset,
+                                         uint32_t* __restrict__ out) {
+  __shared__ float best_v[1024];
+  __shared__ int best_i[1024];
+  const int r = blockIdx.x;
+  const __nv_bfloat16* row = logits + (int64_t)r * ld;
+  float v = -INFINITY;
+  int at = 0x7fffffff;
+  for (int i = threadIdx.x; i < vocab; i += blockDim.x) {
+    const float x = __bfloat162float(row[i]);
+    if (x > v || (x == v && i < at)) {
+      v = x;
+      at = i;
+    }
+  }
+  best_v[threadIdx.x] = v;
+  best_i[threadIdx.x] = at;
+  __syncthreads();
+  for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+    if (threadIdx.x < s) {
+      const float ov = best_v[threadIdx.x + s];
+      const int oi = best_i[threadIdx.x + s];
+      if (ov > best_v[threadIdx.x] || (ov == best_v[threadIdx.x] && oi < best_i[threadIdx.x])) {
+        best_v[threadIdx.x] = ov;
+        best_i[threadIdx.x] = oi;
+      }
+    }
+    __syncthreads();
+  }
+  if (threadIdx.x == 0) {
+    out[2 * r] = __float_as_uint(best_v[0]);
+    out[2 * r + 1] = (uint32_t)(best_i[0] + offset);
+  }
+}
+
+// decode.py:31-37 for sampled rows on one rank: torch.topk(logits.float(), k) of the rank's vocabulary slice, as
+// (value as fp32 bits, column + offset) pairs; which pairs, not their order, matters (the host chooser sorts them).
+// The k-th largest bf16 key is found in two 8-bit radix passes; columns above it are all taken, columns equal to it
+// in column order until k. grid (rows), block 1024, k <= 1024.
+__device__ __forceinline__ uint32_t tf_glm_key(unsigned short b) {
+  return (b & 0x8000) ? (uint32_t)(~b & 0xffff) : (uint32_t)(b | 0x8000);
+}
+
+extern "C" __global__ void tf_glm_topk(const unsigned short* __restrict__ logits, int vocab, int ld, int k, int offset,
+                                       uint32_t* __restrict__ out) {
+  __shared__ int hist[256];
+  __shared__ int sel_hi, sel_lo, above_hi, need_eq, written;
+  const int r = blockIdx.x;
+  const unsigned short* row = logits + (int64_t)r * ld;
+  uint32_t* o = out + (int64_t)r * 2 * k;
+  for (int i = threadIdx.x; i < 256; i += blockDim.x) hist[i] = 0;
+  __syncthreads();
+  for (int i = threadIdx.x; i < vocab; i += blockDim.x) atomicAdd(&hist[tf_glm_key(row[i]) >> 8], 1);
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    int above = 0, b = 255;
+    while (b > 0 && above + hist[b] < k) above += hist[b--];
+    sel_hi = b;
+    above_hi = above;
+  }
+  __syncthreads();
+  for (int i = threadIdx.x; i < 256; i += blockDim.x) hist[i] = 0;
+  __syncthreads();
+  for (int i = threadIdx.x; i < vocab; i += blockDim.x) {
+    const uint32_t key = tf_glm_key(row[i]);
+    if ((int)(key >> 8) == sel_hi) atomicAdd(&hist[key & 0xff], 1);
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    int above = above_hi, b = 255;
+    while (b > 0 && above + hist[b] < k) above += hist[b--];
+    sel_lo = b;
+    need_eq = k - above;
+    written = 0;
+  }
+  __syncthreads();
+  const uint32_t threshold = ((uint32_t)sel_hi << 8) | (uint32_t)sel_lo;
+  for (int i = threadIdx.x; i < vocab; i += blockDim.x) {
+    const uint32_t key = tf_glm_key(row[i]);
+    if (key > threshold) {
+      const int at = atomicAdd(&written, 1);
+      o[2 * at] = __float_as_uint(__uint_as_float((uint32_t)row[i] << 16));
+      o[2 * at + 1] = (uint32_t)(i + offset);
+    }
+  }
+  __syncthreads();
+  // ties at the threshold, lowest columns first: a tile of blockDim.x columns at a time, each tie ranked in column order by a
+  // warp ballot and the warps' counts (the same pairs as a serial scan from column 0, without one thread walking the row)
+  __shared__ int warp_ties[32];
+  __shared__ int tie_at, tie_left;
+  if (threadIdx.x == 0) {
+    tie_at = written;
+    tie_left = need_eq;
+  }
+  __syncthreads();
+  const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+  for (int base = 0; base < vocab && tie_left > 0; base += blockDim.x) {
+    const int i = base + threadIdx.x;
+    const bool tie = i < vocab && tf_glm_key(row[i]) == threshold;
+    const unsigned mask = __ballot_sync(0xffffffffu, tie);
+    if (lane == 0) warp_ties[warp] = __popc(mask);
+    __syncthreads();
+    int before = 0;
+    for (int w = 0; w < warp; ++w) before += warp_ties[w];
+    const int rank = before + __popc(mask & ((1u << lane) - 1u));
+    if (tie && rank < tie_left) {
+      o[2 * (tie_at + rank)] = __float_as_uint(__uint_as_float((uint32_t)row[i] << 16));
+      o[2 * (tie_at + rank) + 1] = (uint32_t)(i + offset);
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+      int total = 0;
+      for (int w = 0; w < (int)(blockDim.x >> 5); ++w) total += warp_ties[w];
+      const int took = total < tie_left ? total : tie_left;
+      tie_at += took;
+      tie_left -= took;
+    }
+    __syncthreads();
+  }
+}
+
+// qmm.quantize4 (v0.6.6 glm5_next/cuda/qmm.py:158): bf16 (n, k) -> MLX affine 4-bit groups of 64, one thread a group.
+// scale = bf16(max((hi - lo) / 15, 1e-8)), bias = bf16(lo), q = round-half-even((w - bias) / scale) in 0..15, input
+// 8 i + j of a group at bits 4 j of its word i; fp32 arithmetic as torch's. torch's CUDA tensor / Python scalar multiplies
+// by the fp32 reciprocal (BinaryDivTrueKernel.cu), tensor / tensor divides correctly rounded.
+extern "C" __global__ void tf_glm_quantize4(const __nv_bfloat16* __restrict__ w, int n, int k, uint32_t* __restrict__ words,
+                                            __nv_bfloat16* __restrict__ scales, __nv_bfloat16* __restrict__ biases) {
+  const long long g = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  const int kg = k / 64;
+  if (g >= (long long)n * kg) return;
+  const __nv_bfloat16* x = w + g * 64;   // row g / kg, group g % kg
+  float lo = __bfloat162float(x[0]), hi = lo;
+  for (int i = 1; i < 64; ++i) {
+    const float v = __bfloat162float(x[i]);
+    lo = fminf(lo, v);
+    hi = fmaxf(hi, v);
+  }
+  const __nv_bfloat16 sb = __float2bfloat16_rn(fmaxf(__fmul_rn(hi - lo, 1.0f / 15.0f), 1e-8f));
+  const __nv_bfloat16 bb = __float2bfloat16_rn(lo);
+  const float s = __bfloat162float(sb), b = __bfloat162float(bb);
+  for (int wi = 0; wi < 8; ++wi) {
+    uint32_t word = 0;
+    for (int j = 0; j < 8; ++j) {
+      const float q = fminf(fmaxf(rintf(__fdiv_rn(__fsub_rn(__bfloat162float(x[wi * 8 + j]), b), s)), 0.0f), 15.0f);
+      word |= (uint32_t)q << (4 * j);
+    }
+    words[g * 8 + wi] = word;
+  }
+  scales[g] = sb;
+  biases[g] = bb;
+}
+
+// The squared error of one group of 64 under scale s and bias b, summed in torch's order for `(...).sum(-1)` over 64
+// contiguous fp32 values (Reduce.cuh: 32 lanes, lane t adds x[t] and x[t + 32], then shfl_down sums at offsets
+// 16, 8, 4, 2, 1; checked bit for bit against torch 2.13 on this checkpoint's groups): every op rounds, as torch's
+// separate kernels do (q * s, + b, - g, squared).
+__device__ __forceinline__ float group_error(const float (&g)[64], float s, float b) {
+  float l[32];
+#pragma unroll
+  for (int t = 0; t < 32; ++t) {
+    float e[2];
+#pragma unroll
+    for (int h = 0; h < 2; ++h) {
+      const float v = g[t + 32 * h];
+      const float q = fminf(fmaxf(rintf(__fdiv_rn(__fsub_rn(v, b), s)), 0.0f), 15.0f);
+      const float d = __fsub_rn(__fadd_rn(__fmul_rn(q, s), b), v);
+      e[h] = __fmul_rn(d, d);
+    }
+    l[t] = __fadd_rn(e[0], e[1]);
+  }
+#pragma unroll
+  for (int off = 16; off > 0; off >>= 1)
+#pragma unroll
+    for (int t = 0; t < off; ++t) l[t] = __fadd_rn(l[t], l[t + off]);
+  return l[0];
+}
+
+// qmm.quantize4_mse_raw (v1.8 glm5_next/cuda/qmm.py:179), TF_GLM_DENSE=q4: groups of 64 as quantize4, each group's range
+// the one of 16 clippings a = 1 - 0.45 i / 15 of its min and max with the least squared error (the first on a tie),
+// scale and bias stored as bf16. a is a Python float, cast to fp32 where torch multiplies the fp32 tensor by it.
+// MLX layout out, as tf_glm_quantize4.
+extern "C" __global__ void tf_glm_quantize4_mse(const __nv_bfloat16* __restrict__ w, int n, int k, uint32_t* __restrict__ words,
+                                                __nv_bfloat16* __restrict__ scales, __nv_bfloat16* __restrict__ biases) {
+  const long long gi = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  const int kg = k / 64;
+  if (gi >= (long long)n * kg) return;
+  const __nv_bfloat16* x = w + gi * 64;
+  float g[64];
+#pragma unroll
+  for (int i = 0; i < 64; ++i) g[i] = __bfloat162float(x[i]);
+  float lo0 = g[0], hi0 = g[0];
+#pragma unroll
+  for (int i = 1; i < 64; ++i) {
+    lo0 = fminf(lo0, g[i]);
+    hi0 = fmaxf(hi0, g[i]);
+  }
+  float best_err = 0.0f, best_s = 0.0f, best_b = 0.0f;
+  __nv_bfloat16 best_sb, best_bb;
+  for (int i = 0; i < 16; ++i) {
+    const float a = (float)(1.0 - 0.45 * (double)i / 15.0);
+    const float lo = __fmul_rn(lo0, a), hi = __fmul_rn(hi0, a);
+    const __nv_bfloat16 sb = __float2bfloat16_rn(fmaxf(__fmul_rn(__fsub_rn(hi, lo), 1.0f / 15.0f), 1e-8f));
+    const __nv_bfloat16 bb = __float2bfloat16_rn(lo);
+    const float s = __bfloat162float(sb), b = __bfloat162float(bb);
+    const float err = group_error(g, s, b);
+    if (i == 0 || err < best_err) {
+      best_err = err;
+      best_s = s;
+      best_b = b;
+      best_sb = sb;
+      best_bb = bb;
+    }
+  }
+#pragma unroll
+  for (int wi = 0; wi < 8; ++wi) {
+    uint32_t word = 0;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+      const float q = fminf(fmaxf(rintf(__fdiv_rn(__fsub_rn(g[wi * 8 + j], best_b), best_s)), 0.0f), 15.0f);
+      word |= (uint32_t)q << (4 * j);
+    }
+    words[gi * 8 + wi] = word;
+  }
+  scales[gi] = best_sb;
+  biases[gi] = best_bb;
+}
+
+// qmm.make_f8 (v1.8 qmm.py:412): bf16 (n, k) -> e4m3 (n, k) and an fp32 scale per row and 128 columns, one thread a block:
+// scale = max(absmax * (1 / 448), 1e-30) (torch multiplies by the reciprocal of a Python scalar), value =
+// e4m3(clamp(w / scale, -448, 448)), round to nearest even.
+extern "C" __global__ void tf_glm_make_f8(const __nv_bfloat16* __restrict__ w, int n, int k, uint8_t* __restrict__ q8,
+                                          float* __restrict__ scale) {
+  const long long b = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  const int kb = k / 128;
+  if (b >= (long long)n * kb) return;
+  const __nv_bfloat16* x = w + b * 128;
+  float amax = 0.0f;
+  for (int i = 0; i < 128; ++i) amax = fmaxf(amax, fabsf(__bfloat162float(x[i])));
+  const float s = fmaxf(__fmul_rn(amax, 1.0f / 448.0f), 1e-30f);
+  for (int i = 0; i < 128; ++i) {
+    const float v = fminf(fmaxf(__fdiv_rn(__bfloat162float(x[i]), s), -448.0f), 448.0f);
+    q8[b * 128 + i] = (uint8_t)__nv_cvt_float_to_fp8(v, __NV_SATFINITE, __NV_E4M3);
+  }
+  scale[b] = s;
+}
+
+// -- DFlash2's glue (glm5_next/cuda/dflash2.py): the torch ops between its Triton launches --------------------------
+
+// `self.kc[i].index_copy_(1, idx, k)`: rows [kvh, rows, hd] into a cache [kvh, cap, hd] at the positions pos + r (modulo the
+// ring). grid (rows, kvh), block 128.
+extern "C" __global__ void tf_glm_df_scatter(const __nv_bfloat16* __restrict__ src, __nv_bfloat16* __restrict__ cache,
+                                             const int64_t* __restrict__ pos, int rows, int cap, int ring, int hd) {
+  const int r = blockIdx.x, h = blockIdx.y;
+  int64_t at = pos[0] + r;
+  if (ring) at %= ring;
+  for (int d = threadIdx.x; d < hd; d += blockDim.x)
+    cache[((int64_t)h * cap + at) * hd + d] = src[((int64_t)h * rows + r) * hd + d];
+}
+
+// dflash2_multi's `self.kc[i].index_copy_(1, idx, k)`: the rows [kvh, rows, hd] of blocks of n rows side by side, block s
+// into its slot of the pooled caches (`cache` is slot 0; slot[s] counts rows of cap, the kv heads cap apart) at the positions
+// pos[s] + r (modulo the ring). grid (rows, kvh), block 128.
+extern "C" __global__ void tf_glm_df_scatter_seg(const __nv_bfloat16* __restrict__ src, __nv_bfloat16* __restrict__ cache,
+                                                 const int64_t* __restrict__ pos, const int64_t* __restrict__ slot, int rows, int n,
+                                                 int cap, int ring, int hd) {
+  const int r = blockIdx.x, h = blockIdx.y, s = r / n;
+  int64_t at = pos[s] + r % n;
+  if (ring) at %= ring;
+  const int64_t row = slot[s] * cap + (int64_t)h * cap + at;
+  for (int d = threadIdx.x; d < hd; d += blockDim.x) cache[row * hd + d] = src[((int64_t)h * rows + r) * hd + d];
+}
+
+// `_rotary`: phase = float(pos + r) * inv_freq, cos and sin in fp32, [rows, half]. grid (ceil(rows half / 128)), block 128.
+extern "C" __global__ void tf_glm_df_rope(const int64_t* __restrict__ pos, const float* __restrict__ inv_freq, int rows, int half,
+                                          float* __restrict__ cos_out, float* __restrict__ sin_out) {
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= rows * half) return;
+  const float phase = (float)(pos[0] + i / half) * inv_freq[i % half];
+  cos_out[i] = cosf(phase);
+  sin_out[i] = sinf(phase);
+}
+
+// `self.pos_dev += n`. one thread.
+extern "C" __global__ void tf_glm_df_pos_add(int64_t* __restrict__ pos, int n) { pos[0] += n; }
+
+// `_row`: the ranks' fp32 partials [world, count] added in rank order, then bf16. grid (ceil(count / 256)), block 256.
+extern "C" __global__ void tf_glm_df_rowsum(const float* __restrict__ g, int world, int count, __nv_bfloat16* __restrict__ out) {
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) return;
+  float acc = g[i];
+  for (int w = 1; w < world; ++w) acc += g[(int64_t)w * count + i];
+  out[i] = __float2bfloat16(acc);
+}
+
+// `tap_rows`: five taps [n, d] side by side, [n, 5 d]. grid (n), block 256.
+extern "C" __global__ void tf_glm_df_cat(const __nv_bfloat16* __restrict__ t0, const __nv_bfloat16* __restrict__ t1,
+                                         const __nv_bfloat16* __restrict__ t2, const __nv_bfloat16* __restrict__ t3,
+                                         const __nv_bfloat16* __restrict__ t4, int d, __nv_bfloat16* __restrict__ out) {
+  const __nv_bfloat16* t[5] = {t0, t1, t2, t3, t4};
+  const int r = blockIdx.x;
+  for (int c = threadIdx.x; c < 5 * d; c += blockDim.x) out[(int64_t)r * 5 * d + c] = t[c / d][(int64_t)r * d + c % d];
+}
+
+// `F.linear(h, hproj).float()`: h [rows, k] times w [n, k] transposed, fp32 sums, rounded to bf16 and back. One warp an
+// output. grid (ceil(n / 8), rows), block 256.
+extern "C" __global__ void tf_glm_df_proj(const __nv_bfloat16* __restrict__ h, const __nv_bfloat16* __restrict__ w,
+                                          float* __restrict__ out, int n, int k) {
+  const int col = blockIdx.x * 8 + threadIdx.x / 32, lane = threadIdx.x % 32, row = blockIdx.y;
+  if (col >= n) return;
+  float acc = 0.f;
+  for (int i = lane; i < k; i += 32) acc += __bfloat162float(h[(int64_t)row * k + i]) * __bfloat162float(w[(int64_t)col * k + i]);
+  for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
+  if (lane == 0) out[(int64_t)row * n + col] = __bfloat162float(__float2bfloat16(acc));
+}
+
+// -- the top_p nucleus draw's device side (cuda/sampling.py nucleus_rows, TENSORFOLD_NUCLEUS_UNION): per row, the mass floor(exp(v - top)
+// 2^40) of every token in fixed point (v = logit * (1 / max(T, 1e-6)) in float64 as torch's tensor / scalar computes it, top the
+// maximum over the ranks' row maxima, which `all` holds as tf_glm_greedy wrote them, gathered: [world][rows][value bits, id]),
+// the shard's sum, and the top `count` candidates' (value, id, mass). No fused multiply-add (the module's flags), the same
+// double exp as torch's CUDA kernel.
+__device__ __forceinline__ double tf_nuc_top(const uint32_t* all, int world, int rows, int r, double inv_t) {
+  double top = -INFINITY;
+  for (int k = 0; k < world; ++k) {
+    const double x = (double)__uint_as_float(all[((int64_t)k * rows + r) * 2]) * inv_t;
+    top = x > top ? x : top;
+  }
+  return top;
+}
+
+// grid (rows), block 1024: sums[r] = the shard's mass total (an integer: the order of the sum does not matter).
+extern "C" __global__ void tf_glm_nuc_stats(const unsigned short* __restrict__ logits, int vocab, int ld, double inv_t,
+                                            const uint32_t* __restrict__ all, int world, int rows,
+                                            unsigned long long* __restrict__ sums) {
+  __shared__ unsigned long long red[1024];
+  const int r = blockIdx.x;
+  const unsigned short* row = logits + (int64_t)r * ld;
+  const double top = tf_nuc_top(all, world, rows, r, inv_t);
+  unsigned long long acc = 0;
+  for (int i = threadIdx.x; i < vocab; i += blockDim.x) {
+    const double x = (double)__uint_as_float((uint32_t)row[i] << 16) * inv_t;
+    acc += (unsigned long long)floor(exp(x - top) * 1099511627776.0);
+  }
+  red[threadIdx.x] = acc;
+  __syncthreads();
+  for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+    if (threadIdx.x < s) red[threadIdx.x] += red[threadIdx.x + s];
+    __syncthreads();
+  }
+  if (threadIdx.x == 0) sums[r] = red[0];
+}
+
+// grid (ceil(count / 256), rows), block 256: out[r] = [count value bits (float64)][count ids][count masses][sum][width] as 64-bit
+// words, from tf_glm_topk's (value bits, id) pairs `cand` [rows][count][2].
+extern "C" __global__ void tf_glm_nuc_pack(const uint32_t* __restrict__ cand, int count, double inv_t, const uint32_t* __restrict__ all,
+                                           int world, int rows, const unsigned long long* __restrict__ sums, int width,
+                                           unsigned long long* __restrict__ out) {
+  const int r = blockIdx.y, i = blockIdx.x * blockDim.x + threadIdx.x;
+  unsigned long long* o = out + (int64_t)r * (3 * count + 2);
+  if (i < count) {
+    const uint32_t* c = cand + ((int64_t)r * count + i) * 2;
+    const double x = (double)__uint_as_float(c[0]) * inv_t;
+    const double top = tf_nuc_top(all, world, rows, r, inv_t);
+    o[i] = (unsigned long long)__double_as_longlong(x);
+    o[count + i] = (unsigned long long)c[1];
+    o[2 * count + i] = (unsigned long long)floor(exp(x - top) * 1099511627776.0);
+  }
+  if (blockIdx.x == 0 && threadIdx.x == 0) {
+    o[3 * count] = sums[r];
+    o[3 * count + 1] = (unsigned long long)width;
+  }
+}
diff --git a/zig/kernels/cuda/glm_hc.cu b/zig/kernels/cuda/glm_hc.cu
new file mode 100644
index 0000000..0ec53e0
--- /dev/null
+++ b/zig/kernels/cuda/glm_hc.cu
@@ -0,0 +1,91 @@
+// Device code of src/tensorfold/families/glm5_next/cuda/hc.cu [v1.8] (lines 1-89, ATen includes dropped), checked by zig/tests/cuda/copies.py.
+#include <stdint.h>
+// GLM-5.3-Flash's hyper-connection mixing dots for decode rows (hc_pre's first half) with more blocks than
+// glue._hc_partial, reproducing its bits: that Triton kernel (4 warps, a [32, 128] bf16 tile in the blocked layout
+// sizePerThread [1, 8], threadsPerWarp [2, 16]) sums, for each of 8 steps of 128 inputs, a row's 8 products per
+// thread in input order (products of bf16 values are exact in fp32, so fused or not), then across the 16 lanes of
+// the row with butterflies 8, 4, 2, 1, and adds the steps to a zero accumulator in order; the sum of squares keeps
+// one input per thread (4 warps x 32 lanes), adds the 8 steps' squares to zero in order, then butterflies 16 .. 1
+// within each warp and (w0 + w2) + (w1 + w3) across the warps. PART [rows, 16 blocks, 32]: the 24 dots, then the sum.
+
+#include <cuda_bf16.h>
+
+namespace tf_glm_hc {
+
+constexpr int WIDE = 16384, NB = 16, KB = WIDE / NB, SUB = 128, STEPS = KB / SUB, ROWS = 24;
+
+__device__ __forceinline__ void unpack8(const uint4 v, float (&f)[8]) {
+    const uint32_t w[4] = {v.x, v.y, v.z, v.w};
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        f[2 * i] = __uint_as_float(w[i] << 16);
+        f[2 * i + 1] = __uint_as_float(w[i] & 0xffff0000u);
+    }
+}
+
+// Block (K block, part, row group): warps 0..7 the dots of mixing rows 8 part .. 8 part + 7 (their weights read once
+// for up to RPB rows), warp 8 of part 0 the squares.
+constexpr int RPB = 4;
+
+__global__ void __launch_bounds__(288) hc_partial_kernel(const __nv_bfloat16* __restrict__ X,
+                                                        const __nv_bfloat16* __restrict__ FN, float* __restrict__ part,
+                                                        int rows) {
+    const int b = blockIdx.x, p = blockIdx.y, r0 = blockIdx.z * RPB;
+    const int r1 = min(r0 + RPB, rows);
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    if (warp < 8) {
+        const int m = p * 8 + warp;
+        const int h = lane >> 4, l = lane & 15;
+        const __nv_bfloat16* wr = FN + (size_t)m * WIDE + b * KB;
+        float wf[4][8];
+#pragma unroll
+        for (int i = 0; i < 4; ++i)                    // steps 2 i + h, inputs 8 l .. 8 l + 7 of the step
+            unpack8(__ldg(reinterpret_cast<const uint4*>(wr + (2 * i + h) * SUB + 8 * l)), wf[i]);
+        for (int r = r0; r < r1; ++r) {
+            const __nv_bfloat16* xr = X + (size_t)r * WIDE + b * KB;
+            uint4 xv[4];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) xv[i] = __ldg(reinterpret_cast<const uint4*>(xr + (2 * i + h) * SUB + 8 * l));
+            float s[4];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                float xf[8];
+                unpack8(xv[i], xf);
+                float a = __fmul_rn(wf[i][0], xf[0]);
+#pragma unroll
+                for (int j = 1; j < 8; ++j) a = __fmaf_rn(wf[i][j], xf[j], a);
+#pragma unroll
+                for (int o = 8; o; o >>= 1) a = __fadd_rn(a, __shfl_xor_sync(0xffffffffu, a, o));
+                s[i] = a;
+            }
+            float acc = 0.f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                acc = __fadd_rn(acc, s[i]);                                      // step 2 i (half 0)
+                acc = __fadd_rn(acc, __shfl_sync(0xffffffffu, s[i], 16));       // step 2 i + 1 (half 1)
+            }
+            if (lane == 0) part[((size_t)r * NB + b) * 32 + m] = acc;
+        }
+    } else if (p == 0) {
+        for (int r = r0; r < r1; ++r) {
+            const __nv_bfloat16* xr = X + (size_t)r * WIDE + b * KB;
+            float w[4];
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {              // the Triton kernel's warp j: input 32 j + lane of each step
+                float ss = 0.f;
+#pragma unroll
+                for (int t = 0; t < STEPS; ++t) {
+                    const float x = __bfloat162float(xr[t * SUB + 32 * j + lane]);
+                    ss = __fmaf_rn(x, x, ss);
+                }
+#pragma unroll
+                for (int o = 16; o; o >>= 1) ss = __fadd_rn(ss, __shfl_xor_sync(0xffffffffu, ss, o));
+                w[j] = ss;
+            }
+            if (lane == 0) part[((size_t)r * NB + b) * 32 + ROWS] = __fadd_rn(__fadd_rn(w[0], w[2]), __fadd_rn(w[1], w[3]));
+        }
+    }
+}
+
+
+}  // namespace tf_glm_hc
diff --git a/zig/kernels/cuda/glm_kda.cu b/zig/kernels/cuda/glm_kda.cu
new file mode 100644
index 0000000..26a784b
--- /dev/null
+++ b/zig/kernels/cuda/glm_kda.cu
@@ -0,0 +1,536 @@
+// Device code of src/tensorfold/families/glm5_next/cuda/kda.cu [v1.8] (lines 1-529, ATen includes dropped), checked by zig/tests/cuda/copies.py; v1.8 and v1.10 hold the same file.
+// GLM-5.3-Flash's KDA (Kimi delta attention) on CUDA: one block of 1024 threads per head, a chain of R rows.
+//
+// Per row, following the Hugging Face definition: the depthwise conv over [conv state; q|k|v rows] (4 taps,
+// fp32) with SiLU and one bf16 rounding; fp32 L2 norms of q and k (eps inside the sum, q times DK^-0.5); the
+// per-channel decay g_i = exp(lower * sigmoid(exp(A_log) * (a_i + dt_bias_i))) in fp32; beta = bf16(sigmoid(b));
+// the delta rule in fp32 (decay along the key channel, read with k, correct toward v, read out with q);
+// read-out rounded to bf16; then the gated RMSNorm bf16(w * (y * rsqrt(mean(y^2) + eps)) * sigmoid(gate)).
+// Warp w owns value rows 4w .. 4w + 3, lane l the key columns 4l .. 4l + 3. The state update is one routine
+// (``update``) shared with ``replay``, compiled without FMA contraction, so a replayed prefix of a window gives
+// the bits of the serial steps.
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+namespace tf_glm_kda {
+
+constexpr int DK = 128, DV = 128, TAPS = 4;
+
+__device__ __forceinline__ float bf(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+
+__device__ __forceinline__ float warp_sum(float x) {
+    for (int o = 16; o; o >>= 1) x += __shfl_xor_sync(0xffffffffu, x, o);
+    return x;
+}
+
+__device__ __forceinline__ float sigmoidf_(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+// One delta-rule step on this thread's 4 x 4 block of the state: per-channel decay, read (k), correct toward v.
+__device__ __forceinline__ void update(float (&s)[4][4], const float (&kk)[4], const float (&gg)[4],
+                                       const float* vrow, int warp, float beta) {
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        float kv = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            s[j][i] = s[j][i] * gg[i];
+            kv = kv + s[j][i] * kk[i];
+        }
+        kv = warp_sum(kv);
+        const float delta = (vrow[warp * 4 + j] - kv) * beta;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = s[j][i] + kk[i] * delta;
+    }
+}
+
+__global__ void __launch_bounds__(1024) chain_kernel(
+        int H, const __nv_bfloat16* __restrict__ P, int p_stride, int b_off,
+        const __nv_bfloat16* __restrict__ A, int a_stride, const __nv_bfloat16* __restrict__ G, int g_stride,
+        const __nv_bfloat16* __restrict__ cs, const __nv_bfloat16* __restrict__ cw,
+        const float* __restrict__ state_in, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, float lower, int rows,
+        __nv_bfloat16* __restrict__ out, float* __restrict__ state_out,
+        float* __restrict__ k_save, __nv_bfloat16* __restrict__ v_save, float* __restrict__ g_save,
+        float* __restrict__ b_save) {
+    const int C = 3 * H * DK;                         // conv channels: q | k | v
+    const int h = blockIdx.x;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float qs[DK], ks[DK], vs[DV], ys[DV], gs[DK];
+    __shared__ float beta_s, rinv;
+    int c = -1;
+    if (t < 3 * DK) c = (t / DK) * H * DK + h * DK + (t % DK);
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    const float decay_rate = expf(a_log[h]);
+    for (int r = 0; r < rows; ++r) {
+        if (c >= 0) {
+            float acc = 0.0f;
+#pragma unroll
+            for (int tap = 0; tap < TAPS; ++tap) {
+                const int at = r + tap;
+                const float x = at < TAPS - 1 ? __bfloat162float(cs[(size_t)at * C + c])
+                                              : __bfloat162float(P[(size_t)(at - (TAPS - 1)) * p_stride + c]);
+                acc = acc + __bfloat162float(cw[(size_t)c * TAPS + tap]) * x;
+            }
+            const float act = bf(acc / (1.0f + expf(-acc)));
+            if (t < DK) qs[t] = act;
+            else if (t < 2 * DK) ks[t - DK] = act;
+            else vs[t - 2 * DK] = act;
+        } else if (t >= 512 && t < 512 + DK) {
+            const int i = t - 512;
+            const float a = __bfloat162float(A[(size_t)r * a_stride + h * DK + i]) + dt_bias[h * DK + i];
+            gs[i] = expf(lower * sigmoidf_(decay_rate * a));
+        } else if (t == 1023) {
+            beta_s = bf(sigmoidf_(__bfloat162float(P[(size_t)r * p_stride + b_off + h])));
+        }
+        __syncthreads();
+        if (warp < 2) {
+            float* x = warp == 0 ? qs : ks;
+            float v4[4], ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { v4[i] = x[lane * 4 + i]; ss = ss + v4[i] * v4[i]; }
+            ss = warp_sum(ss);
+            float inv = 1.0f / sqrtf(ss + 1e-6f);
+            __syncwarp();
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                float y = v4[i] * inv;
+                if (warp == 0) y = y * (1.0f / sqrtf((float)DK));
+                x[lane * 4 + i] = y;
+            }
+        }
+        __syncthreads();
+        const float beta = beta_s;
+        float kk[4], qq[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[lane * 4 + i]; qq[i] = qs[lane * 4 + i]; gg[i] = gs[lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, beta);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float o = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) o = o + s[j][i] * qq[i];
+            o = warp_sum(o);
+            if (lane == 0) ys[warp * 4 + j] = bf(o);
+        }
+        if (k_save != nullptr) {
+            const size_t base = ((size_t)r * H + h) * DK;
+            if (t < DK) { k_save[base + t] = ks[t]; g_save[base + t] = gs[t]; }
+            if (t >= DK && t < DK + DV) v_save[base + t - DK] = __float2bfloat16_rn(vs[t - DK]);
+            if (t == 0) b_save[r * H + h] = beta;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            float ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { const float y = ys[lane * 4 + i]; ss = ss + y * y; }
+            ss = warp_sum(ss);
+            if (lane == 0) rinv = 1.0f / sqrtf(ss / (float)DV + eps);
+        }
+        __syncthreads();
+        if (t < DV) {
+            const float yn = ys[t] * rinv;
+            const float yw = __bfloat162float(norm_w[t]) * yn;
+            const float gate = __bfloat162float(G[(size_t)r * g_stride + h * DV + t]);
+            out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
+        }
+        __syncthreads();
+    }
+    if (state_out != nullptr) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+#pragma unroll
+            for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+    }
+}
+
+__global__ void __launch_bounds__(1024) replay_kernel(
+        int H, const float* __restrict__ state_in, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save,
+        const float* __restrict__ b_save, int rows, float* __restrict__ state_out) {
+    const int h = blockIdx.x;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < rows; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(v_save[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = k_save[base + lane * 4 + i]; gg[i] = g_save[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, b_save[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+// All layers at once: block (layer, head); per-layer strides of the state buffers and saved rows.
+__global__ void __launch_bounds__(1024) replay_layers_kernel(
+        int H, const float* __restrict__ state_in, size_t state_stride, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        size_t kv_stride, size_t b_stride, int rows, float* __restrict__ state_out) {
+    const int layer = blockIdx.x / H, h = blockIdx.x % H;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const float* sin = state_in + layer * state_stride;
+    float* sout = state_out + layer * state_stride;
+    const float* ks = k_save + layer * kv_stride;
+    const __nv_bfloat16* vsv = v_save + layer * kv_stride;
+    const float* gsv = g_save + layer * kv_stride;
+    const float* bsv = b_save + layer * b_stride;
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = sin[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < rows; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(vsv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[base + lane * 4 + i]; gg[i] = gsv[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, bsv[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) sout[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+// Long windows: state-independent work for all rows (prep_kernel, out_kernel), the delta rule alone row by row (step_kernel); chain_kernel's bits.
+
+// Block (row, head), 512 threads: conv + SiLU of the 3 x 128 q|k|v channels, the decay, beta, then the q/k norms.
+__global__ void __launch_bounds__(512) prep_kernel(
+        int H, const __nv_bfloat16* __restrict__ P, int p_stride, int b_off,
+        const __nv_bfloat16* __restrict__ A, int a_stride, const __nv_bfloat16* __restrict__ cs,
+        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        float lower, float* __restrict__ q_out, float* __restrict__ k_save, __nv_bfloat16* __restrict__ v_save,
+        float* __restrict__ g_save, float* __restrict__ b_save) {
+    const int C = 3 * H * DK;
+    const int r = blockIdx.x, h = blockIdx.y;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float qs[DK], ks[DK];
+    const size_t base = ((size_t)r * H + h) * DK;
+    if (t < 3 * DK) {
+        const int c = (t / DK) * H * DK + h * DK + (t % DK);
+        float acc = 0.0f;
+#pragma unroll
+        for (int tap = 0; tap < TAPS; ++tap) {
+            const int at = r + tap;
+            const float x = at < TAPS - 1 ? __bfloat162float(cs[(size_t)at * C + c])
+                                          : __bfloat162float(P[(size_t)(at - (TAPS - 1)) * p_stride + c]);
+            acc = acc + __bfloat162float(cw[(size_t)c * TAPS + tap]) * x;
+        }
+        const float act = bf(acc / (1.0f + expf(-acc)));
+        if (t < DK) qs[t] = act;
+        else if (t < 2 * DK) ks[t - DK] = act;
+        else v_save[base + t - 2 * DK] = __float2bfloat16_rn(act);
+    } else {
+        const int i = t - 3 * DK;
+        const float decay_rate = expf(a_log[h]);
+        const float a = __bfloat162float(A[(size_t)r * a_stride + h * DK + i]) + dt_bias[h * DK + i];
+        g_save[base + i] = expf(lower * sigmoidf_(decay_rate * a));
+        if (i == 0) b_save[r * H + h] = bf(sigmoidf_(__bfloat162float(P[(size_t)r * p_stride + b_off + h])));
+    }
+    __syncthreads();
+    if (warp < 2) {
+        const float* x = warp == 0 ? qs : ks;
+        float v4[4], ss = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { v4[i] = x[lane * 4 + i]; ss = ss + v4[i] * v4[i]; }
+        ss = warp_sum(ss);
+        float inv = 1.0f / sqrtf(ss + 1e-6f);
+        float* dst = warp == 0 ? q_out : k_save;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            float y = v4[i] * inv;
+            if (warp == 0) y = y * (1.0f / sqrtf((float)DK));
+            dst[base + lane * 4 + i] = y;
+        }
+    }
+}
+
+// Block (head, part): each warp owns 4 value rows; TR rows of saved k, q, decay, v and beta are staged in shared memory at a time.
+template <int WARPS, int TR>
+__global__ void __launch_bounds__(WARPS * 32) step_kernel(
+        int H, const float* __restrict__ state_in, const float* __restrict__ q_in, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        int rows, __nv_bfloat16* __restrict__ y_out, float* __restrict__ state_out) {
+    constexpr int NT = WARPS * 32, VR = WARPS * 4;
+    const int h = blockIdx.x, v0 = blockIdx.y * VR;
+    const int lw = threadIdx.x >> 5, lane = threadIdx.x & 31, warp = blockIdx.y * WARPS + lw;
+    __shared__ __align__(16) float kt[TR][DK];
+    __shared__ __align__(16) float qt[TR][DK];
+    __shared__ __align__(16) float gt[TR][DK];
+    __shared__ __align__(16) float vt[TR][VR];
+    __shared__ float bt[TR];
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r0 = 0; r0 < rows; r0 += TR) {
+        const int n = rows - r0 < TR ? rows - r0 : TR;
+        __syncthreads();
+        for (int x = threadIdx.x; x < n * DK; x += NT) {
+            const int rr = x / DK, c = x % DK;
+            const size_t base = ((size_t)(r0 + rr) * H + h) * DK + c;
+            kt[rr][c] = k_save[base];
+            qt[rr][c] = q_in[base];
+            gt[rr][c] = g_save[base];
+        }
+        for (int x = threadIdx.x; x < n * VR; x += NT) {
+            const int rr = x / VR, c = x % VR;
+            vt[rr][c] = __bfloat162float(v_save[((size_t)(r0 + rr) * H + h) * DV + v0 + c]);
+        }
+        if (threadIdx.x < n) bt[threadIdx.x] = b_save[(r0 + threadIdx.x) * H + h];
+        __syncthreads();
+        for (int rr = 0; rr < n; ++rr) {
+            const float4 k4 = reinterpret_cast<const float4*>(kt[rr])[lane];      // one 16-byte load a lane:
+            const float4 q4 = reinterpret_cast<const float4*>(qt[rr])[lane];      // no bank conflicts
+            const float4 g4 = reinterpret_cast<const float4*>(gt[rr])[lane];
+            const float4 v4 = reinterpret_cast<const float4*>(vt[rr])[lw];
+            float kk[4] = {k4.x, k4.y, k4.z, k4.w}, qq[4] = {q4.x, q4.y, q4.z, q4.w};
+            float gg[4] = {g4.x, g4.y, g4.z, g4.w}, vv[4] = {v4.x, v4.y, v4.z, v4.w};
+            update(s, kk, gg, vv, 0, bt[rr]);
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                float o = 0.0f;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) o = o + s[j][i] * qq[i];
+                o = warp_sum(o);
+                if (lane == 0) y_out[((size_t)(r0 + rr) * H + h) * DV + warp * 4 + j] = __float2bfloat16_rn(o);
+            }
+        }
+    }
+    if (state_out != nullptr) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+#pragma unroll
+            for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+    }
+}
+
+// Block (row, head), 128 threads: the gated RMSNorm of the read-out.
+__global__ void __launch_bounds__(128) out_kernel(
+        int H, const __nv_bfloat16* __restrict__ y_in, const __nv_bfloat16* __restrict__ G, int g_stride,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, __nv_bfloat16* __restrict__ out) {
+    const int r = blockIdx.x, h = blockIdx.y;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float rinv;
+    const size_t base = ((size_t)r * H + h) * DV;
+    if (warp == 0) {
+        float ss = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { const float y = __bfloat162float(y_in[base + lane * 4 + i]); ss = ss + y * y; }
+        ss = warp_sum(ss);
+        if (lane == 0) rinv = 1.0f / sqrtf(ss / (float)DV + eps);
+    }
+    __syncthreads();
+    const float yn = __bfloat162float(y_in[base + t]) * rinv;
+    const float yw = __bfloat162float(norm_w[t]) * yn;
+    const float gate = __bfloat162float(G[(size_t)r * g_stride + h * DV + t]);
+    out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
+}
+
+// Several streams' windows in one launch. A segment table (int32 [nseg, SEG_COLS]: first row, rows, state slot,
+// parity, conv slot, keep) cuts the window's rows into streams; each segment reads its conv taps from its own
+// conv slot and runs the recurrence from rec[slot, parity] into rec[slot, 1 - parity]. Per row the arithmetic is
+// the solo kernels' line for line (same ``update``), so a segment's bits equal a solo run of its rows. A segment
+// of 0 rows is skipped: a table sized for the most streams serves fewer (grids stay fixed for CUDA graphs).
+constexpr int SEG_COLS = 6, SEG_ROW0 = 0, SEG_ROWS = 1, SEG_SLOT = 2, SEG_PARITY = 3, SEG_CONV = 4, SEG_KEEP = 5;
+
+// prep_kernel for block (row, head) of the whole window; the row's conv taps come from its segment.
+__global__ void __launch_bounds__(512) prep_seg_kernel(
+        int H, const int* __restrict__ seg, int nseg, const __nv_bfloat16* __restrict__ P, int p_stride, int b_off,
+        const __nv_bfloat16* __restrict__ A, int a_stride, const __nv_bfloat16* __restrict__ conv,
+        size_t conv_slot_stride, const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log,
+        const float* __restrict__ dt_bias, float lower, float* __restrict__ q_out, float* __restrict__ k_save,
+        __nv_bfloat16* __restrict__ v_save, float* __restrict__ g_save, float* __restrict__ b_save) {
+    const int C = 3 * H * DK;
+    const int r = blockIdx.x, h = blockIdx.y;
+    int row0 = -1, cslot = 0;
+    for (int i = 0; i < nseg; ++i) {
+        const int* e = seg + i * SEG_COLS;
+        if (r >= e[SEG_ROW0] && r < e[SEG_ROW0] + e[SEG_ROWS]) { row0 = e[SEG_ROW0]; cslot = e[SEG_CONV]; }
+    }
+    if (row0 < 0) return;                             // a row no segment covers
+    const int rr = r - row0;                          // the row within its stream's window
+    const __nv_bfloat16* cs = conv + (size_t)cslot * conv_slot_stride;
+    const __nv_bfloat16* Ps = P + (size_t)row0 * p_stride;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float qs[DK], ks[DK];
+    const size_t base = ((size_t)r * H + h) * DK;
+    if (t < 3 * DK) {
+        const int c = (t / DK) * H * DK + h * DK + (t % DK);
+        float acc = 0.0f;
+#pragma unroll
+        for (int tap = 0; tap < TAPS; ++tap) {
+            const int at = rr + tap;
+            const float x = at < TAPS - 1 ? __bfloat162float(cs[(size_t)at * C + c])
+                                          : __bfloat162float(Ps[(size_t)(at - (TAPS - 1)) * p_stride + c]);
+            acc = acc + __bfloat162float(cw[(size_t)c * TAPS + tap]) * x;
+        }
+        const float act = bf(acc / (1.0f + expf(-acc)));
+        if (t < DK) qs[t] = act;
+        else if (t < 2 * DK) ks[t - DK] = act;
+        else v_save[base + t - 2 * DK] = __float2bfloat16_rn(act);
+    } else {
+        const int i = t - 3 * DK;
+        const float decay_rate = expf(a_log[h]);
+        const float a = __bfloat162float(A[(size_t)r * a_stride + h * DK + i]) + dt_bias[h * DK + i];
+        g_save[base + i] = expf(lower * sigmoidf_(decay_rate * a));
+        if (i == 0) b_save[r * H + h] = bf(sigmoidf_(__bfloat162float(P[(size_t)r * p_stride + b_off + h])));
+    }
+    __syncthreads();
+    if (warp < 2) {
+        const float* x = warp == 0 ? qs : ks;
+        float v4[4], ss = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { v4[i] = x[lane * 4 + i]; ss = ss + v4[i] * v4[i]; }
+        ss = warp_sum(ss);
+        float inv = 1.0f / sqrtf(ss + 1e-6f);
+        float* dst = warp == 0 ? q_out : k_save;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            float y = v4[i] * inv;
+            if (warp == 0) y = y * (1.0f / sqrtf((float)DK));
+            dst[base + lane * 4 + i] = y;
+        }
+    }
+}
+
+// step_kernel for block (segment x head, part): the segment's rows from rec[slot, parity] into rec[slot, 1 - parity].
+template <int WARPS, int TR>
+__global__ void __launch_bounds__(WARPS * 32) step_seg_kernel(
+        int H, const int* __restrict__ seg, float* __restrict__ rec, size_t slot_stride, size_t parity_stride,
+        const float* __restrict__ q_in, const float* __restrict__ k_save, const __nv_bfloat16* __restrict__ v_save,
+        const float* __restrict__ g_save, const float* __restrict__ b_save, __nv_bfloat16* __restrict__ y_out) {
+    constexpr int NT = WARPS * 32, VR = WARPS * 4;
+    const int* e = seg + (blockIdx.x / H) * SEG_COLS;
+    const int row0 = e[SEG_ROW0], rows = e[SEG_ROWS], slot = e[SEG_SLOT], parity = e[SEG_PARITY];
+    if (rows <= 0) return;
+    const float* state_in = rec + (size_t)slot * slot_stride + (size_t)parity * parity_stride;
+    float* state_out = rec + (size_t)slot * slot_stride + (size_t)(1 - parity) * parity_stride;
+    const int h = blockIdx.x % H, v0 = blockIdx.y * VR;
+    const int lw = threadIdx.x >> 5, lane = threadIdx.x & 31, warp = blockIdx.y * WARPS + lw;
+    __shared__ __align__(16) float kt[TR][DK];
+    __shared__ __align__(16) float qt[TR][DK];
+    __shared__ __align__(16) float gt[TR][DK];
+    __shared__ __align__(16) float vt[TR][VR];
+    __shared__ float bt[TR];
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r0 = 0; r0 < rows; r0 += TR) {
+        const int n = rows - r0 < TR ? rows - r0 : TR;
+        __syncthreads();
+        for (int x = threadIdx.x; x < n * DK; x += NT) {
+            const int rr = x / DK, c = x % DK;
+            const size_t base = ((size_t)(row0 + r0 + rr) * H + h) * DK + c;
+            kt[rr][c] = k_save[base];
+            qt[rr][c] = q_in[base];
+            gt[rr][c] = g_save[base];
+        }
+        for (int x = threadIdx.x; x < n * VR; x += NT) {
+            const int rr = x / VR, c = x % VR;
+            vt[rr][c] = __bfloat162float(v_save[((size_t)(row0 + r0 + rr) * H + h) * DV + v0 + c]);
+        }
+        if (threadIdx.x < n) bt[threadIdx.x] = b_save[(row0 + r0 + threadIdx.x) * H + h];
+        __syncthreads();
+        for (int rr = 0; rr < n; ++rr) {
+            const float4 k4 = reinterpret_cast<const float4*>(kt[rr])[lane];
+            const float4 q4 = reinterpret_cast<const float4*>(qt[rr])[lane];
+            const float4 g4 = reinterpret_cast<const float4*>(gt[rr])[lane];
+            const float4 v4 = reinterpret_cast<const float4*>(vt[rr])[lw];
+            float kk[4] = {k4.x, k4.y, k4.z, k4.w}, qq[4] = {q4.x, q4.y, q4.z, q4.w};
+            float gg[4] = {g4.x, g4.y, g4.z, g4.w}, vv[4] = {v4.x, v4.y, v4.z, v4.w};
+            update(s, kk, gg, vv, 0, bt[rr]);
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                float o = 0.0f;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) o = o + s[j][i] * qq[i];
+                o = warp_sum(o);
+                if (lane == 0)
+                    y_out[((size_t)(row0 + r0 + rr) * H + h) * DV + warp * 4 + j] = __float2bfloat16_rn(o);
+            }
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+// replay_layers_kernel for block (segment, layer, head): the segment's first ``keep`` rows from rec[slot, parity]
+// into rec[slot, 1 - parity]; keep == rows (the chain already left that state) or rows == 0 skips the segment.
+__global__ void __launch_bounds__(1024) replay_layers_seg_kernel(
+        int H, int layers, const int* __restrict__ seg, float* __restrict__ rec, size_t slot_stride,
+        size_t parity_stride, size_t layer_stride, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        size_t kv_stride, size_t b_stride) {
+    const int* e = seg + (blockIdx.x / (layers * H)) * SEG_COLS;
+    const int row0 = e[SEG_ROW0], rows = e[SEG_ROWS], slot = e[SEG_SLOT], parity = e[SEG_PARITY];
+    const int keep = e[SEG_KEEP];
+    if (rows <= 0 || keep < 0 || keep >= rows) return;
+    const int layer = (blockIdx.x / H) % layers, h = blockIdx.x % H;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const float* sin = rec + (size_t)slot * slot_stride + (size_t)parity * parity_stride + layer * layer_stride;
+    float* sout = rec + (size_t)slot * slot_stride + (size_t)(1 - parity) * parity_stride + layer * layer_stride;
+    const float* ks = k_save + layer * kv_stride + (size_t)row0 * H * DK;
+    const __nv_bfloat16* vsv = v_save + layer * kv_stride + (size_t)row0 * H * DV;
+    const float* gsv = g_save + layer * kv_stride + (size_t)row0 * H * DK;
+    const float* bsv = b_save + layer * b_stride + (size_t)row0 * H;
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = sin[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < keep; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(vsv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[base + lane * 4 + i]; gg[i] = gsv[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, bsv[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) sout[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+} // namespace tf_glm_kda
+
+// chain_wide's step: 4 warps (16 value rows a block), 16 rows staged at a time (kda.cu:586).
+template __global__ void tf_glm_kda::step_kernel<4, 16>(int, const float*, const float*, const float*,
+    const __nv_bfloat16*, const float*, const float*, int, __nv_bfloat16*, float*);
+// chain_wide_segments' step, the same geometry (kda.cu:613).
+template __global__ void tf_glm_kda::step_seg_kernel<4, 16>(int, const int*, float*, size_t, size_t, const float*,
+    const float*, const __nv_bfloat16*, const float*, const float*, __nv_bfloat16*);
