+
+// -- the DFlash2 draft model ---------------------------------------------------------------------------------------
+fn jint(v: std.json.Value) !usize {
+    return switch (v) {
+        .integer => |i| @intCast(i),
+        else => error.BadDraftConfig,
+    };
+}
+
+fn jfloat(v: std.json.Value) !f64 {
+    return switch (v) {
+        .float => |f| f,
+        .integer => |i| @floatFromInt(i),
+        else => error.BadDraftConfig,
+    };
+}
+
+fn jget(o: std.json.Value, key: []const u8) !std.json.Value {
+    return (if (o == .object) o.object.get(key) else null) orelse error.BadDraftConfig;
+}
+
+/// dflash2.Drafter's weights of the model in `dir` for rank `rank`: KV heads in whole query groups (halves), the MLP in
+/// units of 128 (tp.draft_parts), every matrix 4-bit with min/max ranges on the GPU. `books`: also the host codebooks.
+pub fn loadDraft(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, ops: @import("glm_source.zig").Ops, kernels: *const kern.Kernels, w: *Weights, dir: []const u8, rank: u32, books: bool) !void {
+    const cfg_path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(cfg_path);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, gpa, .limited(1 << 20));
+    defer gpa.free(text);
+    var arena_state = std.heap.ArenaAllocator.init(gpa);
+    defer arena_state.deinit();
+    const root = try std.json.parseFromSliceLeaky(std.json.Value, arena_state.allocator(), text, .{});
+    const dc = try jget(root, "dflash_config");
+    if (try jint(try jget(dc, "conv_kernel_size")) != 2) return error.OnlyTwoTapConvolutions;
+    const dm = try jint(try jget(root, "hidden_size"));
+    const hd = try jint(try jget(root, "head_dim"));
+    const heads = try jint(try jget(root, "num_attention_heads"));
+    const kv_heads = try jint(try jget(root, "num_key_value_heads"));
+    const inter = try jint(try jget(root, "intermediate_size"));
+    const n_layers = try jint(try jget(root, "num_hidden_layers"));
+    if (heads % kv_heads != 0 or kv_heads % world != 0 or inter % (128 * world) != 0) return error.DraftNotSplittable;
+    const q_n = heads / world;
+    const kv_n = kv_heads / world;
+    const m_n = inter / world;
+    var dr: Draft = .{
+        .d = dm,
+        .hd = hd,
+        .heads = q_n,
+        .kvh = kv_n,
+        .inter = m_n,
+        .gs = try jint(try jget(dc, "conv_group_size")),
+        .block = try jint(try jget(dc, "block_size")),
+        .top_k = try jint(try jget(dc, "selector_top_k")),
+        .window = try jint(try jget(root, "sliding_window")) - 1,
+        .causal = switch (try jget(root, "is_causal")) {
+            .bool => |b| b,
+            else => true,
+        },
+        .eps = @floatCast(try jfloat(try jget(root, "rms_norm_eps"))),
+        .theta = try jfloat(try jget(try jget(root, "rope_parameters"), "rope_theta")),
+        .mask_id = @intCast(try jint(try jget(dc, "mask_token_id"))),
+        .sel_rank = try jint(try jget(dc, "selector_rank")),
+        .taps = undefined,
+        .fc = undefined,
+        .hidden_norm = 0,
+        .norm = 0,
+        .hproj = 0,
+        .inv_freq = 0,
+        .layers = try gpa.alloc(DraftLayer, n_layers),
+    };
+    errdefer gpa.free(dr.layers);
+    const ids = (try jget(dc, "target_layer_ids")).array.items;
+    if (ids.len != 5) return error.DraftTapsNotFive;
+    for (ids, &dr.taps) |v, *t| t.* = @intCast(try jint(v));
+
+    var ck = try core.Checkpoint.openModelPrefix(gpa, io, dir, null);
+    defer ck.close();
+    var src = try Source.init(gpa, ops);
+    defer src.deinit();
+    try src.add(&ck);
+    var l: Loader = .{ .gpa = gpa, .ck = &ck, .src = &src, .d = d, .rank = rank, .w = w, .kernels = kernels, .dense = .q4 };
+    defer l.host.deinit(gpa);
+    const before = w.bytes;
+    var all: std.ArrayList(u8) = .empty;
+    defer all.deinit(gpa);
+
+    dr.fc = try draftQ4(&l, &all, &.{.{ .name = "fc.weight" }});
+    dr.hidden_norm = try draftVec(&l, "hidden_norm.weight");
+    dr.norm = try draftVec(&l, "norm.weight");
+    dr.hproj = try draftVec(&l, "candidate_selector.hidden_projection.weight");
+    {
+        // inv_freq = 1 / theta ** (arange(hd / 2) * 2 / hd) in fp32
+        var inv: [64]f32 = undefined;
+        if (hd / 2 > inv.len) return error.DraftHeadDim;
+        for (inv[0 .. hd / 2], 0..) |*x, i| x.* = @floatCast(1.0 / std.math.pow(f64, dr.theta, @as(f64, @floatFromInt(2 * i)) / @as(f64, @floatFromInt(hd))));
+        const ptr = try l.alloc(hd / 2 * 4);
+        try ops.upload(ptr, std.mem.sliceAsBytes(inv[0 .. hd / 2]));
+        dr.inv_freq = ptr;
+    }
+    var names = std.heap.ArenaAllocator.init(gpa);
+    defer names.deinit();
+    for (dr.layers, 0..) |*ly, i| {
+        _ = names.reset(.retain_capacity);
+        const na = names.allocator();
+        const pre = try std.fmt.allocPrint(na, "layers.{d}.", .{i});
+        const q = try std.fmt.allocPrint(na, "{s}self_attn.q_proj.weight", .{pre});
+        const k = try std.fmt.allocPrint(na, "{s}self_attn.k_proj.weight", .{pre});
+        const v = try std.fmt.allocPrint(na, "{s}self_attn.v_proj.weight", .{pre});
+        const o = try std.fmt.allocPrint(na, "{s}self_attn.o_proj.weight", .{pre});
+        const g = try std.fmt.allocPrint(na, "{s}mlp.gate_proj.weight", .{pre});
+        const u = try std.fmt.allocPrint(na, "{s}mlp.up_proj.weight", .{pre});
+        const dn = try std.fmt.allocPrint(na, "{s}mlp.down_proj.weight", .{pre});
+        const qr = rank * q_n * hd;
+        const kr = rank * kv_n * hd;
+        const mr = rank * m_n;
+        ly.qkv = try draftQ4(&l, &all, &.{ .{ .name = q, .row0 = qr, .rows = q_n * hd }, .{ .name = k, .row0 = kr, .rows = kv_n * hd }, .{ .name = v, .row0 = kr, .rows = kv_n * hd } });
+        ly.kv = try draftQ4(&l, &all, &.{ .{ .name = k, .row0 = kr, .rows = kv_n * hd }, .{ .name = v, .row0 = kr, .rows = kv_n * hd } });
+        ly.o = try draftQ4(&l, &all, &.{.{ .name = o, .col0 = qr, .cols = q_n * hd }});
+        ly.gu = try draftQ4(&l, &all, &.{ .{ .name = g, .row0 = mr, .rows = m_n }, .{ .name = u, .row0 = mr, .rows = m_n } });
+        ly.down = try draftQ4(&l, &all, &.{.{ .name = dn, .col0 = mr, .cols = m_n }});
+        ly.in_norm = try draftVec(&l, try std.fmt.allocPrint(na, "{s}input_layernorm.weight", .{pre}));
+        ly.post_norm = try draftVec(&l, try std.fmt.allocPrint(na, "{s}post_attention_layernorm.weight", .{pre}));
+        ly.q_norm = try draftVec(&l, try std.fmt.allocPrint(na, "{s}self_attn.q_norm.weight", .{pre}));
+        ly.k_norm = try draftVec(&l, try std.fmt.allocPrint(na, "{s}self_attn.k_norm.weight", .{pre}));
+        ly.a_base = try draftVec(&l, try std.fmt.allocPrint(na, "{s}attention_conv.base_kernel", .{pre}));
+        ly.m_base = try draftVec(&l, try std.fmt.allocPrint(na, "{s}mlp_conv.base_kernel", .{pre}));
+        ly.a_kp = try draftQ4(&l, &all, &.{.{ .name = try std.fmt.allocPrint(na, "{s}attention_conv.kernel_projection.weight", .{pre}) }});
+        ly.m_kp = try draftQ4(&l, &all, &.{.{ .name = try std.fmt.allocPrint(na, "{s}mlp_conv.kernel_projection.weight", .{pre}) }});
+    }
+    if (books) {
+        dr.pred = try draftBook(&l, "candidate_selector.predecessor_codebook", dr.sel_rank);
+        errdefer gpa.free(dr.pred);
+        dr.succ = try draftBook(&l, "candidate_selector.successor_codebook", dr.sel_rank);
+    }
+    try src.flush();
+    try ops.s.synchronize();
+    dr.bytes = w.bytes - before;
+    w.draft = dr;
+}
+
+/// One slice of a draft tensor: rows row0 .. row0 + rows (all when rows is 0) or columns col0 .. col0 + cols.
+const Piece = struct { name: []const u8, row0: usize = 0, rows: usize = 0, col0: usize = 0, cols: usize = 0 };
+
+/// (members of Loader, defined here for the draft model)
+fn draftBytes(l: *Loader, p: Piece, out: *std.ArrayList(u8)) !struct { rows: usize, cols: usize } {
+    const t = try l.ck.get(p.name);
+    if (t.dtype != .bf16 or t.rank != 2) {
+        std.log.err("{s}: {t} rank {d}, expected a bf16 matrix", .{ p.name, t.dtype, t.rank });
+        return error.UnexpectedTensor;
+    }
+    const n = t.shape[0];
+    const k = t.shape[1];
+    if (p.cols == 0) {
+        const rows = if (p.rows == 0) n else p.rows;
+        if (p.row0 + rows > n) return error.DraftSliceOutOfRange;
+        const at = out.items.len;
+        try out.resize(l.gpa, at + rows * k * 2);
+        try l.src.read(out.items[at..], t.bytes[p.row0 * k * 2 ..][0 .. rows * k * 2]);
+        return .{ .rows = rows, .cols = k };
+    }
+    if (p.col0 + p.cols > k) return error.DraftSliceOutOfRange;
+    try l.host.resize(l.gpa, t.bytes.len);
+    try l.src.read(l.host.items, t.bytes);
+    const at = out.items.len;
+    try out.resize(l.gpa, at + n * p.cols * 2);
+    for (0..n) |r| @memcpy(out.items[at + r * p.cols * 2 ..][0 .. p.cols * 2], l.host.items[(r * k + p.col0) * 2 ..][0 .. p.cols * 2]);
+    return .{ .rows = n, .cols = p.cols };
+}
+
+/// The pieces' rows stacked, uploaded and quantized to 4 bits (min/max ranges), as dflash2's quantize4(gpu(cat(...))).
+fn draftQ4(l: *Loader, all: *std.ArrayList(u8), pieces: []const Piece) !kern.Q4 {
+    all.clearRetainingCapacity();
+    var rows: usize = 0;
+    var cols: usize = 0;
+    for (pieces) |p| {
+        const sh = try draftBytes(l, p, all);
+        if (cols != 0 and sh.cols != cols) return error.StackWidth;
+        cols = sh.cols;
+        rows += sh.rows;
+    }
+    var raw = try cuda.DeviceBuffer.alloc(l.d, all.items.len);
+    defer raw.free();
+    try l.src.ops.upload(raw.ptr, all.items);
+    return l.quantize4Draft(raw.ptr, rows, cols);
+}
+
+/// A whole tensor (bf16 as stored) on the device.
+fn draftVec(l: *Loader, name: []const u8) !u64 {
+    const t = try l.ck.get(name);
+    if (t.dtype != .bf16) return error.UnexpectedTensor;
+    l.host.clearRetainingCapacity();
+    try l.host.resize(l.gpa, t.bytes.len);
+    try l.src.read(l.host.items, t.bytes);
+    const ptr = try l.alloc(t.bytes.len);
+    try l.src.ops.upload(ptr, l.host.items);
+    return ptr;
+}
+
+/// A codebook [vocab, width] as host fp32.
+fn draftBook(l: *Loader, name: []const u8, width: usize) ![]f32 {
+    const t = try l.ck.get(name);
+    if (t.rank != 2 or t.shape[1] != width) return error.UnexpectedTensor;
+    const n = t.numel();
+    const out = try l.gpa.alloc(f32, n);
+    errdefer l.gpa.free(out);
+    switch (t.dtype) {
+        .f32 => try l.src.read(std.mem.sliceAsBytes(out), t.bytes),
+        .bf16 => {
+            const raw = try l.gpa.alloc(u16, n);
+            defer l.gpa.free(raw);
+            try l.src.read(std.mem.sliceAsBytes(raw), t.bytes);
+            for (raw, out) |b, *x| x.* = @bitCast(@as(u32, b) << 16);
+        },
+        else => return error.UnexpectedTensor,
+    }
+    return out;
+}
diff --git a/zig/src/families/glm/cuda/roce_dl.c b/zig/src/families/glm/cuda/roce_dl.c
new file mode 100644
index 0000000..1809a20
--- /dev/null
+++ b/zig/src/families/glm/cuda/roce_dl.c
@@ -0,0 +1,63 @@
+// libibverbs by dlopen for roce_proxy.c: the 17 entry points it calls, each defined here and resolved from libibverbs.so.1 at
+// its first call, so a binary that never starts the RoCE transport needs no rdma-core on the machine. `roce_dl_open` says
+// whether the library loads (call it before roce_create; without it a missing library aborts at the first verbs call).
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <infiniband/verbs.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static void *lib;
+
+int roce_dl_open(void) {
+    if (lib == NULL) lib = dlopen("libibverbs.so.1", RTLD_NOW | RTLD_LOCAL);
+    return lib != NULL;
+}
+
+static void *sym(const char *name) {
+    void *p = roce_dl_open() ? dlsym(lib, name) : NULL;
+    if (p == NULL) {
+        fprintf(stderr, "libibverbs: %s unavailable\n", name);
+        abort();
+    }
+    return p;
+}
+
+#undef ibv_reg_mr
+#undef ibv_query_port
+#undef ibv_create_qp
+#undef ibv_create_cq
+#undef ibv_modify_qp
+#undef ibv_query_gid
+
+#define DEF(ret, name, params, args)         \
+    ret name params {                        \
+        static ret(*f) params;               \
+        if (f == NULL) f = sym(#name);       \
+        return f args;                       \
+    }
+#define DEFV(name, params, args)             \
+    void name params {                       \
+        static void (*f) params;             \
+        if (f == NULL) f = sym(#name);       \
+        f args;                              \
+    }
+
+DEF(struct ibv_device **, ibv_get_device_list, (int *num), (num))
+DEFV(ibv_free_device_list, (struct ibv_device **list), (list))
+DEF(const char *, ibv_get_device_name, (struct ibv_device *dev), (dev))
+DEF(struct ibv_context *, ibv_open_device, (struct ibv_device *dev), (dev))
+DEF(int, ibv_close_device, (struct ibv_context *ctx), (ctx))
+DEF(int, ibv_query_port, (struct ibv_context *ctx, uint8_t port, struct _compat_ibv_port_attr *attr), (ctx, port, attr))
+DEF(int, ibv_query_gid, (struct ibv_context *ctx, uint8_t port, int index, union ibv_gid *gid), (ctx, port, index, gid))
+DEF(struct ibv_pd *, ibv_alloc_pd, (struct ibv_context *ctx), (ctx))
+DEF(int, ibv_dealloc_pd, (struct ibv_pd *pd), (pd))
+DEF(struct ibv_mr *, ibv_reg_mr, (struct ibv_pd *pd, void *addr, size_t length, int access), (pd, addr, length, access))
+DEF(int, ibv_dereg_mr, (struct ibv_mr *mr), (mr))
+DEF(struct ibv_cq *, ibv_create_cq, (struct ibv_context *ctx, int cqe, void *user, struct ibv_comp_channel *channel, int vector),
+    (ctx, cqe, user, channel, vector))
+DEF(int, ibv_destroy_cq, (struct ibv_cq *cq), (cq))
+DEF(struct ibv_qp *, ibv_create_qp, (struct ibv_pd *pd, struct ibv_qp_init_attr *attr), (pd, attr))
+DEF(int, ibv_modify_qp, (struct ibv_qp *qp, struct ibv_qp_attr *attr, int mask), (qp, attr, mask))
+DEF(int, ibv_destroy_qp, (struct ibv_qp *qp), (qp))
+DEF(const char *, ibv_wc_status_str, (enum ibv_wc_status status), (status))
diff --git a/zig/src/families/glm/cuda/roce_proxy.c b/zig/src/families/glm/cuda/roce_proxy.c
new file mode 100644
index 0000000..d8ba88c
--- /dev/null
+++ b/zig/src/families/glm/cuda/roce_proxy.c
@@ -0,0 +1,669 @@
+// Adapted from b12x (https://github.com/local-inference-lab/b12x), b12x/comm/roce/_roce_proxy.c at commit
+// 8a99d639410e39d5f39cb4037675331beceea1d4: "RoCEnante", Copyright the b12x contributors, Apache License 2.0
+// (http://www.apache.org/licenses/LICENSE-2.0). Used by tensorfold/cuda/roce.py. Changes from b12x's file (TensorFold,
+// 2026-10-01, ABI 5): up to 4 HCAs, a GID index per HCA, and routes: each peer's stripes go over chosen (local HCA,
+// peer HCA) pairs (roce_set_route; default HCA h to the peer's HCA h, every HCA), so ranks cabled to each other
+// directly (a triangle of Sparks: one /24 and two rails a pair) reach each peer over its own rails only. Flags are
+// indexed by stripe (``n_flag`` stripes a peer, the same for every peer).
+
+// RDMA proxy for the b12x RoCE one-shot all-reduce.
+//
+// One rank owns one pinned host region laid out as:
+//
+//   recv[src][slot]  (world * SLOTS * slot_bytes)  filled by peers' RDMA writes
+//   flag[src][slot][hca] sequence number written on each HCA after that HCA's
+//                         payload stripe
+//   send[slot]       (SLOTS * slot_bytes)          staged by the local GPU kernel
+//   ctrl             (FLAG_STRIDE)                 {u32 seq, u32 nbytes, u32 error,
+//                                                   u32 missing_peer} doorbell; the
+//                                                  last two are set by the kernel
+//                                                  when a wait times out
+//
+// The GPU kernel stages its input into send[seq & 1], publishes nbytes and seq
+// in ctrl, then spins on flag[peer][seq & 1][hca] for every peer and HCA.  The
+// proxy thread
+// below spins on ctrl.seq and, for every peer, stripes the payload across every
+// HCA.  Each stripe is followed by its own 4-byte seq write on the same reliable
+// QP, so its flag cannot become visible before its payload.  The GPU waits for
+// every stripe flag before consuming the receive slot.  Nothing on the receive
+// path involves the host.
+//
+// This file is compiled by b12x.comm.roce._proxy at first use with the host
+// gcc and libibverbs; it must stay plain C with no CUDA dependency.
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <infiniband/verbs.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define ROCE_MAX_PEERS 16
+#define ROCE_MAX_HCAS 4
+#define ROCE_SLOTS 2
+#define ROCE_FLAG_STRIDE 128
+#define ROCE_PORT 1
+#define ROCE_SEND_DEPTH 256
+#define ROCE_ABI_VERSION 5
+// Model graphs leave sub-millisecond gaps between collectives.  Keep the
+// proxy hot across those gaps; sleeping there adds one scheduler wakeup to
+// every collective on the graph's critical path.
+#define ROCE_IDLE_SPINS 20000000
+
+typedef struct {
+    uint64_t region_addr;
+    uint32_t rkey[ROCE_MAX_HCAS];
+    uint16_t lid[ROCE_MAX_HCAS];
+    uint8_t gid[ROCE_MAX_HCAS][16];
+    uint32_t mtu[ROCE_MAX_HCAS];
+    uint32_t qp_num[ROCE_MAX_HCAS][ROCE_MAX_PEERS];
+} roce_blob_t;
+
+typedef struct {
+    struct ibv_context *ctx;
+    struct ibv_pd *pd;
+    struct ibv_mr *mr;
+    struct ibv_cq *cq;
+    struct ibv_qp *qp[ROCE_MAX_PEERS];
+    uint32_t outstanding[ROCE_MAX_PEERS];
+    uint64_t writes_completed;
+    uint64_t bytes_posted;
+    union ibv_gid gid;
+    uint16_t lid;
+    enum ibv_mtu mtu;
+} roce_hca_t;
+
+typedef struct {
+    int world;
+    int rank;
+    int n_hca;
+    int gid_index[ROCE_MAX_HCAS];
+    int traffic_class;
+    // routes: stripe s to peer p leaves on local HCA stripe_hca[p][s] for the peer's HCA stripe_remote[p][s]
+    int n_stripe[ROCE_MAX_PEERS];
+    int stripe_hca[ROCE_MAX_PEERS][ROCE_MAX_HCAS];
+    int stripe_remote[ROCE_MAX_PEERS][ROCE_MAX_HCAS];
+    int n_flag;                      // stripes (flags) a peer, the same for every peer and on every rank
+    roce_hca_t hca[ROCE_MAX_HCAS];
+    uint8_t *region;
+    size_t region_bytes;
+    size_t slot_bytes;
+    size_t recv_off;
+    size_t flag_off;
+    size_t send_off;
+    size_t ctrl_off;
+    int started;
+    uint64_t peer_addr[ROCE_MAX_PEERS];
+    uint32_t peer_rkey[ROCE_MAX_HCAS][ROCE_MAX_PEERS];   // by stripe
+    pthread_t thread;
+    atomic_int running;
+    atomic_int failed;
+    uint32_t last_seq;
+    uint64_t ops_posted;
+    uint64_t writes_completed;
+    char err[512];
+} roce_ctx_t;
+
+void roce_destroy(roce_ctx_t *c);
+
+static void set_err(roce_ctx_t *c, const char *what, int e) {
+    snprintf(c->err, sizeof(c->err), "%s: %s", what, e ? strerror(e) : "failed");
+}
+
+int roce_abi_version(void) { return ROCE_ABI_VERSION; }
+
+int roce_layout(int world, uint64_t slot_bytes, uint64_t *out) {
+    // out = {recv_off, flag_off, send_off, ctrl_off, total_bytes, flag_stride, slots}
+    if (world < 2 || world > ROCE_MAX_PEERS || slot_bytes == 0 || (slot_bytes % 4096) != 0) {
+        return -1;
+    }
+    // Reject a layout whose arithmetic would wrap; the caller sizes slots from
+    // configuration, so a wrapped region must fail here rather than at the NIC.
+    uint64_t recv_bytes, flag_bytes, send_bytes, send_off, ctrl_off, total;
+    if (slot_bytes > ((uint64_t)1 << 40) ||
+        __builtin_mul_overflow((uint64_t)world * ROCE_SLOTS, slot_bytes, &recv_bytes) ||
+        __builtin_mul_overflow(
+            (uint64_t)world * ROCE_SLOTS * ROCE_MAX_HCAS,
+            (uint64_t)ROCE_FLAG_STRIDE,
+            &flag_bytes) ||
+        __builtin_mul_overflow((uint64_t)ROCE_SLOTS, slot_bytes, &send_bytes) ||
+        __builtin_add_overflow(recv_bytes, flag_bytes, &send_off) ||
+        __builtin_add_overflow(send_off, send_bytes, &ctrl_off) ||
+        __builtin_add_overflow(ctrl_off, (uint64_t)ROCE_FLAG_STRIDE, &total)) {
+        return -1;
+    }
+    uint64_t recv_off = 0;
+    uint64_t flag_off = recv_off + recv_bytes;
+    out[0] = recv_off;
+    out[1] = flag_off;
+    out[2] = send_off;
+    out[3] = ctrl_off;
+    out[4] = total;
+    out[5] = ROCE_FLAG_STRIDE;
+    out[6] = ROCE_SLOTS;
+    return 0;
+}
+
+uint64_t roce_blob_bytes(void) { return sizeof(roce_blob_t); }
+
+static int open_hca(roce_ctx_t *c, int h, const char *name) {
+    int num = 0;
+    struct ibv_device **list = ibv_get_device_list(&num);
+    if (list == NULL) {
+        set_err(c, "ibv_get_device_list", errno);
+        return -1;
+    }
+    struct ibv_device *dev = NULL;
+    for (int i = 0; i < num; i++) {
+        if (strcmp(ibv_get_device_name(list[i]), name) == 0) {
+            dev = list[i];
+            break;
+        }
+    }
+    if (dev == NULL) {
+        ibv_free_device_list(list);
+        snprintf(c->err, sizeof(c->err), "RDMA device %s not found", name);
+        return -1;
+    }
+    roce_hca_t *hca = &c->hca[h];
+    hca->ctx = ibv_open_device(dev);
+    ibv_free_device_list(list);
+    if (hca->ctx == NULL) {
+        set_err(c, "ibv_open_device", errno);
+        return -1;
+    }
+    struct ibv_port_attr port;
+    if (ibv_query_port(hca->ctx, ROCE_PORT, &port) != 0) {
+        set_err(c, "ibv_query_port", errno);
+        return -1;
+    }
+    if (port.state != IBV_PORT_ACTIVE) {
+        snprintf(c->err, sizeof(c->err), "RDMA device %s port %d is not active", name, ROCE_PORT);
+        return -1;
+    }
+    hca->lid = port.lid;
+    hca->mtu = port.active_mtu;
+    if (ibv_query_gid(hca->ctx, ROCE_PORT, c->gid_index[h], &hca->gid) != 0) {
+        set_err(c, "ibv_query_gid", errno);
+        return -1;
+    }
+    hca->pd = ibv_alloc_pd(hca->ctx);
+    if (hca->pd == NULL) {
+        set_err(c, "ibv_alloc_pd", errno);
+        return -1;
+    }
+    hca->mr = ibv_reg_mr(hca->pd, c->region, c->region_bytes,
+                         IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE);
+    if (hca->mr == NULL) {
+        set_err(c, "ibv_reg_mr(pinned region)", errno);
+        return -1;
+    }
+    hca->cq = ibv_create_cq(hca->ctx, ROCE_SEND_DEPTH * ROCE_MAX_PEERS, NULL, NULL, 0);
+    if (hca->cq == NULL) {
+        set_err(c, "ibv_create_cq", errno);
+        return -1;
+    }
+    for (int p = 0; p < c->world; p++) {
+        if (p == c->rank) {
+            continue;
+        }
+        struct ibv_qp_init_attr attr;
+        memset(&attr, 0, sizeof(attr));
+        attr.send_cq = hca->cq;
+        attr.recv_cq = hca->cq;
+        attr.qp_type = IBV_QPT_RC;
+        attr.cap.max_send_wr = ROCE_SEND_DEPTH;
+        attr.cap.max_recv_wr = 1;
+        attr.cap.max_send_sge = 1;
+        attr.cap.max_recv_sge = 1;
+        attr.cap.max_inline_data = 16;
+        hca->qp[p] = ibv_create_qp(hca->pd, &attr);
+        if (hca->qp[p] == NULL) {
+            set_err(c, "ibv_create_qp", errno);
+            return -1;
+        }
+        struct ibv_qp_attr init;
+        memset(&init, 0, sizeof(init));
+        init.qp_state = IBV_QPS_INIT;
+        init.pkey_index = 0;
+        init.port_num = ROCE_PORT;
+        init.qp_access_flags = IBV_ACCESS_REMOTE_WRITE;
+        int rc = ibv_modify_qp(hca->qp[p], &init,
+                               IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS);
+        if (rc != 0) {
+            set_err(c, "ibv_modify_qp(INIT)", rc);
+            return -1;
+        }
+    }
+    return 0;
+}
+
+roce_ctx_t *roce_create(int world, int rank, const char *const *hca_names, int n_hca,
+                        const int *gid_index, int traffic_class, void *region, uint64_t region_bytes,
+                        uint64_t slot_bytes, char *err, uint64_t err_len) {
+    uint64_t layout[7];
+    if (roce_layout(world, slot_bytes, layout) != 0 || layout[4] > region_bytes ||
+        rank < 0 || rank >= world || n_hca < 1 || n_hca > ROCE_MAX_HCAS ||
+        traffic_class < 0 || traffic_class > 255) {
+        snprintf(err, err_len, "invalid roce runtime geometry");
+        return NULL;
+    }
+    roce_ctx_t *c = calloc(1, sizeof(*c));
+    if (c == NULL) {
+        snprintf(err, err_len, "out of memory");
+        return NULL;
+    }
+    c->world = world;
+    c->rank = rank;
+    c->n_hca = n_hca;
+    for (int h = 0; h < n_hca; h++) {
+        c->gid_index[h] = gid_index[h];
+    }
+    for (int p = 0; p < world; p++) {           // default routes: HCA h to the peer's HCA h, every HCA
+        c->n_stripe[p] = p == rank ? 0 : n_hca;
+        for (int h = 0; h < n_hca; h++) {
+            c->stripe_hca[p][h] = h;
+            c->stripe_remote[p][h] = h;
+        }
+    }
+    c->n_flag = n_hca;
+    c->traffic_class = traffic_class;
+    c->region = region;
+    c->region_bytes = region_bytes;
+    c->slot_bytes = slot_bytes;
+    c->recv_off = layout[0];
+    c->flag_off = layout[1];
+    c->send_off = layout[2];
+    c->ctrl_off = layout[3];
+    for (int h = 0; h < n_hca; h++) {
+        if (open_hca(c, h, hca_names[h]) != 0) {
+            snprintf(err, err_len, "%s", c->err);
+            roce_destroy(c);
+            return NULL;
+        }
+    }
+    return c;
+}
+
+int roce_set_routes(roce_ctx_t *c, int peer, int n, const int *local, const int *remote, int n_flag) {
+    // before roce_connect: peer's stripes (n of them) over (local[s], remote[s]); n_flag: the stripes every peer has
+    if (c->started || peer < 0 || peer >= c->world || peer == c->rank || n < 1 || n > ROCE_MAX_HCAS ||
+        n != n_flag || n_flag > ROCE_MAX_HCAS) {
+        snprintf(c->err, sizeof(c->err), "invalid RoCE route to rank %d (%d stripes, %d a peer)", peer, n, n_flag);
+        return -1;
+    }
+    for (int s = 0; s < n; s++) {
+        if (local[s] < 0 || local[s] >= c->n_hca || remote[s] < 0 || remote[s] >= ROCE_MAX_HCAS) {
+            snprintf(c->err, sizeof(c->err), "invalid RoCE route to rank %d: stripe %d", peer, s);
+            return -1;
+        }
+        c->stripe_hca[peer][s] = local[s];
+        c->stripe_remote[peer][s] = remote[s];
+    }
+    c->n_stripe[peer] = n;
+    c->n_flag = n_flag;
+    return 0;
+}
+
+int roce_local_blob(roce_ctx_t *c, void *out, uint64_t out_len) {
+    if (out_len < sizeof(roce_blob_t)) {
+        return -1;
+    }
+    roce_blob_t blob;
+    memset(&blob, 0, sizeof(blob));
+    blob.region_addr = (uint64_t)(uintptr_t)c->region;
+    for (int h = 0; h < c->n_hca; h++) {
+        blob.rkey[h] = c->hca[h].mr->rkey;
+        blob.lid[h] = c->hca[h].lid;
+        blob.mtu[h] = (uint32_t)c->hca[h].mtu;
+        memcpy(blob.gid[h], c->hca[h].gid.raw, 16);
+        for (int p = 0; p < c->world; p++) {
+            blob.qp_num[h][p] = (p == c->rank) ? 0 : c->hca[h].qp[p]->qp_num;
+        }
+    }
+    memcpy(out, &blob, sizeof(blob));
+    return 0;
+}
+
+static int connect_qp(roce_ctx_t *c, int h, int p, const roce_blob_t *peer, int rh) {
+    // local HCA h's QP for peer p <-> the peer's HCA rh's QP for this rank
+    roce_hca_t *hca = &c->hca[h];
+    struct ibv_qp_attr rtr;
+    memset(&rtr, 0, sizeof(rtr));
+    rtr.qp_state = IBV_QPS_RTR;
+    rtr.path_mtu = (enum ibv_mtu)(peer->mtu[rh] < (uint32_t)hca->mtu ? peer->mtu[rh] : (uint32_t)hca->mtu);
+    rtr.dest_qp_num = peer->qp_num[rh][c->rank];
+    rtr.rq_psn = 0;
+    rtr.max_dest_rd_atomic = 1;
+    rtr.min_rnr_timer = 12;
+    rtr.ah_attr.is_global = 1;
+    rtr.ah_attr.dlid = peer->lid[rh];
+    rtr.ah_attr.sl = 0;
+    rtr.ah_attr.src_path_bits = 0;
+    rtr.ah_attr.port_num = ROCE_PORT;
+    memcpy(rtr.ah_attr.grh.dgid.raw, peer->gid[rh], 16);
+    rtr.ah_attr.grh.sgid_index = (uint8_t)c->gid_index[h];
+    rtr.ah_attr.grh.hop_limit = 64;
+    rtr.ah_attr.grh.traffic_class = (uint8_t)c->traffic_class;
+    rtr.ah_attr.grh.flow_label = 0;
+    int rc = ibv_modify_qp(hca->qp[p], &rtr,
+                           IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN |
+                               IBV_QP_RQ_PSN | IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER);
+    if (rc != 0) {
+        set_err(c, "ibv_modify_qp(RTR)", rc);
+        return -1;
+    }
+    struct ibv_qp_attr rts;
+    memset(&rts, 0, sizeof(rts));
+    rts.qp_state = IBV_QPS_RTS;
+    rts.timeout = 14;
+    rts.retry_cnt = 7;
+    rts.rnr_retry = 7;
+    rts.sq_psn = 0;
+    rts.max_rd_atomic = 1;
+    rc = ibv_modify_qp(hca->qp[p], &rts,
+                       IBV_QP_STATE | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY |
+                           IBV_QP_SQ_PSN | IBV_QP_MAX_QP_RD_ATOMIC);
+    if (rc != 0) {
+        set_err(c, "ibv_modify_qp(RTS)", rc);
+        return -1;
+    }
+    return 0;
+}
+
+int roce_connect(roce_ctx_t *c, const void *blobs, uint64_t blobs_len) {
+    if (blobs_len < sizeof(roce_blob_t) * (uint64_t)c->world) {
+        snprintf(c->err, sizeof(c->err), "peer blob buffer too small");
+        return -1;
+    }
+    const roce_blob_t *all = (const roce_blob_t *)blobs;
+    for (int p = 0; p < c->world; p++) {
+        if (p == c->rank) {
+            continue;
+        }
+        c->peer_addr[p] = all[p].region_addr;
+        if (c->n_stripe[p] != c->n_flag) {
+            snprintf(c->err, sizeof(c->err), "rank %d has %d stripes, every peer needs %d", p, c->n_stripe[p],
+                     c->n_flag);
+            return -1;
+        }
+        for (int s = 0; s < c->n_stripe[p]; s++) {
+            const int h = c->stripe_hca[p][s], rh = c->stripe_remote[p][s];
+            c->peer_rkey[s][p] = all[p].rkey[rh];
+            if (connect_qp(c, h, p, &all[p], rh) != 0) {
+                return -1;
+            }
+        }
+    }
+    return 0;
+}
+
+static int drain_cq(roce_ctx_t *c, int h) {
+    struct ibv_wc wc[32];
+    int n = ibv_poll_cq(c->hca[h].cq, 32, wc);
+    if (n < 0) {
+        set_err(c, "ibv_poll_cq", errno);
+        return -1;
+    }
+    for (int i = 0; i < n; i++) {
+        if (wc[i].status != IBV_WC_SUCCESS) {
+            snprintf(c->err, sizeof(c->err),
+                     "RDMA write to rank %u failed: %s (vendor_err 0x%x, seq %u)",
+                     (unsigned)wc[i].wr_id, ibv_wc_status_str(wc[i].status),
+                     wc[i].vendor_err, c->last_seq);
+            return -1;
+        }
+        c->hca[h].outstanding[wc[i].wr_id] -= 1;
+        c->hca[h].writes_completed += 1;
+        c->writes_completed += 1;
+    }
+    return 0;
+}
+
+static int post_op(roce_ctx_t *c, uint32_t seq, uint32_t nbytes) {
+    if (nbytes == 0 || nbytes % 16 != 0) {
+        snprintf(c->err, sizeof(c->err),
+                 "RoCE payload size must be a positive multiple of 16 bytes, got %u",
+                 nbytes);
+        return -1;
+    }
+    uint32_t slot = seq & 1u;
+    uint8_t *send = c->region + c->send_off + (size_t)slot * c->slot_bytes;
+    uint32_t seq_copy = seq;
+    uint32_t total_packs = nbytes / 16;
+    for (int p = 0; p < c->world; p++) {
+        if (p == c->rank) {
+            continue;
+        }
+        uint32_t pack_offset = 0;
+        const int n_stripe = c->n_stripe[p];
+        for (int s = 0; s < n_stripe; s++) {
+            const int h = c->stripe_hca[p][s];
+            roce_hca_t *hca = &c->hca[h];
+            // Two work requests per stripe; keep the queue at most a quarter
+            // full so a provider that needs extra entries can never fail a post.
+            while (hca->outstanding[p] >= ROCE_SEND_DEPTH / 4) {
+                if (drain_cq(c, h) != 0) {
+                    return -1;
+                }
+                // A peer that stopped acknowledging keeps the QP retrying for
+                // a long time; honour a stop request instead of blocking
+                // roce_stop (and so teardown) behind it.
+                if (!atomic_load_explicit(&c->running, memory_order_relaxed)) {
+                    snprintf(c->err, sizeof(c->err),
+                             "RoCE proxy stopped with %u writes outstanding to rank %d",
+                             hca->outstanding[p], p);
+                    return -1;
+                }
+            }
+            uint32_t stripe_packs = total_packs / (uint32_t)n_stripe;
+            if ((uint32_t)s < total_packs % (uint32_t)n_stripe) {
+                stripe_packs += 1;
+            }
+            uint32_t stripe_bytes = stripe_packs * 16;
+            uint64_t byte_offset = (uint64_t)pack_offset * 16;
+            uint64_t remote = c->peer_addr[p];
+            struct ibv_sge flag_sge = {
+                .addr = (uint64_t)(uintptr_t)&seq_copy,
+                .length = 4,
+                .lkey = 0,
+            };
+            struct ibv_send_wr flag_wr;
+            memset(&flag_wr, 0, sizeof(flag_wr));
+            flag_wr.wr_id = (uint64_t)p;
+            flag_wr.sg_list = &flag_sge;
+            flag_wr.num_sge = 1;
+            flag_wr.opcode = IBV_WR_RDMA_WRITE;
+            flag_wr.send_flags = IBV_SEND_SIGNALED | IBV_SEND_INLINE;
+            flag_wr.wr.rdma.remote_addr =
+                remote + c->flag_off +
+                (((uint64_t)c->rank * ROCE_SLOTS + slot) * (uint64_t)c->n_flag +
+                 (uint64_t)s) * ROCE_FLAG_STRIDE;
+            flag_wr.wr.rdma.rkey = c->peer_rkey[s][p];
+
+            struct ibv_send_wr data_wr;
+            struct ibv_sge data_sge;
+            struct ibv_send_wr *first_wr = &flag_wr;
+            if (stripe_bytes != 0) {
+                data_sge = (struct ibv_sge){
+                    .addr = (uint64_t)(uintptr_t)(send + byte_offset),
+                    .length = stripe_bytes,
+                    .lkey = hca->mr->lkey,
+                };
+                memset(&data_wr, 0, sizeof(data_wr));
+                data_wr.wr_id = (uint64_t)p;
+                data_wr.next = &flag_wr;
+                data_wr.sg_list = &data_sge;
+                data_wr.num_sge = 1;
+                data_wr.opcode = IBV_WR_RDMA_WRITE;
+                data_wr.wr.rdma.remote_addr =
+                    remote + c->recv_off +
+                    ((uint64_t)c->rank * ROCE_SLOTS + slot) * c->slot_bytes +
+                    byte_offset;
+                data_wr.wr.rdma.rkey = c->peer_rkey[s][p];
+                first_wr = &data_wr;
+            }
+            struct ibv_send_wr *bad = NULL;
+            int rc = ibv_post_send(hca->qp[p], first_wr, &bad);
+            if (rc != 0) {
+                set_err(c, "ibv_post_send", rc);
+                return -1;
+            }
+            hca->outstanding[p] += 1;
+            hca->bytes_posted += stripe_bytes;
+            pack_offset += stripe_packs;
+        }
+    }
+    c->ops_posted += 1;
+    for (int h = 0; h < c->n_hca; h++) {
+        if (drain_cq(c, h) != 0) {
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static void *proxy_main(void *arg) {
+    roce_ctx_t *c = (roce_ctx_t *)arg;
+    volatile uint32_t *ctrl = (volatile uint32_t *)(c->region + c->ctrl_off);
+    // Spin while ops are flowing.  After ROCE_IDLE_SPINS polls without a
+    // doorbell, request a short nanosleep between polls (the OS decides the
+    // actual delay) so an idle runtime does not hold a core next to the
+    // serving process.  The missed-doorbell catch-up below keeps the protocol
+    // correct however long the thread is away.
+    uint64_t idle = 0;
+    const struct timespec nap = {0, 20000};
+    while (atomic_load_explicit(&c->running, memory_order_relaxed)) {
+        uint32_t seq = __atomic_load_n(&ctrl[0], __ATOMIC_ACQUIRE);
+        if (seq == c->last_seq) {
+            idle++;
+            if (idle % 64 == 0) {
+                for (int h = 0; h < c->n_hca; h++) {
+                    if (drain_cq(c, h) != 0) {
+                        atomic_store(&c->failed, 1);
+                        return NULL;
+                    }
+                }
+            }
+            if (idle >= ROCE_IDLE_SPINS) {
+                nanosleep(&nap, NULL);
+            }
+            continue;
+        }
+        idle = 0;
+        // The doorbell holds only the newest sequence.  Our kernel for op N
+        // completes on the peers' payloads alone, so op N+1 can ring before
+        // this thread has seen op N (it slept, or the scheduler moved it).
+        // Peers cannot get further than one op ahead of us, so at most
+        // ROCE_SLOTS doorbells are pending and every send slot is intact:
+        // post each missed sequence in order using its per-slot byte count.
+        uint32_t pending = seq - c->last_seq;
+        if (pending > ROCE_SLOTS) {
+            snprintf(c->err, sizeof(c->err),
+                     "doorbell skipped %u ops (last %u, now %u)", pending, c->last_seq, seq);
+            atomic_store(&c->failed, 1);
+            return NULL;
+        }
+        for (uint32_t s = c->last_seq + 1; pending > 0; s++, pending--) {
+            uint32_t nbytes = ctrl[4 + (s & 1u)];
+            if (post_op(c, s, nbytes) != 0) {
+                atomic_store(&c->failed, 1);
+                return NULL;
+            }
+            c->last_seq = s;
+        }
+    }
+    return NULL;
+}
+
+int roce_start(roce_ctx_t *c) {
+    if (atomic_load(&c->running)) {
+        return 0;
+    }
+    if (!c->started) {
+        // A restart continues from the last posted sequence so ops that rang
+        // the doorbell while the thread was stopped are still posted.
+        volatile uint32_t *ctrl = (volatile uint32_t *)(c->region + c->ctrl_off);
+        c->last_seq = ctrl[0];
+        c->started = 1;
+    }
+    atomic_store(&c->failed, 0);
+    atomic_store(&c->running, 1);
+    int rc = pthread_create(&c->thread, NULL, proxy_main, c);
+    if (rc != 0) {
+        atomic_store(&c->running, 0);
+        set_err(c, "pthread_create", rc);
+        return -1;
+    }
+    return 0;
+}
+
+void roce_stop(roce_ctx_t *c) {
+    if (atomic_exchange(&c->running, 0)) {
+        pthread_join(c->thread, NULL);
+    }
+}
+
+int roce_failed(roce_ctx_t *c) { return atomic_load(&c->failed); }
+
+const char *roce_error(roce_ctx_t *c) { return c->err; }
+
+uint64_t roce_stat(roce_ctx_t *c, int which) {
+    switch (which) {
+    case 0:
+        return c->ops_posted;
+    case 1:
+        return c->writes_completed;
+    case 2:
+        return c->last_seq;
+    default:
+        return 0;
+    }
+}
+
+uint64_t roce_hca_stat(roce_ctx_t *c, int hca, int which) {
+    if (hca < 0 || hca >= c->n_hca) {
+        return -1;
+    }
+    switch (which) {
+    case 0:
+        return c->hca[hca].writes_completed;
+    case 1:
+        return c->hca[hca].bytes_posted;
+    default:
+        return 0;
+    }
+}
+
+void roce_destroy(roce_ctx_t *c) {
+    if (c == NULL) {
+        return;
+    }
+    roce_stop(c);
+    for (int h = 0; h < ROCE_MAX_HCAS; h++) {
+        roce_hca_t *hca = &c->hca[h];
+        for (int p = 0; p < ROCE_MAX_PEERS; p++) {
+            if (hca->qp[p] != NULL) {
+                ibv_destroy_qp(hca->qp[p]);
+            }
+        }
+        if (hca->cq != NULL) {
+            ibv_destroy_cq(hca->cq);
+        }
+        if (hca->mr != NULL) {
+            ibv_dereg_mr(hca->mr);
+        }
+        if (hca->pd != NULL) {
+            ibv_dealloc_pd(hca->pd);
+        }
+        if (hca->ctx != NULL) {
+            ibv_close_device(hca->ctx);
+        }
+    }
+    free(c);
+}
