+        .{ 2048, 4096, 4, 1 },  .{ 8192, 1536, 4, 1 }, .{ 4096, 8192, 8, 2 }, .{ 160, 4096, 8, 0 },   .{ 4096, 1536, 2, 0 },
+        .{ 4096, 1024, 2, 1 },
+    };
+    for (shapes) |s| {
+        try t.expectEqual(s[2], denseSplitK(s[0], s[1]));
+        try t.expectEqual(s[3], decCfg(s[0], s[1]));
