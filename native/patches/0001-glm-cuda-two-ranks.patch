diff --git a/zig/src/families/glm/cuda/glm_copy.zig b/zig/src/families/glm/cuda/glm_copy.zig
new file mode 100644
index 0000000..16071f3
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_copy.zig
@@ -0,0 +1,166 @@
+//! v1.8's prompt-lookup ("copy") drafts (glm5_next/cuda/copy_drafts.py, patches 0007, 0013 and 0032): when the context's last
+//! `match` tokens (the pending token included) occurred before, the tokens that followed their latest earlier occurrence
+//! are verified in place of the MTP head's drafts. They only propose; verification keeps the serial sample.
+//!
+//! Three rules differ from the lanes core's `SuffixLookup` (a 3-gram index, the longest match of at least 4 tokens, silent for
+//! 16 rounds after four missed ones), so GLM brings its own (glm_native.zig hands it to the stream):
+//! - which occurrence: the latest one with `k` tokens after it, else the earliest (not the longest match);
+//! - an occurrence that starts inside the reply must match `reply_match` tokens (COPY_CODE: 16), not `match` (8): code replies
+//!   repeat short boilerplate whose continuations differ;
+//! - a window of 9 to 15 rows is padded to the CUDA-graph width (16) by repeating its last draft, when the room allows.
+//! There is no silence, and a copy of one token is a copy (the lanes core wants two).
+const std = @import("std");
+
+/// Verify windows up to this many rows always replay CUDA graphs (engine.GRAPH_ROWS).
+pub const graphed = 8;
+/// The most drafts a round: a 16-row window (engine.MAX_ROWS - 1).
+pub const max_drafts = 15;
+
+pub const Settings = struct {
+    on: bool = true, // TF_GLM_COPY_DRAFTS (production: 1)
+    match: usize = 8, // TF_GLM_COPY_MATCH
+    most: usize = max_drafts, // TF_GLM_COPY_MAX (production: 15; Python's own default is 5)
+    reply_match: usize = 16, // TF_GLM_COPY_REPLY_MATCH (production COPY_CODE=1: 16; 0: the prompt's rule everywhere)
+    pad: usize = 16, // the engine's TF_GLM_WIDE_GRAPHS width (0: no padding)
+
+    /// The v1.8 production settings, from the TF_GLM_COPY_* variables; `wide_graph` is the engine's width.
+    pub fn fromEnv(wide_graph: usize) !Settings {
+        var s: Settings = .{ .pad = wide_graph };
+        const on = std.c.getenv("TF_GLM_COPY_DRAFTS");
+        if (on) |v| {
+            const t = std.mem.trim(u8, std.mem.span(v), " ");
+            if (t.len == 0 or std.mem.eql(u8, t, "0")) s.on = false else if (!std.mem.eql(u8, t, "1")) {
+                std.log.err("TF_GLM_COPY_DRAFTS is 0 or 1, not {s}", .{t});
+                return error.BadCopySettings;
+            }
+        }
+        s.match = try number("TF_GLM_COPY_MATCH", s.match, 2, 64);
+        s.most = try number("TF_GLM_COPY_MAX", s.most, 1, max_drafts);
+        s.reply_match = try number("TF_GLM_COPY_REPLY_MATCH", s.reply_match, 0, 64);
+        if (s.reply_match != 0 and s.reply_match <= s.match) {
+            std.log.err("TF_GLM_COPY_REPLY_MATCH is 0 (off) or more than TF_GLM_COPY_MATCH ({d}), not {d}", .{ s.match, s.reply_match });
+            return error.BadCopySettings;
+        }
+        return s;
+    }
+
+    fn number(name: [*:0]const u8, default: usize, low: usize, high: usize) !usize {
+        const v = std.c.getenv(name) orelse return default;
+        const t = std.mem.trim(u8, std.mem.span(v), " ");
+        if (t.len == 0) return default;
+        const n = std.fmt.parseInt(usize, t, 10) catch 0;
+        if (n < low or n > high) {
+            std.log.err("{s} is {d} to {d}, not {s}", .{ name, low, high, t });
+            return error.BadCopySettings;
+        }
+        return n;
+    }
+
+    /// Whether `ctx[i .. i + match]` is an earlier occurrence of the context's last `match` tokens (`prompt` leading
+    /// tokens are the prompt's: an occurrence starting past them also needs the tokens before it to match).
+    fn occurs(s: Settings, ctx: []const u32, prompt: usize, i: usize) bool {
+        const n = s.match;
+        const len = ctx.len;
+        if (!std.mem.eql(u32, ctx[i .. i + n], ctx[len - n ..])) return false;
+        if (s.reply_match > n and i >= prompt) {
+            const extra = s.reply_match - n;
+            if (i < extra or len - n < extra) return false;
+            for (1..extra + 1) |k| if (ctx[i - k] != ctx[len - n - k]) return false;
+        }
+        return true;
+    }
+
+    /// CopyDrafts.propose: up to `min(most, room)` drafts, what followed the latest earlier occurrence that has that many
+    /// tokens after it, else the most after any occurrence (the earliest); none when the suffix never occurred before. A
+    /// window of more than `graphed` rows short of the `pad` width is filled up to it by repeating the last draft, when
+    /// `room` allows. `ctx` is the prompt, the reply so far and the pending token; the result lives in `buf`.
+    pub fn propose(s: Settings, ctx: []const u32, prompt: usize, room: usize, buf: *[max_drafts]u32) []const u32 {
+        const k = @min(s.most, room);
+        const n = s.match;
+        const len = ctx.len;
+        if (!s.on or k < 1 or len <= n) return buf[0..0];
+        const last = ctx[len - 1];
+        var found: ?usize = null;
+        if (len >= n + k) { // the latest start with k tokens after its match
+            var i = len - n - k + 1;
+            while (i > 0) {
+                i -= 1;
+                if (ctx[i + n - 1] == last and s.occurs(ctx, prompt, i)) {
+                    found = i;
+                    break;
+                }
+            }
+        }
+        if (found == null) { // none: the earliest start, which leaves fewer than k tokens
+            var i = if (len >= n + k) len - n - k + 1 else 0;
+            while (i < len - n) : (i += 1) {
+                if (ctx[i + n - 1] == last and s.occurs(ctx, prompt, i)) {
+                    found = i;
+                    break;
+                }
+            }
+        }
+        const at = (found orelse return buf[0..0]) + n;
+        const count = @min(k, len - at);
+        @memcpy(buf[0..count], ctx[at..][0..count]);
+        const rows = 1 + count;
+        if (s.pad > graphed and rows > graphed and rows < s.pad and s.pad - 1 <= room) {
+            @memset(buf[count .. s.pad - 1], buf[count - 1]);
+            return buf[0 .. s.pad - 1];
+        }
+        return buf[0..count];
+    }
+};
+
+test "the latest occurrence with room, else the earliest" {
+    const s: Settings = .{ .match = 2, .most = 3, .reply_match = 0, .pad = 0 };
+    var buf: [max_drafts]u32 = undefined;
+    // the suffix (1 2) occurred at 0 and 5, both with 3 tokens after them: the later one
+    const ctx = [_]u32{ 1, 2, 5, 6, 7, 1, 2, 8, 9, 1, 2 };
+    try std.testing.expectEqualSlices(u32, &.{ 8, 9, 1 }, s.propose(&ctx, 0, 10, &buf));
+    // room 1 is one draft, from the same occurrence
+    try std.testing.expectEqualSlices(u32, &.{8}, s.propose(&ctx, 0, 1, &buf));
+    // (3 4) occurred once, at 0, with only 3 tokens after it where 4 are wanted: the earliest start, short
+    const wide: Settings = .{ .match = 2, .most = 4, .reply_match = 0, .pad = 0 };
+    const short = [_]u32{ 3, 4, 7, 3, 4 };
+    try std.testing.expectEqualSlices(u32, &.{ 7, 3, 4 }, wide.propose(&short, 0, 10, &buf));
+    // never seen
+    const fresh = [_]u32{ 1, 2, 3, 4, 5 };
+    try std.testing.expectEqual(@as(usize, 0), s.propose(&fresh, 0, 10, &buf).len);
+}
+
+test "an occurrence inside the reply needs the reply's longer match" {
+    const s: Settings = .{ .match = 2, .most = 2, .reply_match = 4, .pad = 0 };
+    var buf: [max_drafts]u32 = undefined;
+    // prompt 9 9, reply 1 2 5 7 1 2: the occurrence of (1 2) at 2 starts in the reply, and the token before it (9) is not
+    // the one before the suffix (7)
+    const ctx = [_]u32{ 9, 9, 1, 2, 5, 7, 1, 2 };
+    try std.testing.expectEqual(@as(usize, 0), s.propose(&ctx, 2, 10, &buf).len);
+    // with the tokens before it equal, it copies
+    const same = [_]u32{ 9, 9, 6, 6, 1, 2, 5, 6, 6, 1, 2 };
+    try std.testing.expectEqualSlices(u32, &.{ 5, 6 }, s.propose(&same, 2, 10, &buf));
+    // an occurrence in the prompt keeps the short match
+    try std.testing.expectEqualSlices(u32, &.{ 5, 7 }, s.propose(&.{ 1, 2, 5, 7, 4, 1, 2 }, 6, 10, &buf));
+}
+
+test "a window of 9 to 15 rows is padded to the graph width when room allows" {
+    const s: Settings = .{ .match = 2, .most = 15, .reply_match = 0, .pad = 16 };
+    var buf: [max_drafts]u32 = undefined;
+    var ctx: [30]u32 = undefined;
+    for (&ctx, 0..) |*t, i| t.* = @intCast(100 + i);
+    ctx[28] = 100;
+    ctx[29] = 101; // the suffix (100 101) occurred at 0
+    // 28 tokens follow the match at 0, so 15 drafts are plain
+    try std.testing.expectEqual(@as(usize, 15), s.propose(&ctx, 0, 40, &buf).len);
+    // room 10: ten drafts, 11 rows, below the pad's room (15): not padded
+    try std.testing.expectEqual(@as(usize, 10), s.propose(&ctx, 0, 10, &buf).len);
+    // a match with only 14 tokens after it (earliest, short): 15 rows, padded to 16 by repeating the last draft
+    var short: [16]u32 = undefined;
+    for (&short, 0..) |*t, i| t.* = @intCast(200 + i);
+    short[14] = 200;
+    short[15] = 201;
+    const got = s.propose(&short, 0, 40, &buf);
+    try std.testing.expectEqual(@as(usize, 15), got.len);
+    try std.testing.expectEqual(@as(u32, 201), got[14]); // 14 copied tokens end in 201, the pad repeats it
+    try std.testing.expectEqual(got[13], got[14]);
+}
diff --git a/zig/src/families/glm/cuda/glm_decode.zig b/zig/src/families/glm/cuda/glm_decode.zig
new file mode 100644
index 0000000..4612953
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_decode.zig
@@ -0,0 +1,240 @@
+//! Prefill, serial decoding and MTP-drafted decoding over the forward (v0.6.6 glm5_next/cuda/decode.py): both ranks
+//! run the same calls, and every choice comes from the gathered greedy picks, so they agree without messages.
+const std = @import("std");
+const fwd = @import("glm_forward.zig");
+const copy = @import("glm_copy.zig");
+const dflash = @import("glm_dflash.zig");
+const Engine = fwd.Engine;
+
+const bf = 2;
+
+/// decode.prefill without a resume point: the prompt in chunks, each also absorbed by the MTP head (its rows from
+/// the chunk's second token on), then the first token. The last row's hidden stays in e.st.last_hidden for the first draft.
+pub fn prefill(e: *Engine, prompt: []const u32, use_mtp: bool, drafter: ?*dflash.Drafter) !u32 {
+    try prefillCaches(e, prompt, use_mtp, drafter);
+    var first: [1]u32 = undefined;
+    try e.greedy(&e.buf, e.st.last_logits, 1, e.w.head.n, &first);
+    return first[0];
+}
+
+/// The prompt's caches (and the MTP head's), its last row's logits in e.st.last_logits.
+pub fn prefillCaches(e: *Engine, prompt: []const u32, use_mtp: bool, drafter: ?*dflash.Drafter) !void {
+    if (prompt.len == 0) return error.EmptyPrompt;
+    try e.reset();
+    if (drafter) |d| try d.reset(e);
+    var start: usize = 0;
+    while (start < prompt.len) : (start += Engine.prefill_rows) {
+        try prefillChunk(e, prompt, start, @min(prompt.len - start, Engine.prefill_rows), use_mtp, drafter);
+    }
+}
+
+/// One prompt chunk, `rows` rows of `prompt` from `start` (the state's position): its caches, the MTP head's rows
+/// (each with its following token, the next chunk's first included), its last row's logits and hidden kept.
+pub fn prefillChunk(e: *Engine, prompt: []const u32, start: usize, rows: usize, use_mtp: bool, drafter: ?*dflash.Drafter) !void {
+    const d: usize = e.w.cfg.hidden;
+    if (rows == 0 or rows > Engine.prefill_rows or start + rows > prompt.len) return error.BadChunk;
+    if (e.st.pos != start) return error.ChunkOutOfStep;
+    const chunk = prompt[start..][0..rows];
+    _ = try e.stage(&e.pbuf, chunk);
+    try e.compute(&e.pbuf, rows);
+    try e.copyDev(e.st.last_logits, e.pbuf.logits, e.w.head.n * bf); // `last = compute(..).clone()`
+    try e.copyDev(e.st.last_hidden, e.pbuf.fnormed + (rows - 1) * d * bf, d * bf);
+    if (drafter) |dr| try dr.addTaps(e, &e.pbuf, rows); // the chunk's rows join DFlash2's context
+    if (use_mtp and e.w.mtp != null) {
+        const nxt = prompt[start + 1 .. @min(prompt.len, start + rows + 1)];
+        if (nxt.len > 0) {
+            try e.mtp(&e.pbuf, nxt, e.pbuf.fnormed);
+            try e.setMtpLen(e.st.mtp_len + nxt.len);
+        }
+    }
+    try e.commitChunk(rows);
+}
+
+/// decode.serial_decode, greedy: one token a step until `count` tokens (the first included) or an end token.
+pub fn serial(e: *Engine, pending: u32, count: usize, stop_eos: bool, out: *std.ArrayList(u32), gpa: std.mem.Allocator) !void {
+    try out.append(gpa, pending);
+    while (out.items.len < count and !(stop_eos and isEos(e, out.items[out.items.len - 1]))) {
+        try e.forward(&.{out.items[out.items.len - 1]});
+        var tok: [1]u32 = undefined;
+        try e.greedy(&e.buf, e.buf.logits, 1, e.w.head.n, &tok);
+        try e.commit(1, 1);
+        try out.append(gpa, tok[0]);
+    }
+}
+
+fn isEos(e: *const Engine, t: u32) bool {
+    for (e.w.cfg.eos[0..e.w.cfg.eos_n]) |x| if (x == t) return true;
+    return false;
+}
+
+/// decode.absorb: kept rows (hidden, next token) into the MTP cache, after trimming the last round's draft entries;
+/// the last row's draft logits in mbuf.logits.
+fn absorb(e: *Engine, hidden: u64, next: []const u32) !void {
+    const d: usize = e.w.cfg.hidden;
+    if (e.st.mtp_drafted > 0) {
+        try e.setMtpLen(e.st.mtp_len - e.st.mtp_drafted);
+        e.st.mtp_drafted = 0;
+    }
+    var s0: usize = 0;
+    while (s0 < next.len) : (s0 += e.mbuf.rows) {
+        const part = next[s0..@min(next.len, s0 + e.mbuf.rows)];
+        try e.mtp(&e.mbuf, part, hidden + s0 * d * bf);
+        try e.setMtpLen(e.st.mtp_len + part.len);
+    }
+}
+
+/// decode.draft without a confidence cut: absorb, then chain `count` drafts, each from the head's own output row.
+pub fn draft(e: *Engine, hidden: u64, next: []const u32, count: usize, out: []u32) !void {
+    try absorb(e, hidden, next);
+    for (0..count) |j| {
+        var t: [1]u32 = undefined;
+        try e.greedy(&e.mbuf, e.mbuf.logits, 1, e.w.head.n, &t);
+        out[j] = t[0];
+        if (j + 1 < count) {
+            try e.mtp(&e.mbuf, &.{t[0]}, e.mbuf.fnormed);
+            try e.setMtpLen(e.st.mtp_len + 1);
+            e.st.mtp_drafted += 1;
+        }
+    }
+}
+
+/// What a drafted decode did: rounds, drafts kept, the rounds that verified copied drafts (and their drafts and kept ones),
+/// and how many windows ran at each row count.
+pub const Run = struct {
+    rounds: usize = 0,
+    accepted: usize = 0,
+    copy_rounds: usize = 0,
+    copy_drafted: usize = 0,
+    copy_accepted: usize = 0,
+    windows: [Engine.max_rows + 1]usize = @splat(0),
+};
+
+/// decode.mtp_decode, greedy, `depth` drafts a round: verify the pending token and the drafts, keep through the
+/// first mismatch, draft again from the kept rows. With `copies` (v1.8's COPY_DRAFTS, glm_copy.zig; `prompt` is the
+/// prompt the pending token follows) a round whose context repeats earlier text verifies the copied continuation
+/// instead, and the MTP head only absorbs the kept rows.
+pub fn mtpDecode(e: *Engine, pending: u32, count: usize, depth: usize, stop_eos: bool, out: *std.ArrayList(u32), gpa: std.mem.Allocator, copies: ?copy.Settings, prompt: []const u32) !Run {
+    if (depth + 1 > Engine.max_rows) return error.DepthPastWindow;
+    try out.append(gpa, pending);
+    var run: Run = .{};
+    var ctx: std.ArrayList(u32) = .empty;
+    defer ctx.deinit(gpa);
+    if (copies != null) {
+        try ctx.appendSlice(gpa, prompt);
+        try ctx.append(gpa, pending);
+    }
+    var copy_buf: [copy.max_drafts]u32 = undefined;
+    var drafts: [Engine.max_rows]u32 = undefined;
+    var n_drafts: usize = 0;
+    var copied = false;
+    if (copies) |c| {
+        const found = c.propose(ctx.items, prompt.len, count -| out.items.len -| 1, &copy_buf);
+        copied = found.len > 0;
+        if (copied) {
+            n_drafts = found.len;
+            @memcpy(drafts[0..n_drafts], found);
+            try absorb(e, e.st.last_hidden, &.{pending});
+        }
+    }
+    if (!copied) {
+        n_drafts = @min(depth, count - out.items.len);
+        if (n_drafts > 0) try draft(e, e.st.last_hidden, &.{pending}, n_drafts, drafts[0..n_drafts]);
+    }
+    while (out.items.len < count and !(stop_eos and isEos(e, out.items[out.items.len - 1]))) {
+        var window: [Engine.max_rows]u32 = undefined;
+        window[0] = out.items[out.items.len - 1];
+        @memcpy(window[1 .. 1 + n_drafts], drafts[0..n_drafts]);
+        const rows = 1 + n_drafts;
+        try e.forward(window[0..rows]);
+        var sampled: [Engine.max_rows]u32 = undefined;
+        try e.greedy(&e.buf, e.buf.logits, rows, e.w.head.n, sampled[0..rows]);
+        var keep: usize = 1;
+        for (drafts[0..n_drafts], 0..) |dt, i| {
+            if (sampled[i] != dt or (stop_eos and isEos(e, sampled[i]))) break;
+            keep += 1;
+        }
+        try e.commit(rows, keep);
+        run.rounds += 1;
+        run.accepted += keep - 1;
+        run.windows[rows] += 1;
+        if (copied) {
+            run.copy_rounds += 1;
+            run.copy_drafted += n_drafts;
+            run.copy_accepted += keep - 1;
+        }
+        try out.appendSlice(gpa, sampled[0..keep]);
+        if (copies != null) try ctx.appendSlice(gpa, sampled[0..keep]);
+        if (out.items.len >= count or (stop_eos and isEos(e, out.items[out.items.len - 1]))) break;
+        copied = false;
+        if (copies) |c| {
+            const found = c.propose(ctx.items, prompt.len, count -| out.items.len -| 1, &copy_buf);
+            copied = found.len > 0;
+            if (copied) {
+                n_drafts = found.len;
+                @memcpy(drafts[0..n_drafts], found);
+                try absorb(e, e.buf.fnormed, sampled[0..keep]);
+            }
+        }
+        if (!copied) {
+            n_drafts = @min(depth, count - out.items.len);
+            if (n_drafts > 0) try draft(e, e.buf.fnormed, sampled[0..keep], n_drafts, drafts[0..n_drafts]);
+        }
+    }
+    if (out.items.len > count) out.shrinkRetainingCapacity(count);
+    return run;
+}
+
+/// decode.dflash_decode, greedy: each round verifies the pending token and either a copied continuation (v1.8's COPY_DRAFTS, when
+/// `copies` is given and the context repeats) or DFlash2's chain (`policy`), keeps through the first mismatch, then adds the kept
+/// rows' taps to DFlash2's context. `prompt` is the prompt the pending token follows.
+pub fn dflashDecode(e: *Engine, drafter: *dflash.Drafter, pending: u32, count: usize, stop_eos: bool, out: *std.ArrayList(u32), gpa: std.mem.Allocator, copies: ?copy.Settings, prompt: []const u32, policy: dflash.Policy) !Run {
+    try out.append(gpa, pending);
+    var run: Run = .{};
+    var ctx: std.ArrayList(u32) = .empty;
+    defer ctx.deinit(gpa);
+    if (copies != null) {
+        try ctx.appendSlice(gpa, prompt);
+        try ctx.append(gpa, pending);
+    }
+    var copy_buf: [copy.max_drafts]u32 = undefined;
+    var drafts: [Engine.max_rows]u32 = undefined;
+    while (out.items.len < count and !(stop_eos and isEos(e, out.items[out.items.len - 1]))) {
+        var n_drafts: usize = 0;
+        var copied = false;
+        if (copies) |c| {
+            const found = c.propose(ctx.items, prompt.len, count -| out.items.len -| 1, &copy_buf);
+            copied = found.len > 0;
+            if (copied) {
+                n_drafts = found.len;
+                @memcpy(drafts[0..n_drafts], found);
+            }
+        }
+        if (!copied) n_drafts = try drafter.propose(e, out.items[out.items.len - 1], @min(policy.most, count - out.items.len), null, policy, &drafts);
+        var window: [Engine.max_rows]u32 = undefined;
+        window[0] = out.items[out.items.len - 1];
+        @memcpy(window[1 .. 1 + n_drafts], drafts[0..n_drafts]);
+        const rows = 1 + n_drafts;
+        try e.forward(window[0..rows]);
+        var sampled: [Engine.max_rows]u32 = undefined;
+        try e.greedy(&e.buf, e.buf.logits, rows, e.w.head.n, sampled[0..rows]);
+        var keep: usize = 1;
+        for (drafts[0..n_drafts], 0..) |dt, i| {
+            if (sampled[i] != dt or (stop_eos and isEos(e, sampled[i]))) break;
+            keep += 1;
+        }
+        try e.commit(rows, keep);
+        try drafter.addTaps(e, &e.buf, keep);
+        run.rounds += 1;
+        run.accepted += keep - 1;
+        run.windows[rows] += 1;
+        if (copied) {
+            run.copy_rounds += 1;
+            run.copy_drafted += n_drafts;
+            run.copy_accepted += keep - 1;
+        }
+        try out.appendSlice(gpa, sampled[0..keep]);
+        if (copies != null) try ctx.appendSlice(gpa, sampled[0..keep]);
+    }
+    if (out.items.len > count) out.shrinkRetainingCapacity(count);
+    return run;
+}
diff --git a/zig/src/families/glm/cuda/glm_dflash.zig b/zig/src/families/glm/cuda/glm_dflash.zig
new file mode 100644
index 0000000..ba35464
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_dflash.zig
@@ -0,0 +1,960 @@
+//! DFlash2 drafts for GLM-5.3-Flash on two CUDA ranks (v1.8 glm5_next/cuda/dflash2.py, the single-stream `Drafter`): a five
+//! layer block model with two-tap dynamic convolutions and sliding-window attention reads the means of the target's streams
+//! at five layers (the "taps" of every committed row) and, for [pending token, mask x (block - 1)], proposes candidates for
+//! the next block - 1 positions: each rank's top 16 of its half of the vocabulary, merged, with a selector's rows. A chain is
+//! then picked on the host (the selector's edge scores and the target's keyed noise) and cut by a confidence rule. Drafts only
+//! propose; the verify window keeps the serial sample, so the arithmetic need not equal Python's bit for bit.
+//!
+//! Both ranks run `addTaps` and `candidates` with the same all-gathers; rank 0 alone reads the candidates back and picks the
+//! chain, whose tokens ride the next verify command to rank 1.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("glm_weights.zig");
+const kern = @import("glm_kernels.zig");
+const fwd = @import("glm_forward.zig");
+const tri = @import("glm_triton.zig");
+
+const Engine = fwd.Engine;
+const bf = 2;
+const f4 = 4;
+
+/// Rows of a context update that replay one CUDA graph (engine.MAX_ROWS; larger updates run in pieces of this).
+pub const nmax = 16;
+/// The widest block (config block_size), and the widest candidate list and selector the buffers are sized for.
+const max_block = 16;
+
+fn int(x: usize) i32 {
+    return @intCast(x);
+}
+
+/// EDGE and NOISE of dflash2.py: the selector's edge weight and the target's keyed noise weight when sampling.
+const edge_weight: f64 = 0.6;
+const noise_weight: f64 = 0.7;
+
+/// The target's keyed sampling a chain's noise follows (lanes.sampling.Sampling's seed and temperature).
+pub const Sampling = struct { seed: u64, temperature: f64 };
+
+/// lanes.sampling.uniform (Python exact_sampling.uniform): a uniform (0, 1] double keyed by (seed, position, id).
+fn mix(v: u64) u64 {
+    var x = v;
+    x ^= x >> 30;
+    x *%= 0xBF58476D1CE4E5B9;
+    x ^= x >> 27;
+    x *%= 0x94D049BB133111EB;
+    return x ^ (x >> 31);
+}
+
+fn uniform(seed: u64, position: u64, id: u64) f64 {
+    var x = mix(seed +% 0x9E3779B97F4A7C15);
+    x = mix(x ^ (position *% 0xD1B54A32D192ED03));
+    x = mix(x ^ id);
+    return @as(f64, @floatFromInt(x >> 11)) * 0x1p-53 + 0x1p-54;
+}
+
+extern "c" fn exp(x: f64) f64;
+extern "c" fn log(x: f64) f64;
+
+/// engine.encode_policy's DFlash2 stop rule `fncN:P[:B]` (the product of the noise-aware confidences holds P) or `fcN:P`
+/// (the product of the plain ones); TF_GLM_DFLASH_POLICY, v1.8's production setting `fnc7:0.3`.
+pub const Policy = struct {
+    most: usize = 7,
+    confidence: f64 = 0.3,
+    beta: f64 = 2.0, // dflash2.NOISY_BETA; 0: the plain softmax share
+
+    pub fn fromEnv() !Policy {
+        const v = std.c.getenv("TF_GLM_DFLASH_POLICY") orelse return .{};
+        const spec = std.mem.trim(u8, std.mem.span(v), " ");
+        if (spec.len == 0) return .{};
+        const noisy = std.mem.startsWith(u8, spec, "fnc");
+        if (!noisy and !std.mem.startsWith(u8, spec, "fc")) {
+            std.log.err("TF_GLM_DFLASH_POLICY is fncN:P[:B] or fcN:P, not {s}", .{spec});
+            return error.BadDraftPolicy;
+        }
+        var it = std.mem.splitScalar(u8, spec[if (noisy) 3 else 2..], ':');
+        const most = std.fmt.parseInt(usize, it.next() orelse "", 10) catch return error.BadDraftPolicy;
+        const conf = std.fmt.parseFloat(f64, it.next() orelse "") catch return error.BadDraftPolicy;
+        const beta: f64 = if (noisy) (if (it.next()) |b| (std.fmt.parseFloat(f64, b) catch return error.BadDraftPolicy) else 2.0) else 0.0;
+        if (most < 1 or most > 15 or conf < 0 or conf > 1) return error.BadDraftPolicy;
+        return .{ .most = most, .confidence = conf, .beta = beta };
+    }
+};
+
+/// A block pass timed by piece (`profile`): the wall time of each stretch between two syncs, by label.
+pub const Prof = struct {
+    io: std.Io,
+    last: i96 = 0,
+    ms: [8]f64 = @splat(0),
+};
+
+pub const Drafter = struct {
+    gpa: std.mem.Allocator,
+    dr: *const wt.Draft,
+    w: *const wt.Weights,
+    capacity: usize,
+    ring: usize, // 0: a flat buffer, logical row p at p
+    cap: usize, // rows a cache holds
+    mem: cuda.DeviceBuffer,
+    kc: [8]u64 = @splat(0),
+    vc: [8]u64 = @splat(0),
+    pos_dev: u64,
+    cache: u64, // the K and V caches, layer by layer (the start of `mem`, or the drafter's slot of a Batch's pool)
+    ids: u64,
+    context_end: usize = 0,
+    // scratch (nmax rows unless noted)
+    tap_in: u64,
+    fc_xs: u64,
+    fc_out: u64,
+    ctx: u64,
+    ctx_xs: u64,
+    kvo: u64,
+    kk: u64,
+    vv: u64,
+    cos: u64,
+    sin: u64,
+    x: u64,
+    normed: u64,
+    xs: u64,
+    dyn: u64,
+    cv: u64,
+    cv_xs: u64,
+    qkv: u64,
+    qq: u64,
+    att: u64,
+    att_xs: u64,
+    part: u64,
+    gath: u64,
+    rowb: u64,
+    gu: u64,
+    act: u64,
+    act_xs: u64,
+    hh: u64, // block - 1 rows
+    hh_xs: u64,
+    logits: u64,
+    cand_loc: u64,
+    cand_all: u64,
+    proj: u64,
+    cand_host: []u32,
+    proj_host: []f32,
+    cand_tokens: []u32,
+    cand_values: []f64,
+    cand_proj: []f64,
+    snap_bytes: usize,
+    prof: ?*Prof = null, // TF_GLM_DF_PROF: eager block passes timed by piece
+
+    /// The drafter's buffers and caches on this rank (dflash2.Drafter.__init__): the context of `capacity` positions in a
+    /// ring of the window and block when that is shorter (TF_GLM_DRAFT_RING=0 keeps a flat one).
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const wt.Weights, capacity: usize) !Drafter {
+        if (w.draft == null) return error.NoDraftModel;
+        const dr = &w.draft.?;
+        if (dr.block > max_block or dr.layers.len > 8 or dr.top_k > 32 or dr.sel_rank > 512) return error.DraftTooWide;
+        const ring_rows = ((dr.window + 1 + dr.block + 63 + 63) / 64) * 64; // geometry.draft_ring_rows(window, block); window is sliding_window - 1
+        const use_ring = if (std.c.getenv("TF_GLM_DRAFT_RING")) |v| !std.mem.eql(u8, std.mem.span(v), "0") else true;
+        const ring: usize = if (use_ring and ring_rows < capacity + dr.block) ring_rows else 0;
+        const cap = if (ring != 0) ring else capacity + dr.block;
+        const D = dr.d;
+        const hd = dr.hd;
+        const nb = dr.block - 1;
+        const vl = w.cfg.vocab / wt.world;
+        const kvr = 2 * dr.kvh * hd;
+        const cand_n = nb * 2 * dr.top_k;
+        var dft: Drafter = undefined;
+        dft.gpa = gpa;
+        dft.dr = dr;
+        dft.w = w;
+        dft.capacity = capacity;
+        dft.ring = ring;
+        dft.cap = cap;
+        dft.context_end = 0;
+        dft.prof = null; // `dft` starts undefined: an unset prof is garbage, and tick() would synchronize inside a captured block pass
+        dft.kc = @splat(0);
+        dft.vc = @splat(0);
+        // one allocation: the K and V caches, then the scratch
+        const cache_bytes = 2 * dr.layers.len * dr.kvh * cap * hd * bf;
+        var off: usize = 0;
+        const sizes = [_]usize{
+            nmax * 5 * D * bf, // tap_in
+            nmax * (5 * D / 64) * f4, // fc_xs
+            nmax * D * bf, // fc_out
+            nmax * D * bf, // ctx
+            nmax * (D / 64) * f4, // ctx_xs
+            nmax * kvr * bf, // kvo
+            dr.kvh * nmax * hd * bf, // kk
+            dr.kvh * nmax * hd * bf, // vv
+            nmax * (hd / 2) * f4, // cos
+            nmax * (hd / 2) * f4, // sin
+            nmax * D * bf, // x
+            nmax * D * bf, // normed
+            nmax * (D / 64) * f4, // xs
+            nmax * (4 * D / dr.gs) * bf, // dyn
+            nmax * D * bf, // cv
+            nmax * (D / 64) * f4, // cv_xs
+            nmax * (dr.heads + 2 * dr.kvh) * hd * bf, // qkv
+            dr.heads * nmax * hd * bf, // qq
+            nmax * dr.heads * hd * bf, // att
+            nmax * (dr.heads * hd / 64) * f4, // att_xs
+            nmax * D * f4, // part
+            wt.world * nmax * D * f4, // gath
+            nmax * D * bf, // rowb
+            nmax * 2 * dr.inter * bf, // gu
+            nmax * dr.inter * bf, // act
+            nmax * (dr.inter / 64) * f4, // act_xs
+            nb * D * bf, // hh
+            nb * (D / 64) * f4, // hh_xs
+            nb * vl * bf, // logits
+            cand_n * 4, // cand_loc
+            wt.world * cand_n * 4, // cand_all
+            nb * dr.sel_rank * f4, // proj
+            4 * max_block, // ids
+            8, // pos_dev
+        };
+        var at: [sizes.len + 1]usize = undefined;
+        off = cache_bytes;
+        for (sizes, 0..) |s, i| {
+            off = std.mem.alignForward(usize, off, 256);
+            at[i] = off;
+            off += s;
+        }
+        dft.mem = try cuda.DeviceBuffer.alloc(d, off + 256);
+        errdefer dft.mem.free();
+        try dft.mem.fill8(0, null);
+        const base = dft.mem.ptr;
+        var c: usize = 0;
+        for (0..dr.layers.len) |i| {
+            dft.kc[i] = base + c;
+            c += dr.kvh * cap * hd * bf;
+            dft.vc[i] = base + c;
+            c += dr.kvh * cap * hd * bf;
+        }
+        inline for (.{ "tap_in", "fc_xs", "fc_out", "ctx", "ctx_xs", "kvo", "kk", "vv", "cos", "sin", "x", "normed", "xs", "dyn", "cv", "cv_xs", "qkv", "qq", "att", "att_xs", "part", "gath", "rowb", "gu", "act", "act_xs", "hh", "hh_xs", "logits", "cand_loc", "cand_all", "proj" }, 0..) |name, i| {
+            @field(dft, name) = base + at[i];
+        }
+        dft.ids = base + at[sizes.len - 2];
+        dft.pos_dev = base + at[sizes.len - 1];
+        dft.cache = base;
+        // the mask ids stay: only row 0 changes
+        const ids: [max_block]i32 = @splat(@intCast(dr.mask_id));
+        try upload(d, dft.ids, std.mem.sliceAsBytes(ids[0..dr.block]));
+        dft.cand_host = try gpa.alloc(u32, wt.world * cand_n);
+        errdefer gpa.free(dft.cand_host);
+        dft.proj_host = try gpa.alloc(f32, nb * dr.sel_rank);
+        errdefer gpa.free(dft.proj_host);
+        dft.cand_tokens = try gpa.alloc(u32, nb * dr.top_k);
+        errdefer gpa.free(dft.cand_tokens);
+        dft.cand_values = try gpa.alloc(f64, nb * dr.top_k);
+        errdefer gpa.free(dft.cand_values);
+        dft.cand_proj = try gpa.alloc(f64, nb * dr.sel_rank);
+        errdefer gpa.free(dft.cand_proj);
+        dft.snap_bytes = if (ring != 0) cache_bytes + 8 else 0;
+        return dft;
+    }
+
+    pub fn deinit(self: *Drafter) void {
+        self.gpa.free(self.cand_host);
+        self.gpa.free(self.proj_host);
+        self.gpa.free(self.cand_tokens);
+        self.gpa.free(self.cand_values);
+        self.gpa.free(self.cand_proj);
+        self.mem.free();
+    }
+
+    fn upload(d: *const cuda.Driver, dst: u64, bytes: []const u8) !void {
+        try d.check(d.api.cuMemcpyHtoD_v2(dst, bytes.ptr, bytes.len), "cuMemcpyHtoD");
+    }
+
+    /// dflash2.Drafter.reset: the context empty.
+    pub fn reset(self: *Drafter, e: *Engine) !void {
+        self.context_end = 0;
+        try e.zero(self.pos_dev, 8);
+    }
+
+    /// Bytes a kept prompt state holds of the drafter: its caches (a ring; a flat one keeps no state) and position.
+    pub fn stateBytes(self: *const Drafter) usize {
+        return self.snap_bytes;
+    }
+
+    pub fn save(self: *const Drafter, e: *Engine, dst: u64) !void {
+        if (self.snap_bytes == 0) return;
+        try e.copyDev(dst, self.cache, self.snap_bytes - 8);
+        try e.copyDev(dst + self.snap_bytes - 8, self.pos_dev, 8);
+    }
+
+    pub fn restore(self: *Drafter, e: *Engine, src: u64, at: usize) !void {
+        if (self.snap_bytes == 0) return error.NoDrafterState;
+        try e.copyDev(self.cache, src, self.snap_bytes - 8);
+        try e.copyDev(self.pos_dev, src + self.snap_bytes - 8, 8);
+        self.context_end = at;
+    }
+
+    /// Moves the caches to `cache` (cacheBytes), their contents with them. The position stays where it is (16-aligned:
+    /// the one-lane _dattn_kernel was captured with POS divisible by 16); the batch copies it into its `meta` each pass.
+    fn adopt(self: *Drafter, e: *Engine, cache: u64) !void {
+        try e.copyDev(cache, self.cache, self.cacheBytes());
+        const half = self.cacheBytes() / (2 * self.dr.layers.len);
+        for (0..self.dr.layers.len) |i| {
+            self.kc[i] = cache + 2 * i * half;
+            self.vc[i] = self.kc[i] + half;
+        }
+        self.cache = cache;
+    }
+
+    fn cacheBytes(self: *const Drafter) usize {
+        return 2 * self.dr.layers.len * self.dr.kvh * self.cap * self.dr.hd * bf;
+    }
+
+    // -- pieces -------------------------------------------------------------------------------------------------
+    fn tick(self: *const Drafter, e: *Engine, which: usize) !void {
+        const p = self.prof orelse return;
+        try e.s.synchronize();
+        const t = std.Io.Clock.awake.now(p.io).toNanoseconds();
+        p.ms[which] += @as(f64, @floatFromInt(t - p.last)) / 1e6;
+        p.last = t;
+    }
+
+    /// Eager block passes timed by piece, printed (both ranks run it alike): embed and rope, each layer's input stretch (norm, conv
+    /// projections, qkv), prep/scatter/attention, the o projection with its all-gather, the MLP up to swiglu, the down
+    /// projection with its all-gather, and the head with the candidates' gather and the selector's projection.
+    pub fn profile(self: *Drafter, e: *Engine, io: std.Io) !void {
+        var p: Prof = .{ .io = io };
+        self.prof = &p;
+        defer self.prof = null;
+        const reps = 6;
+        for (0..reps + 1) |r| {
+            if (r == 1) p.ms = @splat(0);
+            try e.s.synchronize();
+            p.last = std.Io.Clock.awake.now(io).toNanoseconds();
+            try self.blockBody(e);
+            try self.tick(e, 6);
+        }
+        if (e.w.rank == 0) std.debug.print("[tf-glm] DFlash2 block pass by piece (ms, eager): embed+rope {d:.2}, layers: input {d:.2}, prep+attention {d:.2}, o {d:.2}, mlp up {d:.2}, down {d:.2}; head+topk+gather+proj {d:.2}\n", .{ p.ms[0] / reps, p.ms[1] / reps, p.ms[2] / reps, p.ms[3] / reps, p.ms[4] / reps, p.ms[5] / reps, p.ms[6] / reps });
+    }
+    fn mm(self: *const Drafter, e: *Engine, x: u64, xs: u64, q: kern.Q4, out: u64, rows: usize, fp32: bool) !void {
+        _ = self;
+        try kern.qmmDecode(e.k, e.s, x, q.k, xs, q, out, rows, fp32);
+    }
+
+    fn norm(self: *const Drafter, e: *Engine, x: u64, weight: u64, out: u64, xs: u64, rows: usize) !void {
+        try e.t.rmsnorm(x, self.dr.d, weight, out, self.dr.d, xs, rows, self.dr.d, self.dr.eps);
+    }
+
+    fn rotary(self: *const Drafter, e: *Engine, rows: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(self.pos_dev);
+        a.add(self.dr.inv_freq);
+        a.add(int(rows));
+        a.add(int(self.dr.hd / 2));
+        a.add(self.cos);
+        a.add(self.sin);
+        try cuda.launch.launch(e.k.df_rope, .{ .grid = .{ .x = @intCast((rows * self.dr.hd / 2 + 127) / 128) }, .block = .{ .x = 128 } }, e.s, &a);
+    }
+
+    fn scatter(self: *const Drafter, e: *Engine, src: u64, cache: u64, rows: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(src);
+        a.add(cache);
+        a.add(self.pos_dev);
+        a.add(int(rows));
+        a.add(int(self.cap));
+        a.add(int(self.ring));
+        a.add(int(self.dr.hd));
+        try cuda.launch.launch(e.k.df_scatter, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(self.dr.kvh) }, .block = .{ .x = 128 } }, e.s, &a);
+    }
+
+    /// `_row`: a row-parallel projection's fp32 partials added in rank order, then bf16, into rowb.
+    fn row(self: *const Drafter, e: *Engine, x: u64, xs: u64, q: kern.Q4, rows: usize) !void {
+        try self.mm(e, x, xs, q, self.part, rows, true);
+        const n = rows * self.dr.d;
+        try e.comm.allGather(e.s, self.part, self.gath, n);
+        var a: cuda.Args = .{};
+        a.add(self.gath);
+        a.add(int(wt.world));
+        a.add(int(n));
+        a.add(self.rowb);
+        try cuda.launch.launch(e.k.df_rowsum, .{ .grid = .{ .x = @intCast((n + 255) / 256) }, .block = .{ .x = 256 } }, e.s, &a);
+    }
+
+    /// `_layer`: the block's (or a context update's) rows through layer i, in x.
+    fn layer(self: *const Drafter, e: *Engine, i: usize, rows: usize) !void {
+        const dr = self.dr;
+        const L = dr.layers[i];
+        const D = dr.d;
+        try self.norm(e, self.x, L.in_norm, self.normed, self.xs, rows);
+        try self.mm(e, self.normed, self.xs, L.a_kp, self.dyn, rows, false);
+        try e.t.dconv(self.normed, self.dyn, L.a_base, null, self.cv, rows, D, dr.gs, 0);
+        try e.t.groupSums(self.cv, D, self.cv_xs, rows, D);
+        try self.mm(e, self.cv, self.cv_xs, L.qkv, self.qkv, rows, false);
+        try self.tick(e, 1);
+        const kbuf = self.kk;
+        try e.t.draftPrep(self.qkv, L.q_norm, L.k_norm, self.cos, self.sin, self.qq, kbuf, self.vv, rows, (dr.heads + 2 * dr.kvh) * dr.hd, dr.eps, dr.heads, dr.kvh, dr.hd);
+        try self.scatter(e, kbuf, self.kc[i], rows);
+        try self.scatter(e, self.vv, self.vc[i], rows);
+        try e.t.draftAttention(self.qq, self.kc[i], self.vc[i], self.att, self.pos_dev, dr.window, rows, dr.heads, dr.kvh, dr.hd, self.cap, dr.causal, self.ring != 0);
+        try self.tick(e, 2);
+        try e.t.groupSums(self.att, dr.heads * dr.hd, self.att_xs, rows, dr.heads * dr.hd);
+        try self.row(e, self.att, self.att_xs, L.o, rows);
+        try e.t.dconv(self.rowb, self.dyn, L.a_base, self.x, self.x, rows, D, dr.gs, 1);
+        try self.tick(e, 3);
+        try self.norm(e, self.x, L.post_norm, self.normed, self.xs, rows);
+        try self.mm(e, self.normed, self.xs, L.m_kp, self.dyn, rows, false);
+        try e.t.dconv(self.normed, self.dyn, L.m_base, null, self.cv, rows, D, dr.gs, 0);
+        try e.t.groupSums(self.cv, D, self.cv_xs, rows, D);
+        try self.mm(e, self.cv, self.cv_xs, L.gu, self.gu, rows, false);
+        try e.t.swiglu(self.gu, self.act, self.act_xs, rows, dr.inter, 1e30);
+        try self.tick(e, 4);
+        try self.row(e, self.act, self.act_xs, L.down, rows);
+        try e.t.dconv(self.rowb, self.dyn, L.m_base, self.x, self.x, rows, D, dr.gs, 1);
+        try self.tick(e, 5);
+    }
+
+    // -- the context --------------------------------------------------------------------------------------------
+    fn tapsBody(self: *Drafter, e: *Engine, n: usize) !void {
+        const dr = self.dr;
+        const D = dr.d;
+        try e.t.groupSums(self.tap_in, 5 * D, self.fc_xs, n, 5 * D);
+        try self.mm(e, self.tap_in, self.fc_xs, dr.fc, self.fc_out, n, false);
+        try self.norm(e, self.fc_out, dr.hidden_norm, self.ctx, self.ctx_xs, n);
+        try self.rotary(e, n);
+        try e.t.groupSums(self.ctx, D, self.ctx_xs, n, D);
+        for (dr.layers, 0..) |L, i| {
+            try self.mm(e, self.ctx, self.ctx_xs, L.kv, self.kvo, n, false);
+            try e.t.draftPrep(self.kvo, L.q_norm, L.k_norm, self.cos, self.sin, self.kvo, self.kk, self.vv, n, 2 * dr.kvh * dr.hd, dr.eps, 0, dr.kvh, dr.hd);
+            try self.scatter(e, self.kk, self.kc[i], n);
+            try self.scatter(e, self.vv, self.vc[i], n);
+        }
+        var a: cuda.Args = .{};
+        a.add(self.pos_dev);
+        a.add(int(n));
+        try cuda.launch.launch(e.k.df_pos_add, .{ .grid = .{ .x = 1 }, .block = .{ .x = 1 } }, e.s, &a);
+    }
+
+    fn run(self: *Drafter, e: *Engine, head: fwd.GraphKey.Head, rows: usize, comptime body: anytype, args: anytype) !void {
+        _ = self;
+        if (e.use_graphs) return e.replay(.{ .lane = e.lane, .head = head, .rows = @intCast(rows), .cur = 0, .np = 0 }, body, args); // the bound lane's drafter
+        return @call(.auto, body, args);
+    }
+
+    /// dflash2.Drafter.add_taps for the first `n` rows of `b`'s taps (the committed rows' stream means at the five layers).
+    pub fn addTaps(self: *Drafter, e: *Engine, b: *const fwd.Buffers, n: usize) !void {
+        const D = self.dr.d;
+        var start: usize = 0;
+        while (start < n) {
+            const m = @min(nmax, n - start);
+            if (self.context_end + m > self.capacity) return error.DrafterPastCapacity;
+            var a: cuda.Args = .{};
+            for (b.taps) |t| a.add(t + start * D * bf);
+            a.add(int(D));
+            a.add(self.tap_in);
+            try cuda.launch.launch(e.k.df_cat, .{ .grid = .{ .x = @intCast(m) }, .block = .{ .x = 256 } }, e.s, &a);
+            try self.run(e, .dtaps, m, tapsBody, .{ self, e, m });
+            self.context_end += m;
+            start += m;
+        }
+    }
+
+    // -- drafts -------------------------------------------------------------------------------------------------
+    fn blockBody(self: *Drafter, e: *Engine) !void {
+        const dr = self.dr;
+        const n = dr.block;
+        const D = dr.d;
+        try e.t.embed(self.ids, self.w.embed, self.x, n, D, 1);
+        try self.rotary(e, n);
+        try self.tick(e, 0);
+        for (0..dr.layers.len) |i| try self.layer(e, i, n);
+        try self.norm(e, self.x + D * bf, dr.norm, self.hh, self.hh_xs, n - 1);
+        try kern.q4Matmul(e.k, e.s, self.hh, self.hh_xs, self.w.draft_head, self.logits, n - 1);
+        const vl = self.w.head.n;
+        var a: cuda.Args = .{};
+        a.add(self.logits);
+        a.add(int(vl));
+        a.add(int(vl));
+        a.add(int(dr.top_k));
+        a.add(int(e.w.rank * vl));
+        a.add(self.cand_loc);
+        try cuda.launch.launch(e.k.topk, .{ .grid = .{ .x = @intCast(n - 1) }, .block = .{ .x = 1024 } }, e.s, &a);
+        try e.comm.allGather(e.s, self.cand_loc, self.cand_all, (n - 1) * 2 * dr.top_k);
+        var p: cuda.Args = .{};
+        p.add(self.hh);
+        p.add(dr.hproj);
+        p.add(self.proj);
+        p.add(int(dr.sel_rank));
+        p.add(int(D));
+        try cuda.launch.launch(e.k.df_proj, .{ .grid = .{ .x = @intCast((dr.sel_rank + 7) / 8), .y = @intCast(n - 1) }, .block = .{ .x = 256 } }, e.s, &p);
+    }
+
+    /// dflash2.Drafter.candidates: the block pass for `pending` at the context's end. `read`: also bring the merged candidates
+    /// to the host (rank 0 alone); the lists are then valid until the next call.
+    pub fn block(self: *Drafter, e: *Engine, pending: u32, read: bool) !void {
+        const id: i32 = @intCast(pending);
+        try e.upload(self.ids, std.mem.asBytes(&id));
+        try self.run(e, .dblock, self.dr.block, blockBody, .{ self, e });
+        if (!read) return;
+        const dr = self.dr;
+        const nb = dr.block - 1;
+        // v1.10 patch 0092: an id outside the vocabulary is a float's bits read before the copy had landed; the rows are copied
+        // again once the device is idle, and a second failure is an error
+        for (0..2) |attempt| {
+            try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(self.cand_host.ptr, self.cand_all, wt.world * nb * 2 * dr.top_k * 4, e.s.handle), "cuMemcpyDtoHAsync");
+            try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(self.proj_host.ptr, self.proj, nb * dr.sel_rank * f4, e.s.handle), "cuMemcpyDtoHAsync");
+            try e.s.synchronize();
+            if (self.merge(nb)) return;
+            if (attempt == 1) return error.BadDrafterCandidates;
+            std.log.warn("drafter: a candidate id outside the vocabulary; copying the rows again once the device is idle", .{});
+            try e.d.check(e.d.api.cuCtxSynchronize(), "cuCtxSynchronize");
+        }
+    }
+
+    /// merge_candidates: each row's rank lists (values, then ids as fp32 bits... here pairs) merged by value then id, the top k.
+    fn merge(self: *Drafter, nb: usize) bool {
+        const dr = self.dr;
+        const k = dr.top_k;
+        const Cand = struct { v: f32, id: u32 };
+        var all: [wt.world * 32]Cand = undefined;
+        for (0..nb) |r| {
+            var m: usize = 0;
+            for (0..wt.world) |rank| {
+                const base = (rank * nb + r) * 2 * k;
+                for (0..k) |j| {
+                    all[m] = .{ .v = @bitCast(self.cand_host[base + 2 * j]), .id = self.cand_host[base + 2 * j + 1] };
+                    if (all[m].id >= self.w.cfg.vocab) return false;
+                    m += 1;
+                }
+            }
+            std.mem.sort(Cand, all[0..m], {}, struct {
+                fn less(_: void, a: Cand, b: Cand) bool {
+                    return a.v > b.v or (a.v == b.v and a.id < b.id);
+                }
+            }.less);
+            for (0..k) |j| {
+                self.cand_tokens[r * k + j] = all[j].id;
+                self.cand_values[r * k + j] = all[j].v;
+            }
+            for (0..dr.sel_rank) |j| self.cand_proj[r * dr.sel_rank + j] = self.proj_host[r * dr.sel_rank + j];
+        }
+        return true;
+    }
+
+    /// dflash2.noisy_confidence: softmax((score + g) / beta) at the pick j (g null: greedy).
+    fn noisyConfidence(score: []const f64, noise: ?[]const f64, j: usize, beta: f64) f64 {
+        var z: [32]f64 = undefined;
+        var top = -std.math.inf(f64);
+        for (score, 0..) |s, i| {
+            z[i] = (if (noise) |g| s + g[i] else s) / beta;
+            top = @max(top, z[i]);
+        }
+        var sum: f64 = 0;
+        var ej: f64 = 0;
+        for (score, 0..) |_, i| {
+            const e = exp(z[i] - top);
+            if (i == j) ej = e;
+            sum += e;
+        }
+        return ej / sum;
+    }
+
+    /// dflash2.Drafter.chain: pick candidates with the selector's edges and the target's keyed noise; stop below the
+    /// cumulative confidence, always keeping the first draft. `first` is the position of the first draft. Up to `depth` tokens.
+    pub fn chain(self: *const Drafter, depth: usize, anchor: u32, first: u64, sampling: ?Sampling, policy: Policy, out: []u32) usize {
+        const dr = self.dr;
+        const k = dr.top_k;
+        const sr = dr.sel_rank;
+        const sampled = if (sampling) |s| s.temperature > 0 else false;
+        const temp: f64 = if (sampled) sampling.?.temperature else 1.0;
+        var n: usize = 0;
+        var prev: u32 = anchor;
+        var chain_p: f64 = 1.0;
+        for (0..depth) |d| {
+            const toks = self.cand_tokens[d * k ..][0..k];
+            const vals = self.cand_values[d * k ..][0..k];
+            const proj = self.cand_proj[d * sr ..][0..sr];
+            const pred = dr.pred[@as(usize, prev) * sr ..][0..sr];
+            var score: [32]f64 = undefined;
+            var noise: [32]f64 = undefined;
+            var pick: [32]f64 = undefined;
+            var q: [512]f64 = undefined;
+            for (0..sr) |i| q[i] = @as(f64, pred[i]) * proj[i];
+            for (0..k) |j| {
+                const succ = dr.succ[@as(usize, toks[j]) * sr ..][0..sr];
+                var edge: f64 = 0;
+                for (0..sr) |i| edge += @as(f64, succ[i]) * q[i];
+                score[j] = (vals[j] + edge_weight * edge) / temp;
+                if (sampled) {
+                    noise[j] = -log(-log(uniform(sampling.?.seed, first + d, toks[j])));
+                    pick[j] = score[j] + noise_weight * noise[j];
+                } else pick[j] = score[j];
+            }
+            var best: usize = 0;
+            for (1..k) |j| if (pick[j] > pick[best]) {
+                best = j;
+            };
+            if (policy.beta > 0) {
+                chain_p *= noisyConfidence(score[0..k], if (sampled) noise[0..k] else null, best, policy.beta);
+                if (d > 0 and chain_p < policy.confidence) break;
+            } else if (policy.confidence > 0) {
+                var top = -std.math.inf(f64);
+                for (score[0..k]) |s| top = @max(top, s);
+                var sum: f64 = 0;
+                var ej: f64 = 0;
+                for (score[0..k], 0..) |s, j| {
+                    const e = exp(s - top);
+                    if (j == best) ej = e;
+                    sum += e;
+                }
+                chain_p *= ej / sum;
+                if (d > 0 and chain_p < policy.confidence) break;
+            }
+            prev = toks[best];
+            out[n] = prev;
+            n += 1;
+        }
+        return n;
+    }
+
+    /// dflash2.Drafter.propose after `block`: up to `depth` drafts for the positions after `pending`.
+    pub fn propose(self: *Drafter, e: *Engine, pending: u32, depth: usize, sampling: ?Sampling, policy: Policy, out: []u32) !usize {
+        const d = @min(depth, self.dr.block - 1);
+        if (d < 1 or self.context_end == 0) return 0;
+        try self.block(e, pending, true);
+        return self.chain(d, pending, self.context_end + 1, sampling, policy, out);
+    }
+};
+
+/// Block passes of several lanes' drafters in one launch sequence (v1.10 dflash2_multi.MultiDrafter.candidates): the rows of
+/// every lane's block [pending, mask x (block - 1)] back to back. The row-independent work (embedding, norms, the 4-bit
+/// projections in pieces of 16 rows, the o and down projections' gathers, the head, its top-k and the selector's rows) runs on
+/// all of them; each lane's rotary, `_prep`, cache writes and attention read its own drafter's ring and position, and the
+/// dynamic convolutions run a block at a time (a block's first row mixes no row before it). Each drafter is then left with its
+/// merged candidates as its own `block(read)` leaves them, so its `chain` is unchanged. Eager; drafts only propose.
+pub const Batch = struct {
+    gpa: std.mem.Allocator,
+    dr: *const wt.Draft,
+    w: *const wt.Weights,
+    lanes: usize, // blocks a pass holds at most
+    mem: cuda.DeviceBuffer,
+    ids: u64,
+    x: u64,
+    normed: u64,
+    xs: u64,
+    dyn: u64,
+    cv: u64,
+    cv_xs: u64,
+    qkv: u64,
+    qq: u64,
+    kk: u64,
+    vv: u64,
+    cos: u64,
+    sin: u64,
+    att: u64,
+    att_xs: u64,
+    part: u64,
+    gath: u64,
+    rowb: u64,
+    gu: u64,
+    act: u64,
+    act_xs: u64,
+    hh: u64,
+    hh_xs: u64,
+    logits: u64,
+    cand_loc: u64,
+    cand_all: u64,
+    proj: u64,
+    cand_host: []u32,
+    proj_host: []f32,
+    // with a ring (adopt): every lane's caches in one pool, so a layer's cache writes and attention are one launch each
+    pool: ?cuda.DeviceBuffer,
+    lane_bytes: usize, // a drafter's caches (Drafter.cacheBytes)
+    meta: u64, // the blocks' positions, i64 x lanes
+    slots: u64, // the blocks' slots (rows of cap), i64 x lanes
+
+    /// The 4-bit projections' widest piece (kern.qmmDecode, kern.q4Matmul).
+    const piece = 16;
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const wt.Weights, lanes: usize) !Batch {
+        const dr = &(w.draft orelse return error.NoDraftModel);
+        const R = lanes * dr.block;
+        const nb = dr.block - 1;
+        const M = lanes * nb;
+        const D = dr.d;
+        const hd = dr.hd;
+        const vl = w.cfg.vocab / wt.world;
+        const cand_n = M * 2 * dr.top_k;
+        var b: Batch = undefined;
+        b.gpa = gpa;
+        b.dr = dr;
+        b.w = w;
+        b.lanes = lanes;
+        b.pool = null;
+        const sizes = [_]usize{
+            R * 4, // ids
+            R * D * bf, // x
+            R * D * bf, // normed
+            R * (D / 64) * f4, // xs
+            R * (4 * D / dr.gs) * bf, // dyn
+            R * D * bf, // cv
+            R * (D / 64) * f4, // cv_xs
+            R * (dr.heads + 2 * dr.kvh) * hd * bf, // qkv
+            dr.heads * R * hd * bf, // qq
+            dr.kvh * R * hd * bf, // kk
+            dr.kvh * R * hd * bf, // vv
+            R * (hd / 2) * f4, // cos
+            R * (hd / 2) * f4, // sin
+            R * dr.heads * hd * bf, // att
+            R * (dr.heads * hd / 64) * f4, // att_xs
+            R * D * f4, // part
+            wt.world * R * D * f4, // gath
+            R * D * bf, // rowb
+            R * 2 * dr.inter * bf, // gu
+            R * dr.inter * bf, // act
+            R * (dr.inter / 64) * f4, // act_xs
+            M * D * bf, // hh
+            M * (D / 64) * f4, // hh_xs
+            M * vl * bf, // logits
+            cand_n * 4, // cand_loc
+            wt.world * cand_n * 4, // cand_all
+            M * dr.sel_rank * f4, // proj
+        };
+        var at: [sizes.len]usize = undefined;
+        var off: usize = 0;
+        for (sizes, 0..) |s, i| {
+            off = std.mem.alignForward(usize, off, 256);
+            at[i] = off;
+            off += s;
+        }
+        b.mem = try cuda.DeviceBuffer.alloc(d, off + 256);
+        errdefer b.mem.free();
+        try b.mem.fill8(0, null);
+        inline for (.{ "ids", "x", "normed", "xs", "dyn", "cv", "cv_xs", "qkv", "qq", "kk", "vv", "cos", "sin", "att", "att_xs", "part", "gath", "rowb", "gu", "act", "act_xs", "hh", "hh_xs", "logits", "cand_loc", "cand_all", "proj" }, 0..) |name, i| {
+            @field(b, name) = b.mem.ptr + at[i];
+        }
+        b.cand_host = try gpa.alloc(u32, wt.world * cand_n);
+        errdefer gpa.free(b.cand_host);
+        b.proj_host = try gpa.alloc(f32, M * dr.sel_rank);
+        return b;
+    }
+
+    pub fn deinit(b: *Batch) void {
+        b.gpa.free(b.cand_host);
+        b.gpa.free(b.proj_host);
+        if (b.pool) |*pl| pl.free();
+        b.mem.free();
+    }
+
+    /// v1.10 MultiDrafter's pool: moves the caches of `ds` (every lane's drafter, before any graph holds their addresses) into
+    /// one buffer, drafter s's at s caches in, so `layer` writes and reads every block's ring in one launch each. A flat
+    /// context (no ring) keeps its own caches and the launches per lane.
+    // ponytail: each drafter's own caches stay allocated and unused (about 36 MB a lane); give Drafter.init a no-cache mode if that memory counts
+    pub fn adopt(b: *Batch, e: *Engine, ds: []const *Drafter) !void {
+        if (ds.len == 0 or ds.len > b.lanes or ds[0].ring == 0) return;
+        b.lane_bytes = ds[0].cacheBytes();
+        var pl = try cuda.DeviceBuffer.alloc(e.d, ds.len * b.lane_bytes + 2 * 256 + 256);
+        errdefer pl.free();
+        b.meta = std.mem.alignForward(u64, pl.ptr + ds.len * b.lane_bytes, 256);
+        b.slots = b.meta + 256;
+        for (ds, 0..) |dft, s| try dft.adopt(e, pl.ptr + s * b.lane_bytes);
+        try e.s.synchronize();
+        b.pool = pl;
+    }
+
+    /// A 4-bit projection of `rows` rows (x rows q.k apart) in pieces of up to 16.
+    fn mm(e: *Engine, x: u64, xs: u64, q: kern.Q4, out: u64, rows: usize, fp32: bool) !void {
+        var r: usize = 0;
+        while (r < rows) : (r += piece) {
+            const n = @min(piece, rows - r);
+            try kern.qmmDecode(e.k, e.s, x + r * q.k * bf, q.k, xs + r * (q.k / 64) * f4, q, out + r * q.n * @as(usize, if (fp32) f4 else bf), n, fp32);
+        }
+    }
+
+    fn norm(b: *const Batch, e: *Engine, x: u64, weight: u64, out: u64, xs: u64, rows: usize) !void {
+        try e.t.rmsnorm(x, b.dr.d, weight, out, b.dr.d, xs, rows, b.dr.d, b.dr.eps);
+    }
+
+    /// Drafter.row over every row: the fp32 partials gathered once and added in rank order into rowb.
+    fn row(b: *const Batch, e: *Engine, x: u64, xs: u64, q: kern.Q4, rows: usize) !void {
+        try mm(e, x, xs, q, b.part, rows, true);
+        const n = rows * b.dr.d;
+        try e.comm.allGather(e.s, b.part, b.gath, n);
+        var a: cuda.Args = .{};
+        a.add(b.gath);
+        a.add(int(wt.world));
+        a.add(int(n));
+        a.add(b.rowb);
+        try cuda.launch.launch(e.k.df_rowsum, .{ .grid = .{ .x = @intCast((n + 255) / 256) }, .block = .{ .x = 256 } }, e.s, &a);
+    }
+
+    /// `_dconv` a block at a time: block s's rows of x, dyn, the residual and out.
+    fn dconv(b: *const Batch, e: *Engine, x: u64, base: u64, res: ?u64, out: u64, S: usize, branch: usize) !void {
+        const dr = b.dr;
+        const n = dr.block;
+        const D = dr.d;
+        for (0..S) |s| {
+            const o = s * n * D * bf;
+            try e.t.dconv(x + o, b.dyn + s * n * (4 * D / dr.gs) * bf, base, if (res) |r| r + o else null, out + o, n, D, dr.gs, branch);
+        }
+    }
+
+    fn layer(b: *const Batch, e: *Engine, ds: []const *Drafter, i: usize) !void {
+        const dr = b.dr;
+        const L = dr.layers[i];
+        const D = dr.d;
+        const n = dr.block;
+        const hd = dr.hd;
+        const S = ds.len;
+        const R = S * n;
+        const qkv_w = (dr.heads + 2 * dr.kvh) * hd;
+        try b.norm(e, b.x, L.in_norm, b.normed, b.xs, R);
+        try mm(e, b.normed, b.xs, L.a_kp, b.dyn, R, false);
+        try b.dconv(e, b.normed, L.a_base, null, b.cv, S, 0);
+        try e.t.groupSums(b.cv, D, b.cv_xs, R, D);
+        try mm(e, b.cv, b.cv_xs, L.qkv, b.qkv, R, false);
+        if (b.pool) |pl| {
+            // every block at once: q, k, v [heads, R, hd]; block s's rows into its slot at its position, then attention
+            const half = b.lane_bytes / (2 * dr.layers.len);
+            const kc = pl.ptr + 2 * i * half;
+            const d0 = ds[0];
+            try e.t.draftPrep(b.qkv, L.q_norm, L.k_norm, b.cos, b.sin, b.qq, b.kk, b.vv, R, qkv_w, dr.eps, dr.heads, dr.kvh, hd);
+            for ([_][2]u64{ .{ b.kk, kc }, .{ b.vv, kc + half } }) |sc| {
+                var a: cuda.Args = .{};
+                a.add(sc[0]);
+                a.add(sc[1]);
+                a.add(b.meta);
+                a.add(b.slots);
+                a.add(int(R));
+                a.add(int(n));
+                a.add(int(d0.cap));
+                a.add(int(d0.ring));
+                a.add(int(hd));
+                try cuda.launch.launch(e.k.df_scatter_seg, .{ .grid = .{ .x = @intCast(R), .y = @intCast(dr.kvh) }, .block = .{ .x = 128 } }, e.s, &a);
+            }
+            try e.t.draftAttentionSeg(b.qq, kc, kc + half, b.att, b.meta, b.slots, dr.window, R, n, d0.cap, dr.heads, dr.kvh, hd, d0.cap, dr.causal, true);
+        } else for (ds, 0..) |dft, s| {
+            const qq = b.qq + s * dr.heads * n * hd * bf;
+            const kk = b.kk + s * dr.kvh * n * hd * bf;
+            const vv = b.vv + s * dr.kvh * n * hd * bf;
+            const rope = s * n * (hd / 2) * f4;
+            try e.t.draftPrep(b.qkv + s * n * qkv_w * bf, L.q_norm, L.k_norm, b.cos + rope, b.sin + rope, qq, kk, vv, n, qkv_w, dr.eps, dr.heads, dr.kvh, hd);
+            try dft.scatter(e, kk, dft.kc[i], n);
+            try dft.scatter(e, vv, dft.vc[i], n);
+            try e.t.draftAttention(qq, dft.kc[i], dft.vc[i], b.att + s * n * dr.heads * hd * bf, dft.pos_dev, dr.window, n, dr.heads, dr.kvh, hd, dft.cap, dr.causal, dft.ring != 0);
+        }
+        try e.t.groupSums(b.att, dr.heads * hd, b.att_xs, R, dr.heads * hd);
+        try b.row(e, b.att, b.att_xs, L.o, R);
+        try b.dconv(e, b.rowb, L.a_base, b.x, b.x, S, 1);
+        try b.norm(e, b.x, L.post_norm, b.normed, b.xs, R);
+        try mm(e, b.normed, b.xs, L.m_kp, b.dyn, R, false);
+        try b.dconv(e, b.normed, L.m_base, null, b.cv, S, 0);
+        try e.t.groupSums(b.cv, D, b.cv_xs, R, D);
+        try mm(e, b.cv, b.cv_xs, L.gu, b.gu, R, false);
+        try e.t.swiglu(b.gu, b.act, b.act_xs, R, dr.inter, 1e30);
+        try b.row(e, b.act, b.act_xs, L.down, R);
+        try b.dconv(e, b.rowb, L.m_base, b.x, b.x, S, 1);
+    }
+
+    /// Drafter.block for every drafter of `ds` (each at its context's end, `pend` its pending token), in one pass. `read`:
+    /// also bring each one's merged candidates to the host (rank 0 alone), as its own `block(read)` would.
+    pub fn blocks(b: *Batch, e: *Engine, ds: []const *Drafter, pend: []const u32, read: bool) !void {
+        const dr = b.dr;
+        const S = ds.len;
+        if (S == 0 or S > b.lanes or pend.len != S) return error.BadDraftBatch;
+        const n = dr.block;
+        const R = S * n;
+        var ids: [8 * max_block]i32 = undefined;
+        for (0..S) |s| {
+            @memset(ids[s * n ..][0..n], @intCast(dr.mask_id));
+            ids[s * n] = @intCast(pend[s]);
+        }
+        try e.upload(b.ids, std.mem.sliceAsBytes(ids[0..R]));
+        if (b.pool) |pl| {
+            var slot: [8]i64 = undefined;
+            const per = ds[0].cap * dr.hd * bf;
+            for (ds, 0..) |dft, s| {
+                slot[s] = @intCast((dft.cache - pl.ptr) / per);
+                try e.copyDev(b.meta + 8 * s, dft.pos_dev, 8);
+            }
+            try e.upload(b.slots, std.mem.sliceAsBytes(slot[0..S]));
+        }
+        // with the pool every address below is fixed for a lane count (the positions come from `meta`): one graph each
+        if (b.pool != null and e.use_graphs) {
+            try e.replay(.{ .lane = 0, .head = .dbatch, .rows = @intCast(S), .cur = 0, .np = 0 }, pass, .{ b, e, ds });
+        } else try b.pass(e, ds);
+        if (!read) return;
+        try b.readBack(e, ds);
+    }
+
+    /// Batch.blocks' device work, from the embedded block rows to the gathered candidates and the selector rows.
+    fn pass(b: *Batch, e: *Engine, ds: []const *Drafter) !void {
+        const dr = b.dr;
+        const S = ds.len;
+        const n = dr.block;
+        const nb = n - 1;
+        const D = dr.d;
+        const k = dr.top_k;
+        const R = S * n;
+        const M = S * nb;
+        try e.t.embed(b.ids, b.w.embed, b.x, R, D, 1);
+        for (ds, 0..) |dft, s| {
+            var a: cuda.Args = .{};
+            a.add(if (b.pool != null) b.meta + 8 * s else dft.pos_dev);
+            a.add(dr.inv_freq);
+            a.add(int(n));
+            a.add(int(dr.hd / 2));
+            a.add(b.cos + s * n * (dr.hd / 2) * f4);
+            a.add(b.sin + s * n * (dr.hd / 2) * f4);
+            try cuda.launch.launch(e.k.df_rope, .{ .grid = .{ .x = @intCast((n * dr.hd / 2 + 127) / 128) }, .block = .{ .x = 128 } }, e.s, &a);
+        }
+        for (0..dr.layers.len) |i| try b.layer(e, ds, i);
+        for (0..S) |s| try b.norm(e, b.x + (s * n + 1) * D * bf, dr.norm, b.hh + s * nb * D * bf, b.hh_xs + s * nb * (D / 64) * f4, nb);
+        const vl = b.w.head.n;
+        if (M > piece and M <= 2 * piece) {
+            // one launch on the 32-row tile reads the head once (v1.10's qmm bucket); the drafts are hints, so these bits
+            // need not be the one-lane pass's
+            try kern.qmmShared(e.k, e.s, b.hh, D, b.hh_xs, b.w.draft_head, b.logits, M, false);
+        } else {
+            var r: usize = 0;
+            while (r < M) : (r += piece) {
+                const m = @min(piece, M - r);
+                try kern.q4Matmul(e.k, e.s, b.hh + r * D * bf, b.hh_xs + r * (D / 64) * f4, b.w.draft_head, b.logits + r * vl * bf, m);
+            }
+        }
+        var a: cuda.Args = .{};
+        a.add(b.logits);
+        a.add(int(vl));
+        a.add(int(vl));
+        a.add(int(k));
+        a.add(int(e.w.rank * vl));
+        a.add(b.cand_loc);
+        try cuda.launch.launch(e.k.topk, .{ .grid = .{ .x = @intCast(M) }, .block = .{ .x = 1024 } }, e.s, &a);
+        try e.comm.allGather(e.s, b.cand_loc, b.cand_all, M * 2 * k);
+        var p: cuda.Args = .{};
+        p.add(b.hh);
+        p.add(dr.hproj);
+        p.add(b.proj);
+        p.add(int(dr.sel_rank));
+        p.add(int(D));
+        try cuda.launch.launch(e.k.df_proj, .{ .grid = .{ .x = @intCast((dr.sel_rank + 7) / 8), .y = @intCast(M) }, .block = .{ .x = 256 } }, e.s, &p);
+    }
+
+    /// Rank 0: each drafter's merged candidates and selector rows from the last pass.
+    fn readBack(b: *Batch, e: *Engine, ds: []const *Drafter) !void {
+        const dr = b.dr;
+        const nb = dr.block - 1;
+        const k = dr.top_k;
+        const M = ds.len * nb;
+        // v1.10 patch 0092 as Drafter.block: a bad id is a copy read early; copy again once the device is idle
+        for (0..2) |attempt| {
+            try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(b.cand_host.ptr, b.cand_all, wt.world * M * 2 * k * 4, e.s.handle), "cuMemcpyDtoHAsync");
+            try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(b.proj_host.ptr, b.proj, M * dr.sel_rank * f4, e.s.handle), "cuMemcpyDtoHAsync");
+            try e.s.synchronize();
+            var good = true;
+            for (ds, 0..) |dft, s| {
+                // drafter s's rows in its own block's layout: [rank][row][2k], then its selector rows
+                for (0..wt.world) |rank| for (0..nb) |row_i| {
+                    @memcpy(dft.cand_host[(rank * nb + row_i) * 2 * k ..][0 .. 2 * k], b.cand_host[(rank * M + s * nb + row_i) * 2 * k ..][0 .. 2 * k]);
+                };
+                @memcpy(dft.proj_host[0 .. nb * dr.sel_rank], b.proj_host[s * nb * dr.sel_rank ..][0 .. nb * dr.sel_rank]);
+                if (!dft.merge(nb)) good = false;
+            }
+            if (good) return;
+            if (attempt == 1) return error.BadDrafterCandidates;
+            std.log.warn("drafter: a candidate id outside the vocabulary ({d} lanes); copying the rows again once the device is idle", .{ds.len});
+            try e.d.check(e.d.api.cuCtxSynchronize(), "cuCtxSynchronize");
+        }
+    }
+};
diff --git a/zig/src/families/glm/cuda/glm_forward.zig b/zig/src/families/glm/cuda/glm_forward.zig
new file mode 100644
index 0000000..f44d225
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_forward.zig
@@ -0,0 +1,2315 @@
+//! GLM-5.3-Flash's tensor-parallel forward, MTP step and commit on CUDA, launch for launch as the Python engine runs
+//! them (v0.6.6 families/glm5_next/cuda/forward.py and mtp.py, TF_GLM_LATENT=1, the EXL3 checkpoint), eagerly:
+//! every buffer is static, positions live on the device, and the host knows them too (Python's host_pos path).
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("glm_weights.zig");
+const tri = @import("glm_triton.zig");
+const kern = @import("glm_kernels.zig");
+const segments = @import("glm_segments.zig");
+const l2pf = @import("glm_l2pf.zig");
+const roce_mod = @import("glm_roce.zig");
+
+const Weights = wt.Weights;
+const Mat = wt.Mat;
+
+const bf = 2;
+const f4 = 4;
+
+/// Two ranks' all-gather of fp32 partials (comm.py over NCCL): rank r's `count` floats land at recv + r * count.
+pub const Comm = struct {
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    roce: ?*roce_mod.Roce = null,
+
+    /// Small gathers (up to TF_ROCE_MAX_KB a rank, a multiple of 16 bytes) over RoCE when it is up, the rest through NCCL; the
+    /// choice is by byte count alone, which both ranks' matching calls share.
+    pub fn allGather(c: Comm, s: cuda.Stream, send: u64, recv: u64, count: usize) !void {
+        if (c.roce) |r| if (r.fits(count * 4) and send % 16 == 0 and recv % 16 == 0) return r.gather(s, send, recv, count * 4);
+        try c.lib.check(c.lib.api.ncclAllGather(send, recv, count, .f32, c.comm, s.handle), "ncclAllGather");
+    }
+
+    /// comm.exchange: byte ranges sent to and received from the peer in one NCCL group, always through NCCL (hcsplit's swaps).
+    pub fn exchange(c: Comm, s: cuda.Stream, sends: []const Seg, recvs: []const Seg, peer: usize) !void {
+        const api = c.lib.api;
+        try c.lib.check(api.ncclGroupStart(), "ncclGroupStart");
+        for (sends) |x| try c.lib.check(api.ncclSend(x.ptr, x.bytes, .u8, @intCast(peer), c.comm, s.handle), "ncclSend");
+        for (recvs) |x| try c.lib.check(api.ncclRecv(x.ptr, x.bytes, .u8, @intCast(peer), c.comm, s.handle), "ncclRecv");
+        try c.lib.check(api.ncclGroupEnd(), "ncclGroupEnd");
+    }
+
+    pub const Seg = struct { ptr: u64, bytes: usize };
+};
+
+/// TF_GLM_HC_SPLIT / TF_GLM_PREFILL_OVERLAP (v1.10 hcsplit.SplitSettings; the recipe's default SPLIT=1 sets 1 and 2, as here):
+/// a prompt chunk's hyper-connection glue split by rows between the ranks (each rank sends the other its partial of the
+/// other's rows and glues its own), the swaps on a second stream in row pieces (overlap), and the next block's
+/// row-independent front on own rows while the swaps run (fronts). Every glue kernel is row-independent and the partials are
+/// summed rank 0 first as unsplit, so every bit is the unsplit path's. Swaps are p2p only (no TF_GLM_HC_EXCHANGE=gather).
+pub const SplitSettings = struct {
+    split: bool = true,
+    overlap: bool = true,
+    fronts: bool = true,
+    pieces: usize = 2, // TF_GLM_OVERLAP_PIECES
+    min_rows: usize = 64, // TF_GLM_HC_SPLIT_MIN_ROWS: shorter chunks (a prompt's tail) run unsplit
+
+    pub fn fromEnv() !SplitSettings {
+        var s: SplitSettings = .{};
+        if (std.c.getenv("TF_GLM_HC_SPLIT")) |v| {
+            const t = std.mem.span(v);
+            if (!std.mem.eql(u8, t, "0") and !std.mem.eql(u8, t, "1")) return bad("TF_GLM_HC_SPLIT is 0 or 1", t);
+            s.split = t[0] == '1';
+        }
+        const level: u8 = if (std.c.getenv("TF_GLM_PREFILL_OVERLAP")) |v| blk: {
+            const t = std.mem.span(v);
+            if (t.len != 1 or t[0] < '0' or t[0] > '2') return bad("TF_GLM_PREFILL_OVERLAP is 0, 1 or 2", t);
+            break :blk t[0] - '0';
+        } else if (s.split) 2 else 0;
+        if (level > 0 and !s.split) return bad("TF_GLM_PREFILL_OVERLAP overlaps the row-split swaps: it needs TF_GLM_HC_SPLIT=1, not", "0");
+        s.overlap = level > 0;
+        s.fronts = level == 2;
+        if (std.c.getenv("TF_GLM_HC_EXCHANGE")) |v| if (!std.mem.eql(u8, std.mem.span(v), "p2p")) return bad("TF_GLM_HC_EXCHANGE: only p2p is ported, not", std.mem.span(v));
+        if (std.c.getenv("TF_GLM_OVERLAP_PIECES")) |v| s.pieces = try ranged("TF_GLM_OVERLAP_PIECES", v, 1, 8);
+        if (std.c.getenv("TF_GLM_HC_SPLIT_MIN_ROWS")) |v| s.min_rows = try ranged("TF_GLM_HC_SPLIT_MIN_ROWS", v, 2, 16384);
+        return s;
+    }
+
+    pub fn pieceCount(s: SplitSettings) usize {
+        return if (s.overlap) s.pieces else 1;
+    }
+
+    /// What both ranks must agree on (hcsplit.SplitSettings.code), one word.
+    pub fn code(s: SplitSettings) u32 {
+        if (!s.split) return 0;
+        return 1 | @as(u32, @intFromBool(s.overlap)) << 1 | @as(u32, @intFromBool(s.fronts)) << 2 | @as(u32, @intCast(s.pieceCount())) << 4 | @as(u32, @intCast(s.min_rows)) << 8;
+    }
+
+    fn bad(what: []const u8, v: []const u8) error{BadSplitSetting} {
+        std.log.err("{s} {s}", .{ what, v });
+        return error.BadSplitSetting;
+    }
+
+    fn ranged(name: []const u8, v: [*:0]const u8, lo: usize, hi: usize) !usize {
+        const t = std.mem.span(v);
+        const n = std.fmt.parseInt(usize, t, 10) catch return bad(name, t);
+        if (n < lo or n > hi) return bad(name, t);
+        return n;
+    }
+};
+
+/// One prompt buffer's row split (hcsplit.HcSplit, two ranks, p2p): rank r owns rows [r H, r H + H), H = Rp / 2 (an odd
+/// chunk gets one zero pad row, never read); the second stream and its events when overlapping.
+const Split = struct {
+    set: SplitSettings,
+    side: ?cuda.Stream,
+    ev_begin: cuda.Event,
+    ev_done: cuda.Event,
+    ev_fill: [8]cuda.Event,
+    ev_part: [8]cuda.Event,
+    ev_glue: [8]cuda.Event,
+    active: bool = false,
+    r: usize = 0,
+    rp: usize = 0,
+    h: usize = 0,
+    pieces: [8][2]usize = undefined, // (offset in the rank's rows, rows)
+    n: usize = 0,
+
+    fn init(d: *const cuda.Driver, set: SplitSettings) !Split {
+        var sp: Split = .{ .set = set, .side = null, .ev_begin = try cuda.Event.init(d, false), .ev_done = try cuda.Event.init(d, false), .ev_fill = undefined, .ev_part = undefined, .ev_glue = undefined };
+        for (0..8) |j| {
+            sp.ev_fill[j] = try cuda.Event.init(d, false);
+            sp.ev_part[j] = try cuda.Event.init(d, false);
+            sp.ev_glue[j] = try cuda.Event.init(d, false);
+        }
+        // TF_GLM_OVERLAP_PRIORITY's default: the side stream at normal priority (0022)
+        if (set.overlap) sp.side = try cuda.Stream.init(d, true);
+        return sp;
+    }
+
+    fn deinit(sp: *Split) void {
+        if (sp.side) |*s| s.deinit();
+        sp.ev_begin.deinit();
+        sp.ev_done.deinit();
+        for (0..8) |j| {
+            sp.ev_fill[j].deinit();
+            sp.ev_part[j].deinit();
+            sp.ev_glue[j].deinit();
+        }
+    }
+};
+
+/// What a split site writes into b.part for rows lo .. hi (forward.partials' `fill`): an output projection's rows, or the
+/// MoE's shared expert on the rows its front has not run on, then the combine.
+const Fill = union(enum) {
+    proj: struct { x: u64, xs: u64, q: Mat },
+    moe: struct { m: wt.Moe, done: ?[2]usize },
+};
+
+/// The next block's row-independent start (forward.mixer_front / ffn_front) the glue runs on own rows (TF_GLM_PREFILL_OVERLAP=2).
+const Front = union(enum) { none, kda: *const wt.Layer, dsa: *const wt.Layer, mlp: wt.Mlp, shared: wt.Mlp };
+
+/// forward.undone: the row ranges of [0, rows) outside `done` (rows a front already ran on), in row order; empty ranges
+/// have hi <= lo.
+fn undone(rows: usize, done: ?[2]usize) [2][2]usize {
+    const d = done orelse return .{ .{ 0, rows }, .{ 0, 0 } };
+    return .{ .{ 0, @min(d[0], rows) }, .{ d[1], rows } };
+}
+
+/// A bump allocator over one device allocation, 256-byte aligned pieces.
+const Arena = struct {
+    base: u64,
+    used: usize = 0,
+    size: usize,
+
+    fn take(a: *Arena, bytes: usize) u64 {
+        const at = std.mem.alignForward(usize, a.used, 256);
+        a.used = at + bytes;
+        std.debug.assert(a.used <= a.size or a.size == 0);
+        return a.base + at;
+    }
+};
