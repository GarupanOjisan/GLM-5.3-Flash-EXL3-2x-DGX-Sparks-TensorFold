+//! One rank of the two-rank GLM engine and the commands that keep the ranks in step: rank 0 sends each command to
+//! rank 1 over the TCP pair before running it, rank 1 runs the same commands in the same order. Every token the
+//! ranks pick comes from the same all-gather, so they agree without sending results back.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm_config = @import("glm_config");
+const wt = @import("glm_weights.zig");
+const tri = @import("glm_triton.zig");
+const kern = @import("glm_kernels.zig");
+const fwd = @import("glm_forward.zig");
+const dec = @import("glm_decode.zig");
+const dflash = @import("glm_dflash.zig");
+const roce_mod = @import("glm_roce.zig");
+
+const Engine = fwd.Engine;
+
+pub const Kind = enum(u32) { begin = 1, verify = 2, keep = 3, draft = 4, quit = 5, chunk = 6, first = 7, save = 8, drop = 9, dflash = 10, nucleus = 11, bind = 12, grow = 13, copy = 14, shared = 15, segment = 16, dflash_blocks = 17, keep_lanes = 18, chunk_lanes = 19 };
+
+/// TF_GLM_DRAFTER_DIR: the DFlash2 draft model's snapshot folder (v1.8's DRAFTER=dflash2); unset: the MTP head drafts.
+pub fn drafterDir() ?[]const u8 {
+    const v = std.c.getenv("TF_GLM_DRAFTER_DIR") orelse return null;
+    const s = std.mem.span(v);
+    return if (s.len == 0) null else s;
+}
+
+/// `begin` without a kept state: the pass starts at 0.
+pub const no_snapshot: u32 = 0xFFFF_FFFF;
+
+/// Where a draft's hidden rows come from: the prompt's last row, or the last verify's first rows.
+pub const From = enum(u32) { prompt = 0, verify = 1 };
+
+pub const Node = struct {
+    gpa: std.mem.Allocator,
+    rank: u32,
+    stream: cuda.Stream,
+    lib: cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    pair: cuda.Pair,
+    w: wt.Weights,
+    set: cuda.aot.Set,
+    k: kern.Kernels,
+    e: Engine,
+    words: std.ArrayList(u32) = .empty,
+    prompts: [Engine.max_lanes]std.ArrayList(u32) = @splat(.empty), // each lane's begun prompt, which `chunk` and `chunkLanes` read
+    mtp: bool = false,
+    roce: ?*roce_mod.Roce = null,
+    dflash: ?dflash.Drafter = null, // the bound lane's DFlash2 context (bind swaps it with `drafters`)
+    drafters: [Engine.max_lanes]?dflash.Drafter = @splat(null), // every other lane's
+    batch: ?dflash.Batch = null, // several lanes' block passes at once (dflashBlocks), with two lanes or more
+    snaps: std.AutoHashMapUnmanaged(u32, cuda.DeviceBuffer) = .empty, // kept prompt states by id, this rank's half
+
+    /// Both ranks: the TCP pair (rank 0 listens on `port`), NCCL, the rank's weights, kernels and engine state.
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: []const u8, context: usize, rank: u32, master: []const u8, port: u16) !*Node {
+        const d = ctx.d;
+        const n = try gpa.create(Node);
+        errdefer gpa.destroy(n);
+        n.gpa = gpa;
+        n.rank = rank;
+        n.words = .empty;
+        n.prompts = @splat(.empty);
+        n.mtp = false;
+        n.snaps = .empty;
+        n.drafters = @splat(null);
+        n.batch = null;
+        n.stream = try cuda.Stream.init(d, true);
+        errdefer n.stream.deinit();
+        n.lib = try cuda.nccl.Library.open();
+        errdefer n.lib.close();
+        n.pair = if (rank == 0) try cuda.Pair.listen(port) else try cuda.Pair.connect(master, port, 1800);
+        errdefer n.pair.close();
+        // both ranks must have been started with the same window and the same TF_GLM_DENSE (their all-gathered partials
+        // would mix 4-bit and BF16 projections)
+        // and the same row split (TF_GLM_HC_SPLIT / TF_GLM_PREFILL_OVERLAP: one rank's swaps would wait on the other's forever)
+        var mine = [5]u32{ @intCast(context), 0x474c4d31, @intFromEnum(try wt.denseKind()), @intFromBool(drafterDir() != null), (try fwd.SplitSettings.fromEnv()).code() };
+        var theirs: [5]u32 = undefined;
+        if (rank == 0) {
+            try n.pair.send(std.mem.sliceAsBytes(&mine));
+            try n.pair.recv(std.mem.sliceAsBytes(&theirs));
+        } else {
+            try n.pair.recv(std.mem.sliceAsBytes(&theirs));
+            try n.pair.send(std.mem.sliceAsBytes(&mine));
+        }
+        if (!std.mem.eql(u32, &mine, &theirs)) {
+            std.log.err("the two GLM ranks were started with different settings: window {d} here, {d} on the other rank; TF_GLM_DENSE {t} here, kind {d} there; row split {x} here, {x} there", .{ mine[0], theirs[0], try wt.denseKind(), theirs[2], mine[4], theirs[4] });
+            return error.RankSettingsDiffer;
+        }
+        var id: cuda.nccl.UniqueId = undefined;
+        if (rank == 0) {
+            try n.lib.check(n.lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId");
+            try n.pair.send(&id.internal);
+        } else try n.pair.recv(&id.internal);
+        n.comm = null;
+        try n.lib.check(n.lib.api.ncclCommInitRank(&n.comm, wt.world, id, @intCast(rank)), "ncclCommInitRank");
+        errdefer _ = n.lib.api.ncclCommDestroy(n.comm);
+
+        const cfg_path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(cfg_path);
+        const cfg_text = try std.Io.Dir.cwd().readFileAlloc(io, cfg_path, gpa, .limited(1 << 22));
+        defer gpa.free(cfg_text);
+        const cfg = try glm_config.parse(gpa, cfg_text);
+        n.k = try kern.Kernels.load(d);
+        errdefer n.k.deinit();
+        n.roce = null;
+        const comm_mode = try roce_mod.mode(.auto);
+        if (comm_mode != .nccl) n.roce = roce_mod.Roce.init(gpa, d, &n.k, n.pair, rank, roce_mod.maxBytes()) catch |err| blk: {
+            if (comm_mode == .roce) return err;
+            std.log.warn("RoCE all-gather unavailable ({t}); NCCL carries every gather (TF_GLM_COMM=nccl silences this)", .{err});
+            break :blk null;
+        };
+        errdefer if (n.roce) |r| r.deinit();
+        if (n.roce != null) std.log.info("RoCE all-gathers up to {d} KiB a rank; larger ones over NCCL (TF_GLM_COMM, TF_ROCE_MAX_KB)", .{roce_mod.maxBytes() >> 10});
+        const draft_dir = drafterDir();
+        n.w = try wt.load(gpa, io, d, .{ .d = d, .s = n.stream }, &n.k, dir, cfg, rank, draft_dir == null); // DFlash2 and the MTP head are not loaded together (TF_GLM_MTP=auto)
+        errdefer n.w.deinit(gpa);
+        n.dflash = null;
+        if (draft_dir) |dd| try wt.loadDraft(gpa, io, d, .{ .d = d, .s = n.stream }, &n.k, &n.w, dd, rank, rank == 0);
+        n.set = try cuda.aot.Set.load(gpa, io, d, ctx.device, kernels);
+        errdefer n.set.deinit();
+        const long_context = context > fwd.denseLimit(&n.w);
+        n.e = try Engine.init(&n.w, d, n.stream, .{ .set = &n.set, .s = n.stream }, &n.k, .{ .lib = &n.lib, .comm = n.comm, .roce = n.roce }, context + Engine.max_rows, long_context, if (n.w.draft) |dr| dr.taps else null);
+        errdefer n.e.deinit();
+        if (n.w.draft != null) n.dflash = try dflash.Drafter.init(gpa, d, &n.w, context + Engine.max_rows);
+        return n;
+    }
+
+    pub fn deinit(n: *Node) void {
+        var it = n.snaps.valueIterator();
+        while (it.next()) |b| b.free();
+        n.snaps.deinit(n.gpa);
+        for (&n.prompts) |*pr| pr.deinit(n.gpa);
+        if (n.dflash) |*dr| dr.deinit();
+        for (&n.drafters) |*slot| if (slot.*) |*dr| dr.deinit();
+        if (n.batch) |*b| b.deinit();
+        n.e.deinit();
+        if (n.roce) |r| r.deinit();
+        n.k.deinit();
+        n.set.deinit();
+        n.w.deinit(n.gpa);
+        _ = n.lib.api.ncclCommDestroy(n.comm);
+        n.pair.close();
+        n.lib.close();
+        n.stream.deinit();
+        n.words.deinit(n.gpa);
+        n.gpa.destroy(n);
+    }
+
+    /// Rank 0: the command's words to rank 1 (kind, count, then the words).
+    fn send(n: *Node, kind: Kind, words: []const u32) !void {
+        if (n.rank != 0) return;
+        const head = [2]u32{ @backingInt(kind), @intCast(words.len) };
+        try n.pair.send(std.mem.sliceAsBytes(&head));
+        try n.pair.send(std.mem.sliceAsBytes(words));
+    }
+
+    // -- the commands (rank 0 sends, both run) ------------------------------------------------------------------
+    /// The prompt's caches in chunks of up to Engine.prefill_rows from 0, then its first token (`first`).
+    pub fn prefill(n: *Node, prompt: []const u32, mtp: bool, k: usize) !u32 {
+        try n.begin(prompt, mtp, no_snapshot, 0);
+        var at: usize = 0;
+        while (at < prompt.len) {
+            const rows = @min(prompt.len - at, Engine.prefill_rows);
+            try n.chunk(at, rows);
+            at += rows;
+        }
+        return n.first(k);
+    }
+
+    /// A prompt pass starts: from 0, or from kept state `snap` after `at` tokens (the attention caches' rows below
+    /// `at` must still hold the prompt's tokens; the caller checks). The MTP head absorbs the prompt too when `mtp`.
+    pub fn begin(n: *Node, prompt: []const u32, mtp: bool, snap: u32, at: usize) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.appendSlice(n.gpa, &.{ @intFromBool(mtp), snap, @intCast(at) });
+        try n.words.appendSlice(n.gpa, prompt);
+        try n.send(.begin, n.words.items);
+        const mine = &n.prompts[n.e.lane];
+        mine.clearRetainingCapacity();
+        try mine.appendSlice(n.gpa, prompt);
+        n.mtp = mtp;
+        if (snap == no_snapshot) {
+            try n.e.reset();
+            if (n.dflash) |*dr| try dr.reset(&n.e);
+            return;
+        }
+        const b = n.snaps.get(snap) orelse return error.NoSuchSnapshot;
+        try n.e.restoreState(b.ptr, at);
+        if (n.dflash) |*dr| try dr.restore(&n.e, b.ptr + n.e.snapshotBytes(), at);
+    }
+
+    /// The begun prompt's rows at .. at + rows, at the state's position.
+    pub fn chunk(n: *Node, at: usize, rows: usize) !void {
+        try n.send(.chunk, &.{ @intCast(at), @intCast(rows) });
+        try dec.prefillChunk(&n.e, n.prompts[n.e.lane].items, at, rows, n.mtp, if (n.dflash) |*dr| dr else null);
+    }
+
+    /// One prompt chunk over several begun lanes' next rows (multi_prefill.prefill_pieces; rank 0 sends it, both run it):
+    /// `items` (lane, at, rows), each piece at the next multiple of 64 rows of the prompt buffers; then per piece its taps
+    /// into its lane's DFlash2 context and its lane's commit. Not with the MTP head (its cache is not grouped).
+    pub fn chunkLanes(n: *Node, items: []const [3]usize) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.append(n.gpa, @intCast(items.len));
+        for (items) |it| try n.words.appendSlice(n.gpa, &.{ @intCast(it[0]), @intCast(it[1]), @intCast(it[2]) });
+        try n.send(.chunk_lanes, n.words.items);
+        if (n.mtp or items.len > Engine.max_lanes) return error.BadChunk;
+        var pieces: [Engine.max_lanes]Engine.Piece = undefined;
+        var ids: [Engine.prefill_rows]u32 = undefined;
+        var at: usize = 0;
+        for (items, 0..) |it, i| {
+            const lane = it[0];
+            if (lane >= n.e.n_lanes) return error.NoSuchLane;
+            const prompt = n.prompts[lane].items;
+            if (it[2] == 0 or it[1] + it[2] > prompt.len or n.e.laneState(lane).pos != it[1]) return error.ChunkOutOfStep;
+            const lo = std.mem.alignForward(usize, at, 64);
+            if (lo + it[2] > ids.len) return error.BadChunk;
+            @memset(ids[at..lo], 0);
+            @memcpy(ids[lo..][0..it[2]], prompt[it[1]..][0..it[2]]);
+            pieces[i] = .{ .lane = lane, .rows = it[2], .lo = lo };
+            at = lo + it[2];
+        }
+        try n.e.prefillPieces(pieces[0..items.len], ids[0..at]);
+        for (pieces[0..items.len]) |pc| {
+            try n.bind(pc.lane);
+            if (n.dflash) |*dr| { // the piece's rows of the taps (the row0 offset dflashRun takes)
+                var b = n.e.pbuf;
+                for (&b.taps) |*t| if (t.* != 0) {
+                    t.* += pc.lo * n.e.w.cfg.hidden * 2;
+                };
+                try dr.addTaps(&n.e, &b, pc.rows);
+            }
+            try n.e.commitChunk(pc.rows);
+        }
+    }
+
+    /// The first token after the prompt's last chunk. k 0: greedy, the token returned; else the last row's k
+    /// candidates a rank gathered (Engine.cand_host), or both ranks' whole rows (whole_vocabulary).
+    pub fn first(n: *Node, k: usize) !u32 {
+        try n.send(.first, &.{@intCast(k)});
+        return n.pick(n.e.st.last_logits, 1, k, null);
+    }
+
+    /// Keep the state between prompt chunks as `id` (each rank its half).
+    pub fn save(n: *Node, id: u32) !void {
+        try n.send(.save, &.{id});
+        errdefer n.drop(id); // rank 0 failed: rank 1 frees its half too
+        var b = try cuda.DeviceBuffer.alloc(n.e.d, n.snapshotBytes());
+        errdefer b.free();
+        try n.e.saveState(b.ptr);
+        if (n.dflash) |*dr| try dr.save(&n.e, b.ptr + n.e.snapshotBytes());
+        try n.stream.synchronize(); // the copy is whole before a later chunk changes the state
+        try n.snaps.put(n.gpa, id, b);
+    }
+
+    /// A kept prompt state's bytes on this rank: the engine's, and DFlash2's ring.
+    pub fn snapshotBytes(n: *const Node) usize {
+        return n.e.snapshotBytes() + if (n.dflash) |*dr| dr.stateBytes() else 0;
+    }
+
+    /// DFlash2's turn (rank 0 sends it, both run it): from .verify the first `keep` rows of the last window join its context
+    /// (their taps); then, with `block`, the block pass for `pending`, whose merged candidates rank 0 reads back (`chainOf`).
+    pub fn dflashTurn(n: *Node, from: From, kept: usize, pending: u32, block: bool) !void {
+        try n.send(.dflash, &.{ @backingInt(from), @intCast(kept), pending, @intFromBool(block) });
+        try n.dflashRun(from, kept, pending, block);
+    }
+
+    /// Lane `lane`'s DFlash2 drafter (the bound lane's is `dflash`).
+    pub fn drafterOf(n: *Node, lane: usize) !*dflash.Drafter {
+        if (lane == n.e.lane) return &(n.dflash orelse return error.NoDraftModel);
+        return &(n.drafters[lane] orelse return error.NoDraftModel);
+    }
+
+    /// The block passes of `lanes` (each at its context's end, `pend` its pending token) in one pass (dflash.Batch.blocks;
+    /// rank 0 sends it, both run it, rank 0 reads the candidates back into each lane's drafter).
+    pub fn dflashBlocks(n: *Node, lanes: []const usize, pend: []const u32) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.append(n.gpa, @intCast(lanes.len));
+        for (lanes) |l| try n.words.append(n.gpa, @intCast(l));
+        try n.words.appendSlice(n.gpa, pend);
+        try n.send(.dflash_blocks, n.words.items);
+        var ds: [Engine.max_lanes]*dflash.Drafter = undefined;
+        if (lanes.len > Engine.max_lanes) return error.BadDraftBatch;
+        for (lanes, 0..) |l, i| ds[i] = try n.drafterOf(l);
+        const b = &(n.batch orelse return error.NoDraftBatch);
+        try b.blocks(&n.e, ds[0..lanes.len], pend, n.rank == 0);
+    }
+
+    fn dflashRun(n: *Node, from: From, kept: usize, pending: u32, block: bool) !void {
+        const dr = &(n.dflash orelse return error.NoDraftModel);
+        if (from == .verify) { // the lane's rows of the last window
+            var b = n.e.buf;
+            for (&b.taps) |*t| if (t.* != 0) {
+                t.* += n.e.st.row0 * n.e.w.cfg.hidden * 2;
+            };
+            try dr.addTaps(&n.e, &b, kept);
+        }
+        if (block and dr.context_end > 0) try dr.block(&n.e, pending, n.rank == 0);
+    }
+
+    pub fn drop(n: *Node, id: u32) void {
+        n.send(.drop, &.{id}) catch {};
+        if (n.snaps.fetchRemove(id)) |kv| {
+            var b = kv.value;
+            b.free();
+        }
+    }
+
+    /// A window's forward: each row's greedy token into `out` (k 0), or each row's k candidates a rank gathered.
+    pub fn verify(n: *Node, rows: []const u32, k: usize, out: []u32) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.append(n.gpa, @intCast(k));
+        try n.words.appendSlice(n.gpa, rows);
+        try n.send(.verify, n.words.items);
+        try n.e.forward(rows);
+        _ = try n.pick(n.e.buf.logits, rows.len, k, out);
+    }
+
+    /// A `k` asking for a draw over the vocabulary (sampling.nucleus_rows, or a top_k past the candidates a rank gives): the
+    /// forward leaves its rows' logits where they are and the draw's `nucleus` commands follow.
+    pub const whole_vocabulary: usize = Engine.max_k + 1;
+
+    /// Which rows a `nucleus` command reads: the last window's, or the prompt's last row.
+    pub const Rows = enum(u32) { window = 0, last = 1 };
+
+    /// The draw's gather (rank 0 sends it, both run it): `count` > 0: Engine.nucleusGather's candidates; 0: every rank's whole rows
+    /// (Engine.fullRows, into Engine.full_host). The words are valid until the next call.
+    pub fn nucleus(n: *Node, which: Rows, rows: usize, temperature: f64, count: usize) ![]const u64 {
+        const t: u64 = @bitCast(temperature);
+        try n.send(.nucleus, &.{ @backingInt(which), @intCast(rows), @intCast(count), @truncate(t), @truncate(t >> 32) });
+        return n.nucleusRun(which, rows, temperature, count);
+    }
+
+    fn nucleusRun(n: *Node, which: Rows, rows: usize, temperature: f64, count: usize) ![]const u64 {
+        const logits = switch (which) {
+            .window => n.e.buf.logits + n.e.st.row0 * n.e.w.head.n * 2, // the bound lane's rows of the window
+            .last => n.e.st.last_logits,
+        };
+        if (count == 0) {
+            _ = try n.e.fullRows(logits, rows);
+            return &.{};
+        }
+        return n.e.nucleusGather(logits, rows, temperature, count);
+    }
+
+    fn pick(n: *Node, logits: u64, rows: usize, k: usize, out: ?[]u32) !u32 {
+        if (k == whole_vocabulary) return 0; // the draw's own commands (`nucleus`) read the rows
+        if (k > 0) {
+            try n.e.candidates(&n.e.buf, logits, rows, k);
+            return 0;
+        }
+        var one: [Engine.max_rows]u32 = undefined;
+        const dst = out orelse one[0..rows];
+        try n.e.greedy(&n.e.buf, logits, rows, n.e.w.head.n, dst);
+        return dst[0];
+    }
+
+    /// Commit the last window's first `keep` of its `rows` rows.
+    pub fn keep(n: *Node, rows: usize, kept: usize) !void {
+        try n.send(.keep, &.{ @intCast(rows), @intCast(kept) });
+        try n.e.commit(rows, kept);
+    }
+
+    /// keep for several lanes of the last shared window at once (Engine.commitSegs).
+    pub fn keepLanes(n: *Node, items: []const Engine.Keep) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.append(n.gpa, @intCast(items.len));
+        for (items) |it| try n.words.appendSlice(n.gpa, &.{ @intCast(it.lane), @intCast(it.rows), @intCast(it.keep) });
+        try n.send(.keep_lanes, n.words.items);
+        var segs: [Engine.max_lanes]Engine.Keep = undefined;
+        var m: usize = 0;
+        for (items) |it| {
+            if (it.lane < n.e.n_lanes and n.e.laneState(it.lane).seg) {
+                segs[m] = it;
+                m += 1;
+                continue;
+            }
+            try n.bind(it.lane); // a window it ran alone: its own commit
+            try n.e.commit(it.rows, it.keep);
+        }
+        try n.e.commitSegs(segs[0..m]);
+    }
+
+    /// Absorb (hidden row, following token) pairs and draft `out.len` tokens.
+    pub fn draft(n: *Node, from: From, next: []const u32, out: []u32) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.appendSlice(n.gpa, &.{ @backingInt(from), @intCast(out.len) });
+        try n.words.appendSlice(n.gpa, next);
+        try n.send(.draft, n.words.items);
+        const hidden = switch (from) {
+            .prompt => n.e.st.last_hidden,
+            .verify => n.e.buf.fnormed + n.e.st.row0 * n.e.w.cfg.hidden * 2, // the lane's rows of the window
+        };
+        try dec.draft(&n.e, hidden, next, out.len, out);
+    }
+
+    /// Several lanes' windows in one forward (Engine.forwardShared): `segs` in order, `ids` their rows back to back. Each
+    /// segment's tokens are then picked with `pickSegment` (and drawn with `nucleus` after binding its lane), in order.
+    pub fn verifyShared(n: *Node, segs: []const Engine.Seg, ids: []const u32) !void {
+        n.words.clearRetainingCapacity();
+        try n.words.append(n.gpa, @intCast(segs.len));
+        for (segs) |g| try n.words.appendSlice(n.gpa, &.{ @intCast(g.lane), @intCast(g.rows) });
+        try n.words.appendSlice(n.gpa, ids);
+        try n.send(.shared, n.words.items);
+        try n.e.forwardShared(segs, ids);
+    }
+
+    /// Segment `g`'s rows of the last shared window (rank 0 sends it, both run it): each row's greedy token into `out`
+    /// (k 0), or its k candidates a rank gathered (Engine.cand_host), as `verify`.
+    pub fn pickSegment(n: *Node, g: Engine.Seg, k: usize, out: []u32) !void {
+        try n.send(.segment, &.{ @intCast(g.lane), @intCast(g.rows), @intCast(k) });
+        const row0 = n.e.laneState(g.lane).row0;
+        _ = try n.pick(n.e.buf.logits + row0 * n.e.w.head.n * 2, g.rows, k, out);
+    }
+
+    /// Later commands act on lane `lane`'s state and DFlash2 context (sent only when the lane changes).
+    pub fn bind(n: *Node, lane: usize) !void {
+        if (lane == n.e.lane) return;
+        try n.send(.bind, &.{@intCast(lane)});
+        const from = n.e.lane;
+        try n.e.bind(lane);
+        n.drafters[from] = n.dflash;
+        n.dflash = n.drafters[lane];
+        n.drafters[lane] = null;
+    }
+
+    /// One more lane's device bytes: its caches, and its DFlash2 context's.
+    pub fn laneBytes(n: *const Node) usize {
+        return n.e.laneBytes() + if (n.dflash) |*dr| dr.mem.len else 0;
+    }
+
+    /// Lanes up to `total` on both ranks, each with its own DFlash2 context when drafting with it: how many both have
+    /// (rank 1 answers with its count).
+    pub fn grow(n: *Node, total: usize) !usize {
+        try n.send(.grow, &.{@intCast(total)});
+        const had = n.e.n_lanes;
+        var mine = try n.e.addLanes(total);
+        if (n.dflash) |*bound| for (had..mine) |i| {
+            n.drafters[i] = dflash.Drafter.init(n.gpa, n.e.d, &n.w, bound.capacity) catch {
+                mine = i; // the lanes past it serve no stream
+                break;
+            };
+        };
+        if (n.dflash != null and mine > 1) {
+            n.batch = try dflash.Batch.init(n.gpa, n.e.d, &n.w, mine);
+            var ds: [Engine.max_lanes]*dflash.Drafter = undefined;
+            for (0..mine) |i| ds[i] = try n.drafterOf(i);
+            try n.batch.?.adopt(&n.e, ds[0..mine]);
+        }
+        var word = [1]u32{@intCast(mine)};
+        if (n.rank != 0) {
+            try n.pair.send(std.mem.sliceAsBytes(&word));
+            return mine;
+        }
+        try n.pair.recv(std.mem.sliceAsBytes(&word));
+        return @min(mine, word[0]);
+    }
+
+    /// Lane `src`'s attention-cache rows below `rows` into lane `dst` (Engine.copyLaneRows). DFlash2's context comes
+    /// whole with the kept state `begin` restores, so it is not copied.
+    pub fn copy(n: *Node, src: usize, dst: usize, rows: usize) !void {
+        try n.send(.copy, &.{ @intCast(src), @intCast(dst), @intCast(rows) });
+        try n.e.copyLaneRows(src, dst, rows);
+    }
+
+    pub fn quit(n: *Node) void {
+        n.send(.quit, &.{}) catch {};
+    }
+
+    /// Rank 1: run rank 0's commands until it quits or the link closes.
+    pub fn follow(n: *Node) !void {
+        var buf: std.ArrayList(u32) = .empty;
+        defer buf.deinit(n.gpa);
+        var scratch: [Engine.max_rows]u32 = undefined;
+        while (true) {
+            var head: [2]u32 = undefined;
+            n.pair.recv(std.mem.sliceAsBytes(&head)) catch |e| switch (e) {
+                error.PeerClosed => return,
+                else => return e,
+            };
+            try buf.resize(n.gpa, head[1]);
+            try n.pair.recv(std.mem.sliceAsBytes(buf.items));
+            const w = buf.items;
+            switch (@as(Kind, @fromBackingInt(@intCast(head[0])))) {
+                .begin => try n.begin(w[3..], w[0] != 0, w[1], w[2]),
+                .chunk => try n.chunk(w[0], w[1]),
+                .first => _ = try n.first(w[0]),
+                .save => try n.save(w[0]),
+                .drop => n.drop(w[0]),
+                .verify => try n.verify(w[1..], w[0], scratch[0 .. w.len - 1]),
+                .keep => try n.keep(w[0], w[1]),
+                .draft => try n.draft(@fromBackingInt(@intCast(w[0])), w[2..], scratch[0..w[1]]),
+                .dflash => try n.dflashRun(@fromBackingInt(@intCast(w[0])), w[1], w[2], w[3] != 0),
+                .nucleus => _ = try n.nucleusRun(@fromBackingInt(@intCast(w[0])), w[1], @bitCast(@as(u64, w[3]) | (@as(u64, w[4]) << 32)), w[2]),
+                .shared => {
+                    const m = w[0];
+                    var segs: [Engine.max_lanes]Engine.Seg = undefined;
+                    if (m > Engine.max_lanes) return error.TooManySegments;
+                    for (0..m) |i| segs[i] = .{ .lane = w[1 + 2 * i], .rows = w[2 + 2 * i] };
+                    try n.verifyShared(segs[0..m], w[1 + 2 * m ..]);
+                },
+                .segment => try n.pickSegment(.{ .lane = w[0], .rows = w[1] }, w[2], scratch[0..w[1]]),
+                .dflash_blocks => {
+                    const m = w[0];
+                    if (m > Engine.max_lanes) return error.BadDraftBatch;
+                    var ls: [Engine.max_lanes]usize = undefined;
+                    for (0..m) |i| ls[i] = w[1 + i];
+                    try n.dflashBlocks(ls[0..m], w[1 + m ..][0..m]);
+                },
+                .keep_lanes => {
+                    const m = w[0];
+                    var items: [Engine.max_lanes]Engine.Keep = undefined;
+                    if (m > Engine.max_lanes) return error.TooManySegments;
+                    for (0..m) |i| items[i] = .{ .lane = w[1 + 3 * i], .rows = w[2 + 3 * i], .keep = w[3 + 3 * i] };
+                    try n.keepLanes(items[0..m]);
+                },
+                .chunk_lanes => {
+                    const m = w[0];
+                    var items: [Engine.max_lanes][3]usize = undefined;
+                    if (m > Engine.max_lanes) return error.BadChunk;
+                    for (0..m) |i| items[i] = .{ w[1 + 3 * i], w[2 + 3 * i], w[3 + 3 * i] };
+                    try n.chunkLanes(items[0..m]);
+                },
+                .bind => try n.bind(w[0]),
+                .grow => _ = try n.grow(w[0]),
+                .copy => try n.copy(w[0], w[1], w[2]),
+                .quit => return,
+            }
+        }
+    }
+};
diff --git a/zig/src/families/glm/cuda/glm_roce.zig b/zig/src/families/glm/cuda/glm_roce.zig
new file mode 100644
index 0000000..a675bcb
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_roce.zig
@@ -0,0 +1,254 @@
+//! TF_GLM_COMM=roce (v1.10's default, patch 0006 and b12x's "RoCEnante"): small all-gathers over the Sparks' link as one-shot RDMA
+//! writes instead of NCCL's ~30-50 us of fixed latency. The GB10 GPU writes its shard into pinned host memory the ConnectX-7
+//! RDMA-writes to the peer (roce_proxy.c's thread, unchanged), and reads the peer's shard from its own pinned memory in
+//! place (glm_roce.cu): one kernel, a device-side epoch so CUDA graphs replay it. Gathers of up to TF_ROCE_MAX_KB (default
+//! 512) KiB a rank whose size is a multiple of 16 bytes go this way, the rest through NCCL, with the same layout (rank order)
+//! and bits. libibverbs is opened by dlopen (roce_dl.c); the two ranks swap their connection blobs over the TCP pair.
+const std = @import("std");
+const cuda = @import("cuda");
+const kern = @import("glm_kernels.zig");
+
+extern "c" fn roce_dl_open() c_int;
+extern "c" fn roce_abi_version() c_int;
+extern "c" fn roce_layout(world: c_int, slot_bytes: u64, out: *[7]u64) c_int;
+extern "c" fn roce_blob_bytes() u64;
+extern "c" fn roce_create(world: c_int, rank: c_int, names: [*]const [*:0]const u8, n_hca: c_int, gids: [*]const c_int, tc: c_int, region: ?*anyopaque, region_bytes: u64, slot_bytes: u64, err: [*]u8, err_len: u64) ?*anyopaque;
+extern "c" fn roce_local_blob(c: ?*anyopaque, out: [*]u8, len: u64) c_int;
+extern "c" fn roce_connect(c: ?*anyopaque, blobs: [*]const u8, len: u64) c_int;
+extern "c" fn roce_start(c: ?*anyopaque) c_int;
+extern "c" fn roce_stop(c: ?*anyopaque) void;
+extern "c" fn roce_failed(c: ?*anyopaque) c_int;
+extern "c" fn roce_error(c: ?*anyopaque) [*:0]const u8;
+extern "c" fn roce_destroy(c: ?*anyopaque) void;
+
+const slot_align = 4096;
+const pack = 16;
+const threads = 512;
+const blocks = 8; // the largest grid; smaller shards launch fewer (power-of-two) blocks
+const classes = 4; // blocks.bit_length()
+const world = 2;
+
+/// TF_GLM_COMM: `nccl` all NCCL, `roce` required (a setup failure is an error), unset: RoCE when the HCAs are named and the
+/// setup works on both ranks, else NCCL.
+pub const Mode = enum { nccl, roce, auto };
+
+pub fn mode(default: Mode) !Mode {
+    const v = std.c.getenv("TF_GLM_COMM") orelse return default;
+    const s = std.mem.trim(u8, std.mem.span(v), " ");
+    if (s.len == 0) return default;
+    if (std.mem.eql(u8, s, "nccl")) return .nccl;
+    if (std.mem.eql(u8, s, "roce")) return .roce;
+    if (std.mem.eql(u8, s, "auto")) return .auto;
+    std.log.err("TF_GLM_COMM is nccl, roce or auto, not {s}", .{s});
+    return error.BadComm;
+}
+
+fn envInt(name: [*:0]const u8) ?i64 {
+    const v = std.c.getenv(name) orelse return null;
+    const s = std.mem.trim(u8, std.mem.span(v), " ");
+    if (s.len == 0) return null;
+    return std.fmt.parseInt(i64, s, 0) catch null;
+}
+
+/// TF_ROCE_MAX_KB (the recipe's default 512): the largest gather a rank sends over RoCE.
+pub fn maxBytes() usize {
+    const v = envInt("TF_ROCE_MAX_KB") orelse 512;
+    return @intCast(std.math.clamp(v, 1, 4096) << 10);
+}
+
+pub const Roce = struct {
+    gpa: std.mem.Allocator,
+    ctx: ?*anyopaque,
+    region: cuda.HostBuffer,
+    counters: cuda.DeviceBuffer,
+    gather_fn: cuda.Function,
+    max_bytes: usize,
+    slot_bytes: usize,
+    flag_stride: usize,
+    slots: usize,
+    n_hca: usize,
+    spin: u32,
+    rank: u32,
+    base: u64, // the region's device address
+    recv: u64,
+    flag: u64,
+    send: u64,
+    ctrl: u64,
+    ctrl_words: [*]volatile u32,
+
+    /// Both ranks' HCAs, pinned region and proxy threads, connected through `pair` (rank 0 sends first). Every failure after the
+    /// first exchange is agreed on by both ranks.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, k: *const kern.Kernels, pair: cuda.Pair, rank: u32, max_bytes: usize) !*Roce {
+        var r = try gpa.create(Roce);
+        errdefer gpa.destroy(r);
+        r.gpa = gpa;
+        r.ctx = null;
+        r.rank = rank;
+        r.max_bytes = max_bytes;
+        r.gather_fn = k.roce_gather;
+        r.slot_bytes = (max_bytes + slot_align - 1) / slot_align * slot_align;
+        var layout: [7]u64 = undefined;
+        if (roce_layout(world, r.slot_bytes, &layout) != 0) return error.RoceLayout;
+        const total: usize = @intCast(layout[4]);
+        r.flag_stride = @intCast(layout[5]);
+        r.slots = @intCast(layout[6]);
+        r.region = try cuda.HostBuffer.allocMapped(d, total);
+        errdefer r.region.free();
+        @memset(r.region.bytes, 0); // flags and ctrl start at 0
+        r.base = try r.region.device();
+        r.recv = r.base + layout[0];
+        r.flag = r.base + layout[1];
+        r.send = r.base + layout[2];
+        r.ctrl = r.base + layout[3];
+        r.ctrl_words = @ptrCast(@alignCast(r.region.bytes.ptr + layout[3]));
+        r.counters = try cuda.DeviceBuffer.alloc(d, (2 + 2 * classes) * 4);
+        errdefer r.counters.free();
+        try r.counters.fill8(0, null);
+        const wait_s: f64 = if (std.c.getenv("TF_ROCE_WAIT_S")) |v| (std.fmt.parseFloat(f64, std.mem.span(v)) catch 300.0) else 300.0;
+        r.spin = @intFromFloat(@min(@max(wait_s, 1.0), 3600.0) * 1e6);
+
+        // the local side: the HCAs, their queue pairs and the connection blob
+        var err: [512]u8 = undefined;
+        @memset(&err, 0);
+        var failed: u32 = 0;
+        var hca_names: [world][64:0]u8 = undefined;
+        var name_ptrs: [world][*:0]const u8 = undefined;
+        var n_hca: usize = 0;
+        const raw = std.c.getenv("TF_ROCE_HCA") orelse std.c.getenv("NCCL_IB_HCA");
+        if (raw) |text| {
+            var it = std.mem.splitScalar(u8, std.mem.span(text), ',');
+            while (it.next()) |part| {
+                var name = std.mem.trim(u8, part, " =^");
+                if (std.mem.indexOfScalar(u8, name, ':')) |c| name = name[0..c];
+                if (name.len == 0 or name.len >= 64 or n_hca == world) continue;
+                @memcpy(hca_names[n_hca][0..name.len], name);
+                hca_names[n_hca][name.len] = 0;
+                name_ptrs[n_hca] = &hca_names[n_hca];
+                n_hca += 1;
+            }
+        }
+        const blob_len: usize = @intCast(roce_blob_bytes());
+        const blob_mem = try gpa.alloc(u8, 2 * blob_len);
+        defer gpa.free(blob_mem);
+        @memset(blob_mem, 0);
+        const mine = blob_mem[0..blob_len];
+        if (n_hca == 0) {
+            failed = 1;
+            _ = std.fmt.bufPrint(&err, "no HCA named (TF_ROCE_HCA or NCCL_IB_HCA)", .{}) catch {};
+        } else if (roce_dl_open() == 0) {
+            failed = 1;
+            _ = std.fmt.bufPrint(&err, "libibverbs.so.1 does not load", .{}) catch {};
+        } else if (roce_abi_version() != 5) {
+            failed = 1;
+            _ = std.fmt.bufPrint(&err, "unexpected RoCE proxy ABI version", .{}) catch {};
+        } else {
+            const gid: c_int = @intCast(envInt("TF_ROCE_GID_INDEX") orelse envInt("NCCL_IB_GID_INDEX") orelse 3);
+            const tc: c_int = @intCast(envInt("NCCL_IB_TC") orelse 0);
+            var gids: [world]c_int = @splat(gid);
+            r.ctx = roce_create(world, @intCast(rank), &name_ptrs, @intCast(n_hca), &gids, tc, r.region.bytes.ptr, total, r.slot_bytes, &err, err.len);
+            if (r.ctx == null or roce_local_blob(r.ctx, mine.ptr, blob_len) != 0) failed = 1;
+        }
+        r.n_hca = n_hca;
+
+        // both ranks' verdict and geometry, and the blobs
+        const head_mine = [4]u32{ failed, @intCast(n_hca), @intCast(r.slot_bytes >> 12), @intCast(r.flag_stride) };
+        var head_theirs: [4]u32 = undefined;
+        const theirs = blob_mem[blob_len..];
+        try swap(pair, rank, std.mem.asBytes(&head_mine), std.mem.asBytes(&head_theirs));
+        try swap(pair, rank, mine, theirs);
+        const same = head_mine[1] == head_theirs[1] and head_mine[2] == head_theirs[2] and head_mine[3] == head_theirs[3];
+        if (failed != 0 or head_theirs[0] != 0 or !same) {
+            const why: []const u8 = if (failed != 0) std.mem.sliceTo(&err, 0) else if (!same) "the ranks' RoCE geometry differs" else "the other rank's setup failed";
+            std.log.warn("RoCE all-gather setup failed: {s}", .{why});
+            r.close();
+            return error.RoceSetupFailed;
+        }
+        // rank order: rank 0's blob first
+        if (rank == 1) {
+            const tmp = try gpa.alloc(u8, blob_len);
+            defer gpa.free(tmp);
+            @memcpy(tmp, blob_mem[0..blob_len]);
+            @memcpy(blob_mem[0..blob_len], blob_mem[blob_len..]);
+            @memcpy(blob_mem[blob_len..], tmp);
+        }
+        var ok: u32 = if (roce_connect(r.ctx, blob_mem.ptr, blob_mem.len) == 0 and roce_start(r.ctx) == 0) 0 else 1;
+        var verdict: u32 = undefined;
+        try swap(pair, rank, std.mem.asBytes(&ok), std.mem.asBytes(&verdict));
+        if (ok != 0 or verdict != 0) {
+            std.log.warn("RoCE all-gather could not connect: {s}", .{if (r.ctx != null) std.mem.span(roce_error(r.ctx)) else "no context"});
+            r.close();
+            return error.RoceConnectFailed;
+        }
+        return r;
+    }
+
+    /// Rank 0 sends then receives, rank 1 the other way round.
+    fn swap(pair: cuda.Pair, rank: u32, out: []const u8, in: []u8) !void {
+        if (rank == 0) {
+            try pair.send(out);
+            try pair.recv(in);
+        } else {
+            try pair.recv(in);
+            try pair.send(out);
+        }
+    }
+
+    pub fn close(r: *Roce) void {
+        if (r.ctx != null) {
+            roce_stop(r.ctx);
+            roce_destroy(r.ctx);
+            r.ctx = null;
+        }
+    }
+
+    pub fn deinit(r: *Roce) void {
+        r.close();
+        r.counters.free();
+        r.region.free();
+        r.gpa.destroy(r);
+    }
+
+    /// Whether a gather of `bytes` a rank goes over RoCE (the same answer on every rank).
+    pub fn fits(r: *const Roce, bytes: usize) bool {
+        return bytes > 0 and bytes <= r.max_bytes and bytes % pack == 0;
+    }
+
+    /// RoceGather.all_gather: `bytes` from `send` to every rank's slot of `recv` in rank order; both 16-byte aligned.
+    pub fn gather(r: *Roce, s: cuda.Stream, send: u64, recv: u64, bytes: usize) !void {
+        const packs = bytes / pack;
+        const need = @max(1, (packs + 2 * threads - 1) / (2 * threads));
+        const grid = @min(std.math.ceilPowerOfTwo(usize, need) catch unreachable, blocks);
+        const klass: usize = std.math.log2_int(usize, grid);
+        const c = r.counters.ptr;
+        var a: cuda.Args = .{};
+        a.add(send);
+        a.add(recv);
+        a.add(@as(i32, @intCast(packs)));
+        a.add(@as(u32, @intCast(bytes)));
+        a.add(@as(i32, @intCast(packs)));
+        a.add(r.recv);
+        a.add(r.flag);
+        a.add(r.send);
+        a.add(r.ctrl);
+        a.add(@as(i64, @intCast(r.slot_bytes)));
+        a.add(c);
+        a.add(c + 4 * (1 + klass));
+        a.add(c + 4 * (1 + classes + klass));
+        a.add(c + 4 * (1 + 2 * classes));
+        a.add(r.spin);
+        a.add(@as(i32, world));
+        a.add(@as(i32, @intCast(r.rank)));
+        a.add(@as(i32, @intCast(r.slots)));
+        a.add(@as(i32, @intCast(r.flag_stride)));
+        a.add(@as(i32, @intCast(r.n_hca)));
+        try cuda.launch.launch(r.gather_fn, .{ .grid = .{ .x = @intCast(grid) }, .block = .{ .x = threads } }, s, &a);
+    }
+
+    /// Whether a wait timed out on the GPU or the proxy thread failed.
+    pub fn check(r: *const Roce) !void {
+        if (r.ctrl_words[2] != 0 or (r.ctx != null and roce_failed(r.ctx) != 0)) {
+            std.log.err("RoCE all-gather failed (sequence {d}, peer {d}, hca {d}): {s}", .{ r.ctrl_words[2], r.ctrl_words[3], r.ctrl_words[6], if (r.ctx != null) std.mem.span(roce_error(r.ctx)) else "" });
+            return error.RoceFailed;
+        }
+    }
+};
diff --git a/zig/src/families/glm/cuda/glm_segments.zig b/zig/src/families/glm/cuda/glm_segments.zig
new file mode 100644
index 0000000..3dbe7b3
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_segments.zig
@@ -0,0 +1,87 @@
+//! The device tables of a shared verify window's DSA rows (v1.10 segments.SegRows, without index rings): several lanes'
+//! rows back to back, each lane's per-token caches in its extent of the layer arenas (fwd.Pool, extents at multiples of
+//! fwd.extent tokens; its index keys and gates in the same extent, so ibase = base). The segmented kernels
+//! (latent.seg_*, sparse.seg_*) read these tables; one CUDA graph a window size then covers every mix of lanes.
+const std = @import("std");
+
+/// segments.MAX_SEGS: lanes a window holds at most.
+pub const max_segs = 8;
+/// fwd.Engine.shared_rows: a shared window's rows at most (v1.10's TF_GLM_MULTI_WINDOW default).
+pub const max_rows = 32;
+/// sparse.POOL: tokens a pooled key covers.
+pub const pool = 4;
+/// fwd.extent (segments.EXTENT): a lane's arena extent starts at a multiple of this many tokens.
+pub const extent = 2048;
+/// SegRows.NO_RING: the kernels' ring size without rings (positions stay below it).
+pub const no_ring: i32 = std.math.maxInt(i32);
+
+/// One lane's rows of a window: its extent's first arena row (`base`, a multiple of `extent`), the position of its first
+/// row, and its rows.
+pub const Span = struct { base: usize, pos: usize, rows: usize };
+
+/// SegRows' one int32 table: per row pos, base, seg, sparse, ibase (max_rows each), then per segment seg_start, seg_rows,
+/// seg_pbase, seg_pools (max_segs each).
+pub const SegRows = struct {
+    pub const words = 5 * max_rows + 4 * max_segs;
+    pub const pos_at = 0;
+    pub const base_at = max_rows;
+    pub const seg_at = 2 * max_rows;
+    pub const sparse_at = 3 * max_rows;
+    pub const ibase_at = 4 * max_rows;
+    pub const start_at = 5 * max_rows;
+    pub const rows_at = 5 * max_rows + max_segs;
+    pub const pbase_at = 5 * max_rows + 2 * max_segs;
+    pub const pools_at = 5 * max_rows + 3 * max_segs;
+
+    /// SegRows.fill: the host table of `spans` in window order into `t`; `sparse_from` the first position that attends
+    /// sparsely (null: no index, every row dense). Returns the window's rows.
+    pub fn fill(spans: []const Span, sparse_from: ?usize, t: *[words]i32) !usize {
+        if (spans.len < 1 or spans.len > max_segs) return error.BadSegmentCount;
+        var total: usize = 0;
+        for (spans) |s| total += s.rows;
+        if (total > max_rows) return error.WindowTooWide;
+        @memset(t, 0);
+        var r: usize = 0;
+        for (spans, 0..) |s, i| {
+            if (s.rows < 1 or s.base % extent != 0) return error.BadSegment;
+            for (0..s.rows) |j| {
+                const q = s.pos + j;
+                t[pos_at + r + j] = @intCast(q);
+                t[base_at + r + j] = @intCast(s.base);
+                t[seg_at + r + j] = @intCast(i);
+                t[sparse_at + r + j] = @intFromBool(if (sparse_from) |f| q >= f else false);
+                t[ibase_at + r + j] = @intCast(s.base);
+            }
+            const last = s.pos + s.rows - 1;
+            t[start_at + i] = @intCast(r);
+            t[rows_at + i] = @intCast(s.rows);
+            t[pbase_at + i] = @intCast(s.base / pool);
+            t[pools_at + i] = if (sparse_from) |f| (if (last >= f) @intCast((last + 1) / pool) else 0) else 0;
+            r += s.rows;
+        }
+        return total;
+    }
+
+    /// Whether any row of the table attends sparsely (SegRows.any_sparse).
+    pub fn anySparse(t: *const [words]i32, rows: usize) bool {
+        for (t[sparse_at..][0..rows]) |v| if (v != 0) return true;
+        return false;
+    }
+};
+
+test "SegRows lays two lanes back to back as segments.py does" {
+    var t: [SegRows.words]i32 = undefined;
+    const r = try SegRows.fill(&.{ .{ .base = 0, .pos = 2049, .rows = 3 }, .{ .base = 4096, .pos = 10, .rows = 2 } }, 2051, &t);
+    try std.testing.expectEqual(@as(usize, 5), r);
+    try std.testing.expectEqualSlices(i32, &.{ 2049, 2050, 2051, 10, 11 }, t[SegRows.pos_at..][0..5]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 0, 0, 4096, 4096 }, t[SegRows.base_at..][0..5]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 0, 0, 1, 1 }, t[SegRows.seg_at..][0..5]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 0, 1, 0, 0 }, t[SegRows.sparse_at..][0..5]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 3 }, t[SegRows.start_at..][0..2]);
+    try std.testing.expectEqualSlices(i32, &.{ 3, 2, 0 }, t[SegRows.rows_at..][0..3]);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 1024 }, t[SegRows.pbase_at..][0..2]);
+    try std.testing.expectEqualSlices(i32, &.{ 513, 0 }, t[SegRows.pools_at..][0..2]); // (2051 + 1) / 4; lane 1 dense
+    try std.testing.expect(SegRows.anySparse(&t, r));
+    try std.testing.expectError(error.BadSegment, SegRows.fill(&.{.{ .base = 100, .pos = 0, .rows = 1 }}, null, &t));
+    try std.testing.expectError(error.WindowTooWide, SegRows.fill(&.{ .{ .base = 0, .pos = 0, .rows = 17 }, .{ .base = 2048, .pos = 0, .rows = 16 } }, null, &t));
+}
diff --git a/zig/src/families/glm/cuda/glm_source.zig b/zig/src/families/glm/cuda/glm_source.zig
new file mode 100644
index 0000000..439c60d
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_source.zig
@@ -0,0 +1,163 @@
+//! Checkpoint bytes read with O_DIRECT through io_uring, then copied to the GPU: Nemotron's cuda_source.zig with its
+//! own upload in place of Nemotron's kernel set.
+
+const std = @import("std");
+const linux = std.os.linux;
+const cuda = @import("cuda");
+const core = @import("core");
+const dio = core.direct_io;
+
+/// Bytes a slot holds: one read's span; a larger tensor goes as several reads.
+pub const slot_bytes = 64 << 20;
+/// Slots, and so reads in flight at once: enough to cover the loader's largest allocation.
+pub const slot_count = 4;
+
+const Mapped = struct { base: usize, len: usize, file: dio.File };
+/// A slot's read in flight: `len` bytes from `offset`, landing `at` into the slot, for the GPU at `dst`.
+const Pending = struct { dst: u64, file: dio.File, offset: u64, len: usize, at: usize };
+
+/// The device and the stream the copies go on.
+pub const Ops = struct {
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+
+    pub fn upload(o: Ops, dst: u64, bytes: []const u8) !void {
+        if (bytes.len == 0) return;
+        try o.d.check(o.d.api.cuMemcpyHtoDAsync_v2(dst, bytes.ptr, bytes.len, o.s.handle), "cuMemcpyHtoDAsync");
+        try o.s.synchronize();
+    }
+};
+
+pub const Source = struct {
+    gpa: std.mem.Allocator,
+    ops: Ops,
+    files: std.ArrayList(Mapped) = .empty,
+    slots: [slot_count]dio.Buffer = undefined,
+    pending: [slot_count]?Pending = @splat(null),
+    in_flight: usize = 0,
+    ring: ?linux.IoUring = null, // null where io_uring is unavailable: each read then completes as it is asked for
+
+    /// Page-aligned pageable slots: a copy from them returns once it has read the slot, so it is free again.
+    pub fn init(gpa: std.mem.Allocator, ops: Ops) !Source {
+        var s: Source = .{ .gpa = gpa, .ops = ops };
+        var made: usize = 0;
+        errdefer for (s.slots[0..made]) |b| gpa.free(b);
+        while (made < slot_count) : (made += 1) s.slots[made] = try gpa.alignedAlloc(u8, .fromByteUnits(dio.alignment), slot_bytes);
+        s.ring = linux.IoUring.init(slot_count, 0) catch |err| blk: {
+            std.log.info("io_uring unavailable ({t}): checkpoint reads run one at a time", .{err});
+            break :blk null;
+        };
+        return s;
+    }
+
+    /// Waits for reads still in flight, then frees the ring and slots and closes the files.
+    pub fn deinit(s: *Source) void {
+        while (s.in_flight > 0) s.reap(1) catch break;
+        if (s.ring) |*r| r.deinit();
+        for (s.slots) |b| s.gpa.free(b);
+        for (s.files.items) |*m| m.file.close();
+        s.files.deinit(s.gpa);
+        s.* = undefined;
+    }
+
+    /// Every file of `ck`, opened for direct reads beside its mapping (copies from the mapping crawl on GB10).
+    pub fn add(s: *Source, ck: *const core.Checkpoint) !void {
+        for (ck.files.items) |*f| {
+            var file = try dio.File.open(f.path);
+            errdefer file.close();
+            try s.files.append(s.gpa, .{ .base = @intFromPtr(f.map.memory.ptr), .len = f.map.memory.len, .file = file });
+        }
+    }
+
+    /// The file and offset of mapped bytes; null for bytes that live elsewhere (host staging).
+    fn locate(s: *const Source, bytes: []const u8) ?struct { file: dio.File, offset: u64 } {
+        const p = @intFromPtr(bytes.ptr);
+        for (s.files.items) |m| if (p >= m.base and p + bytes.len <= m.base + m.len) return .{ .file = m.file, .offset = p - m.base };
+        return null;
+    }
+
+    /// Mapped bytes read for the GPU at `dst`: their reads are in flight on return; other bytes go now, after a flush.
+    pub fn upload(s: *Source, dst: u64, bytes: []const u8) !void {
+        const at = s.locate(bytes) orelse {
+            try s.flush();
+            return s.ops.upload(dst, bytes);
+        };
+        var done: usize = 0;
+        while (done < bytes.len) {
+            const n = @min(bytes.len - done, dio.fits(slot_bytes));
+            try s.start(try s.free(), .{ .dst = dst + done, .file = at.file, .offset = at.offset + done, .len = n, .at = 0 });
+            done += n;
+        }
+    }
+
+    /// Waits for every read in flight and queues its copy: stream work after this runs after them.
+    pub fn flush(s: *Source) !void {
+        while (s.in_flight > 0) try s.reap(1);
+    }
+
+    /// A slot with no read in flight, once finished reads have been reaped (waiting for one when all are busy).
+    fn free(s: *Source) !usize {
+        try s.reap(0);
+        while (true) {
+            for (s.pending, 0..) |p, k| if (p == null) return k;
+            try s.reap(1);
+        }
+    }
+
+    /// Puts slot `k`'s read in flight (or, without a ring, reads and copies it now).
+    fn start(s: *Source, k: usize, p: Pending) !void {
+        const lo = std.mem.alignBackward(u64, p.offset, dio.alignment);
+        var q = p;
+        q.at = @intCast(p.offset - lo);
+        const r = if (s.ring) |*ring| ring else return s.finish(q, try p.file.read(s.slots[k], p.offset, p.len));
+        _ = try r.read(k, p.file.fd, .{ .buffer = s.slots[k][0..dio.span(p.offset, p.len)] }, lo);
+        _ = try r.submit();
+        s.pending[k] = q;
+        s.in_flight += 1;
+    }
+
+    /// Finished reads, copied on; waits for at least `wait` of them.
+    fn reap(s: *Source, wait: u32) !void {
+        const r = if (s.ring) |*ring| ring else return;
+        var cqes: [slot_count]linux.io_uring_cqe = undefined;
+        const n = try r.copy_cqes(&cqes, wait);
+        for (cqes[0..n]) |c| {
+            const k: usize = @intCast(c.user_data);
+            const p = s.pending[k].?;
+            s.pending[k] = null;
+            s.in_flight -= 1;
+            // a short or failed read is finished by a plain read of the same span
+            const got = if (c.res >= @as(i32, @intCast(p.at + p.len))) s.slots[k][p.at..][0..p.len] else blk: {
+                if (c.res < 0) std.log.warn("io_uring read at {d} failed ({t}); reading again", .{ p.offset, c.err() });
+                break :blk try p.file.read(s.slots[k], p.offset, p.len);
+            };
+            try s.finish(p, got);
+        }
+    }
+
+    /// cuMemcpyHtoDAsync plus cuStreamSynchronize returns only after the pageable source has been staged.
+    fn finish(s: *Source, p: Pending, got: []u8) !void {
+        if (got.len == 0) return;
+        try s.ops.upload(p.dst, got);
+    }
+
+    /// Mapped bytes copied into host memory `out` (its length is theirs).
+    pub fn read(s: *Source, out: []u8, bytes: []const u8) !void {
+        const at = s.locate(bytes) orelse return @memcpy(out, bytes);
+        try s.flush();
+        var done: usize = 0;
+        while (done < bytes.len) {
+            const n = @min(bytes.len - done, dio.fits(slot_bytes));
+            @memcpy(out[done..][0..n], try at.file.read(s.slots[0], at.offset + done, n));
+            done += n;
+        }
+    }
+
+    /// Small mapped bytes as a view into a slot, valid until the next call; larger than a slot is refused.
+    pub fn view(s: *Source, bytes: []const u8) ![]const u8 {
+        const at = s.locate(bytes) orelse return bytes;
+        if (bytes.len > dio.fits(slot_bytes)) return error.TensorLargerThanSlot;
+        try s.flush();
+        return at.file.read(s.slots[0], at.offset, bytes.len);
+    }
+};
diff --git a/zig/src/families/glm/cuda/glm_symbols.zig b/zig/src/families/glm/cuda/glm_symbols.zig
new file mode 100644
index 0000000..bf2b7ae
--- /dev/null
+++ b/zig/src/families/glm/cuda/glm_symbols.zig
@@ -0,0 +1,146 @@
+//! Mangled names of the GLM-5.3-Flash kernels in the glm_kda and glm_exl3 fatbins (cuobjdump -symbols, nvcc 13.0,
+//! sm_121), and the host launch geometry the Python engine v0.6.6 uses for each. File:line references are into
+//! ~/tf-native/py066/src/tensorfold/. Every launch is on the current stream; "smem" is the dynamic shared memory
+//! argument; "static" is the kernel's own shared memory (cuobjdump -res-usage SHARED minus the 1 KiB the sm_121 ELF
+//! reserves per CTA). Pointer arguments are device addresses (u64); `int` is i32, `size_t` u64, `float` f32;
+//! bf16 is __nv_bfloat16, f16 is half. Sizes below are GLM-5.3-Flash at world 2: 64 KDA heads (32 a rank),
+//! D = hidden 4096, I = moe_intermediate 2048 / world = 1024 a rank (glm5_next/cuda/forward.py:96), E = 288 routed
+//! experts on every rank, slots = top_k + 1 = 9 (forward.py:95; the last slot is the shared expert, id E,
+//! glm5_next/cuda/glue.py:385), all experts 4-bit mcg (config quantization_config bits 4, codebook mcg).
+//!
+//! KDA (glm5_next/cuda/kda.cu, built -O3 --fmad=false, kda.py:18-19)
+//!
+//! A null pointer stands for an undefined or empty tensor (ptr<T>, kda.cu:357-358). DK = DV = 128, TAPS = 4
+//! (kda.cu:19). H = heads a rank = a_log.numel() = 32. GLM calls kda.chain from forward.py:273-282 and
+//! kda.replay_layers from forward.py:545; kda.chain takes the wide path when rows >= WIDE_ROWS = 64 (kda.py:58, 79).
+//!
+//! chain_kernel (kda.py:85-87 -> kda.cpp:21-46 -> kda.cu:360-375, launch kda.cu:368):
+//!   grid (H, 1, 1), block 1024, smem 0 (static 2568 B).
+//!   args (kda.cu:48-56): int H, bf16* P, int p_stride, int b_off, bf16* A, int a_stride, bf16* G, int g_stride,
+//!   bf16* cs, bf16* cw, float* state_in, float* a_log, float* dt_bias, bf16* norm_w, float eps, float lower,
+//!   int rows, bf16* out, float* state_out, float* k_save, bf16* v_save, float* g_save, float* b_save.
+//!   P = the KDA projection rows [rows, width] (forward.py:264), p_stride = P.stride(0) in elements, b_off = k.b_off;
+//!   A = b.ka[:R], G = b.kg[:R] bf16 with their row strides; cs = conv state [3, 3*H*128] bf16 (forward.py:167);
+//!   cw = conv weight [3*H*128, 4] bf16; state_in/state_out [H, 128, 128] f32 (st.rec[cur|1-cur, li]); a_log [H],
+//!   dt_bias [H*128] f32; norm_w [128] bf16; eps = c.eps, lower = gate_lower_bound (-5.0, weights.py:94), both
+//!   double in Python cast to float; out = scratch.out [rows, H*128] bf16; k_save/g_save [rows, H, 128] f32,
+//!   v_save [rows, H, 128] bf16, b_save [rows, H] f32 (KDAScratch, kda.py:22-34). state_out may be null.
+//!
+//! chain_wide = three launches in order (kda.py:80-83 -> kda.cpp:48-79 -> kda.cu:397-419), same args as chain
+//! plus q_tmp [rows, H, 128] f32 and y_tmp [rows, H, 128] bf16 (kda.py:62-70, shared by all layers):
+//!   prep_kernel (launch kda.cu:406): grid (rows, H, 1), block 512, smem 0 (static 1024 B).
+//!     args (kda.cu:221-226): int H, bf16* P, int p_stride, int b_off, bf16* A, int a_stride, bf16* cs, bf16* cw,
+//!     float* a_log, float* dt_bias, float lower, float* q_out (= q_tmp), float* k_save, bf16* v_save,
+//!     float* g_save, float* b_save.
+//!   step_kernel<4, 16> (launch kda.cu:411-414): grid (H, DV / 4 / WARPS = 8, 1), block 128, smem 0
+//!     (static 25664 B). args (kda.cu:272-276): int H, float* state_in, float* q_in (= q_tmp), float* k_save,
+//!     bf16* v_save, float* g_save, float* b_save, int rows, bf16* y_out (= y_tmp), float* state_out (may be null).
+//!   out_kernel (launch kda.cu:416-417): grid (rows, H, 1), block DV = 128, smem 0 (static 4 B).
+//!     args (kda.cu:334-336): int H, bf16* y_in (= y_tmp), bf16* G, int g_stride, bf16* norm_w, float eps, bf16* out.
+//!
+//! replay_kernel (kda.py:91-92 -> kda.cpp:81-88 -> kda.cu:377-384, launch kda.cu:381): grid (H, 1, 1) with
+//!   H = b_save.size(1), block 1024, smem 0 (static 512 B). args (kda.cu:153-156): int H, float* state_in,
+//!   float* k_save, bf16* v_save, float* g_save, float* b_save, int rows, float* state_out.
+//!
+//! replay_layers_kernel (kda.py:50-55 -> kda.cpp:90-98 -> kda.cu:386-395, launch kda.cu:391):
+//!   grid (layers * H, 1, 1), block 1024, smem 0 (static 512 B). Block b is layer b / H, head b % H.
+//!   args (kda.cu:183-186): int H, float* state_in, size_t state_stride, float* k_save, bf16* v_save, float* g_save,
+//!   float* b_save, size_t kv_stride, size_t b_stride, int rows, float* state_out.
+//!   kda.py:54 passes state_stride = H*128*128, kv_stride = scratch.rows*H*128, b_stride = scratch.rows*H (elements),
+//!   layers = scratch.layers (KDA layers), rows = the kept rows; state_in/out = st.rec[cur] / st.rec[1-cur]
+//!   [layers, H, 128, 128] f32; k/v/g/b = the KDAScratchSet's [layers, rows, ...] buffers (kda.py:37-47).
+//!   Note the Python host signature orders (.., layers, heads, rows, ..); the kernel takes only H and rows.
+//!
+//! EXL3 routed experts (cuda/exl3/experts.cu + experts_grouped.cuh, built -O3 -lineinfo, experts.py:28-30)
+//!
+//! GLM calls experts.routed(x, pick, wts=None, ex, s, out=None, R, limit=c.limit, act_mode=ACT_BF16 = 0)
+//! (glm5_next/cuda/exl3_generic.py:9, from forward.py:402); with wts None the launches are, in order
+//! (experts.py:184-197): group, rot_in, grouped (gate+up), gateup_epilogue, grouped (down), down_epilogue.
+//! P = R * slots (experts.py:181). Scratch (experts.py:149-170): xg, xu [rows*slots, D] f16, xd [rows*slots, I] f16,
+//! z f32 of max(2*SK_gu*I, SK_d*D) * rows*slots, y [rows*slots, D] f32; window(R): maxu = min(R*slots, E),
+//! ids = ids[:maxu], members = members_buf[:maxu*R] viewed [maxu, R], so maxm = members.size(1) = R.
+//! pick is int32 [rows, slots] contiguous; picks outside [0, E) (the shared slot, id E) are skipped by every kernel.
+//!
+//! group_kernel (experts.py:186 -> experts.cpp:58-69 -> experts.cu:290-310, launch experts.cu:306-308):
+//!   grid (1, 1, 1), block GROUP_THREADS = 1024, smem R*slots*4 B (static 128 B). Host checks E <= 4096 and
+//!   slots <= 32; when smem + 128 > 48 KiB it reads cudaFuncGetAttributes, fails if smem > sharedMemPerBlockOptin -
+//!   sharedSizeBytes, and sets MaxDynamicSharedMemorySize to that limit if smem > maxDynamicSharedSizeBytes
+//!   (experts.cu:292-305). args (experts.cu:19-21): int* pick, int* uids (= ids), int* ucount (= s.count, [1]),
+//!   int* members, int R, int slots, int E, int maxm (= members.size(1) = R).
+//!
+//! rot_in_kernel<bf16> (experts.py:187 -> experts.cpp:71-83 -> experts.cu:312-330, launch experts.cu:322-324):
+//!   grid (rows*slots, K/128, 2), block 32, smem 0. args (experts.cu:94-96): bf16* x, int x_stride, int* pick,
+//!   f16* suh0, f16* suh1, f16* out0, f16* out1, int K, int slots, int E.
+//!   x = b.normed[:R] bf16, x_stride = x.stride(0); suh0/suh1 = ex.suh_g/ex.suh_u [E, D]; out0/out1 = s.xg/s.xu;
+//!   K = D = 4096 (host checks K % 128 == 0), rows = R.
+//!
+//! grouped_kernel<CB 1, NT 8, W 4, PF 1, LO 8, HI 8> (experts.py:189-190 and 193-194 -> experts.cpp:26-45 ->
+//!   experts.cu:252-278 -> grouped_launch<1>, experts_grouped.cuh:324-342, launch :329):
+//!   grid (maxu = uids.size(0), N / (16*NT) = N/128, mats * SK * MT) with MT = (maxm + 15) / 16, block W*32 = 128,
+//!   smem 0 (static 32832 B: red[4][16][128] f32 and rows_sh[16]). blockIdx.z = (mat * SK + split) * MT + mtile.
+//!   args (experts_grouped.cuh:190-195, in GroupedArgs order experts.cu:258-271): f16* X0, f16* X1, int64* TP0,
+//!   int64* TP1, int* K2_0, int* K2_1, int* uids, int* ucount, int* members, float* Z, int K, int N, int P, int SK,
+//!   int maxm, int slots. Z is [mats][SK][P][N] f32 (experts_grouped.cuh:282).
+//!   Dispatch: cb = ex.cb = 1 (experts.cu:273-276); the setting nt 8, warps 4, pf 1 (experts_grouped.cuh:336) and
+//!   lo = hi = 8 (TF_RANGES, :333) select this instance; other bit ranges need <.., 2, 10> or <.., 2, 16>, which this
+//!   fatbin does not contain. Host check K % (16*SK*warps) == 0 and N % (16*nt) == 0 (experts.cu:257).
+//!   gate+up: X0 = s.xg, X1 = s.xu, TP0/TP1 = ex.gate_ptr/ex.up_ptr, K2_0/K2_1 = ex.gate_k2/ex.up_k2, mats 2,
+//!     K = D = 4096, N = I = 1024, SK = 4 (GLM_GATEUP, experts.py:19, 136-143) -> grid (maxu, 8, 8*MT).
+//!   down: X0 = X1 = s.xd, TP0 = TP1 = ex.down_ptr, K2_0 = K2_1 = ex.down_k2, mats 1, K = I = 1024, N = D = 4096,
+//!     SK = 1 (GLM_DOWN, experts.py:20) -> grid (maxu, 32, MT).
+//!
+//! gateup_epilogue_kernel (experts.py:191 -> experts.cpp:85-97 -> experts.cu:332-342, launch experts.cu:337):
+//!   grid (rows*slots, N/128), block 32, smem 0. args (experts.cu:116-119): float* Z, int* pick, f16* svh_g,
+//!   f16* svh_u, f16* suh_d, f16* xd, int P, int N, int SK, int E, float limit, int act_mode.
+//!   svh_g/svh_u = ex.svh_g/ex.svh_u [E, I], suh_d = ex.suh_d [E, I], xd = s.xd; N = I = 1024 (host checks
+//!   N % 128 == 0), SK = 4, limit = c.limit (swiglu_limit, 10.0, weights.py:103) as float, act_mode = 0 (GLM's
+//!   bf16 roundings, not ACT_F32).
+//!
+//! down_epilogue_kernel (experts.py:196 -> experts.cpp:99-108 -> experts.cu:344-351, launch experts.cu:347):
+//!   grid (rows*slots, D/128), block 32, smem 0. args (experts.cu:161-163): float* Z, int* pick, f16* svh_d,
+//!   float* y, int P, int D, int SK, int E. svh_d = ex.svh_d [E, D], y = s.y; D = 4096, SK = 1.
+//!
+//! down_combine_kernel (experts.py:201 -> experts.cpp:118-130 -> experts.cu:361-371, launch experts.cu:366): only
+//!   when wts is given, which GLM never does. grid (rows, D/128), block 32*slots (host checks slots <= 32), smem 0
+//!   (static 16384 B). args (experts.cu:194-197): float* Z, int* pick, f16* svh_d, float* y, float* wts,
+//!   float* out, int P, int D, int SK, int E, int slots.
+//!
+//! combine_kernel (experts.cpp:110-116 -> experts.cu:353-359, launch experts.cu:356): not called by routed().
+//!   grid (rows, (D + 255)/256), block 256, smem 0. args (experts.cu:183-184): float* y, float* wts, float* out,
+//!   int D, int slots.
+
+// glm_kda.fatbin
+/// kda.chain, rows < 64: one block a head runs every row (kda.cu:368).
+pub const kda_chain = "_ZN10tf_glm_kda12chain_kernelEiPK13__nv_bfloat16iiS2_iS2_iS2_S2_PKfS4_S4_S2_ffiPS0_PfS6_S5_S6_S6_";
+/// kda.chain, rows >= 64, launch 1 of 3: conv, decay, beta and the q/k norms of every row (kda.cu:406).
+pub const kda_prep = "_ZN10tf_glm_kda11prep_kernelEiPK13__nv_bfloat16iiS2_iS2_S2_PKfS4_fPfS5_PS0_S5_S5_";
+/// kda.chain, rows >= 64, launch 2 of 3: the delta rule row by row, step_kernel<4, 16> (kda.cu:412).
+pub const kda_step = "_ZN10tf_glm_kda11step_kernelILi4ELi16EEEviPKfS2_S2_PK13__nv_bfloat16S2_S2_iPS3_Pf";
+/// kda.chain, rows >= 64, launch 3 of 3: the gated RMSNorm of the read-out (kda.cu:416).
+pub const kda_out = "_ZN10tf_glm_kda10out_kernelEiPK13__nv_bfloat16S2_iS2_fPS0_";
+/// kda.replay: one layer's state after the kept rows (kda.cu:381); not called by GLM's forward.
+pub const kda_replay = "_ZN10tf_glm_kda13replay_kernelEiPKfS1_PK13__nv_bfloat16S1_S1_iPf";
+/// kda.replay_layers: every KDA layer's state after the kept rows, from commit (kda.cu:391, forward.py:545).
+pub const kda_replay_layers = "_ZN10tf_glm_kda20replay_layers_kernelEiPKfmS1_PK13__nv_bfloat16S1_S1_mmiPf";
+/// kda.chain_segments (v1.8 kda.cu:613-627), launch 1 of 3: prep_kernel with each row's conv taps from its segment's slot.
+pub const kda_prep_seg = "_ZN10tf_glm_kda15prep_seg_kernelEiPKiiPK13__nv_bfloat16iiS4_iS4_mS4_PKfS6_fPfS7_PS2_S7_S7_";
+/// kda.chain_segments, launch 2 of 3: step_seg_kernel<4, 16>, block (segment x head, part).
+pub const kda_step_seg = "_ZN10tf_glm_kda15step_seg_kernelILi4ELi16EEEviPKiPfmmPKfS5_PK13__nv_bfloat16S5_S5_PS6_";
+/// kda.replay_layers_segments (v1.8 kda.cu:629-634): block (segment, layer, head).
+pub const kda_replay_layers_seg = "_ZN10tf_glm_kda24replay_layers_seg_kernelEiiPKiPfmmmPKfPK13__nv_bfloat16S4_S4_mm";
+
+// glm_exl3.fatbin
+/// ext.group: distinct experts and their members (experts.cu:306).
+pub const exl3_group = "_ZN11tf_glm_exl312group_kernelEPKiPiS2_S2_iiii";
+/// ext.rot_in on bf16 rows: x * suh, Hadamard, fp16 for gate and up (experts.cu:322).
+pub const exl3_rot_in = "_ZN11tf_glm_exl313rot_in_kernelI13__nv_bfloat16EEvPKT_iPKiPK6__halfS9_PS7_SA_iii";
+/// ext.grouped, gate+up (mats 2, SK 4) and down (mats 1, SK 1): mcg, 4-bit, NT 8, 4 warps, PF 1 (experts_grouped.cuh:329).
+pub const exl3_grouped = "_ZN8tf_exl3x14grouped_kernelILi1ELi8ELi4ELi1ELi8ELi8EEEvPK6__halfS3_PKlS5_PKiS7_S7_S7_S7_Pfiiiiii";
+/// ext.gateup_epilogue: splits summed, SwiGLU (act_mode 0 for GLM), rotated into xd (experts.cu:337).
+pub const exl3_gateup_epilogue = "_ZN11tf_glm_exl322gateup_epilogue_kernelEPKfPKiPK6__halfS6_S6_PS4_iiiifi";
+/// ext.down_epilogue: GLM's last expert launch, Y per slot in fp32 (experts.cu:347).
+pub const exl3_down_epilogue = "_ZN11tf_glm_exl320down_epilogue_kernelEPKfPKiPK6__halfPfiiii";
