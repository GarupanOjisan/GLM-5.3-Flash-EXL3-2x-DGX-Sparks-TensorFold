+        try t.run("_combine", .{ rows, d / block, 1 }, &.{ p("Y", "*fp32", y), p("WTS", "*fp32", wts), p("OUT", "*fp32", out) }, &.{ ci("D", d), ci("SLOTS", slots), ci("BLOCK", block) });
